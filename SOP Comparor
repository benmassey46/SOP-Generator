# --- Helper Functions ---
def read_file(filepath):
    """Reads a file safely, returning content or error message."""
    if not filepath or not os.path.exists(filepath): return None, f"File not found: {filepath}"
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f: # Ignore decoding errors
            return f.read(), None
    except Exception as e: return None, f"Error reading file {os.path.basename(filepath)}: {e}"

def preprocess_text_simple(text):
    """Basic tokenization for Jaccard."""
    if not text: return []
    try:
        # Use NLTK if available and ready
        return word_tokenize(text.lower())
    except Exception: # Fallback if NLTK fails for some reason
        return text.lower().split()

def preprocess_text_wmd(text):
    """Preprocessing specific to WMD calculation."""
    if not text: return []
    text = text.lower()
    text = re.sub(r'[^\w\s]', '', text) # Remove punctuation
    try:
        # Use NLTK if available and ready
        tokens = word_tokenize(text)
        stop_words = STOPWORDS # Use loaded stopwords
        return [word for word in tokens if word.isalpha() and word not in stop_words]
    except Exception: # Fallback if NLTK fails
         tokens = text.split()
         # Basic fallback stopwords if NLTK failed completely
         basic_stopwords = {'the', 'a', 'an', 'is', 'are', 'to', 'in', 'it', 'of', 'for', 'on', 'with', 'and', 'that', 'this'}
         return [word for word in tokens if word.isalpha() and word not in basic_stopwords]

# --- Similarity Metrics (Optimized Calls) ---
def calculate_jaccard(tokens1, tokens2):
    """Calculates Jaccard similarity from pre-tokenized lists."""
    if not tokens1 and not tokens2: return 1.0, None # Both empty, considered identical
    if not tokens1 or not tokens2: return 0.0, None # One empty, zero similarity
    set1 = set(tokens1); set2 = set(tokens2)
    intersection = len(set1.intersection(set2))
    union = len(set1.union(set2))
    return (float(intersection) / union if union > 0 else 0.0), None

def calculate_cosine_st_from_embeddings(embedding1, embedding2):
    """Calculates cosine similarity from pre-computed Sentence Transformer embeddings."""
    if not ST_AVAILABLE: return None, "Sentence Transformers library not available."
    if embedding1 is None or embedding2 is None:
        return None, "Missing pre-computed ST embedding."
    try:
        # Ensure embeddings are PyTorch tensors on the CPU for consistent calculation
        if not isinstance(embedding1, torch.Tensor): embedding1 = torch.tensor(np.array(embedding1))
        if not isinstance(embedding2, torch.Tensor): embedding2 = torch.tensor(np.array(embedding2))

        # Move to CPU just in case they somehow ended up elsewhere, though cache should be CPU
        embedding1 = embedding1.cpu()
        embedding2 = embedding2.cpu()

        # Reshape if they are flat arrays (util.cos_sim expects 2D)
        if len(embedding1.shape) == 1: embedding1 = embedding1.unsqueeze(0)
        if len(embedding2.shape) == 1: embedding2 = embedding2.unsqueeze(0)

        # util.cos_sim is efficient for this
        cosine_score = util.cos_sim(embedding1, embedding2).item()
        # Clamp result to [0, 1] as similarity should be non-negative, and sometimes scores slightly exceed 1.0
        return np.clip(cosine_score, 0.0, 1.0), None
    except Exception as e:
        return None, f"ST Cosine (from embed) Error: {e}"

def calculate_cosine_openai_from_embeddings(embedding1, embedding2):
    """Calculates cosine similarity from pre-computed OpenAI embeddings."""
    if not OPENAI_AVAILABLE: return None, "OpenAI library not available."
    if embedding1 is None or embedding2 is None:
        return None, "Missing pre-computed OpenAI embedding."
    try:
        # Ensure embeddings are numpy arrays of the correct shape
        vec1 = np.array(embedding1, dtype=np.float32).reshape(1, -1)
        vec2 = np.array(embedding2, dtype=np.float32).reshape(1, -1)
        # Use sklearn's cosine_similarity for robust calculation
        similarity = sklearn_cosine_similarity(vec1, vec2)[0][0]
        # Clamp result to [0, 1]
        return np.clip(similarity, 0.0, 1.0), None
    except Exception as e:
        return None, f"OpenAI Cosine (from embed) Error: {e}"

def calculate_wmd(tokens1, tokens2, wmd_model):
    """Calculates Word Mover's Distance using a pre-loaded Gensim model (CPU)."""
    if not GENSIM_AVAILABLE or not POT_AVAILABLE: return float('inf'), WMD_MESSAGE # Return Inf if libs missing
    if wmd_model is None: return float('inf'), "WMD model not loaded or provided."
    if not tokens1 or not tokens2: return float('inf'), "One or both documents have no WMD tokens."

    try:
        # Determine the vocabulary source (depends on Gensim model type)
        if hasattr(wmd_model, 'wv') and hasattr(wmd_model.wv, 'key_to_index'):
            model_vocab = wmd_model.wv.key_to_index # Full Word2Vec/FastText model
        elif hasattr(wmd_model, 'key_to_index'):
            model_vocab = wmd_model.key_to_index # KeyedVectors model
        else:
            return float('inf'), "Invalid WMD model object (missing vocabulary)."

        # Filter tokens to only those present in the model's vocabulary
        tokens1_f = [w for w in tokens1 if w in model_vocab]
        tokens2_f = [w for w in tokens2 if w in model_vocab]

        if not tokens1_f or not tokens2_f:
            # If, after filtering, one list is empty, WMD is infinite/undefined.
            return float('inf'), "No overlapping vocabulary words found for WMD."

        # Calculate WMD. This can be computationally intensive.
        distance = wmd_model.wmdistance(tokens1_f, tokens2_f)

        # Handle potential infinite distance result from the library itself
        return float('inf') if distance == float('inf') else distance, None
    except ImportError as e:
         # Catch missing POT library error specifically if check failed earlier
         return float('inf'), f"WMD Calc Error: Missing dependency: {e}"
    except Exception as e:
        # Catch other potential errors, including memory errors
        error_msg = f"WMD Calc Error: {e}"
        if "memory" in str(e).lower(): error_msg += " (Likely Memory Error)"
        traceback.print_exc() # Print detailed traceback for debugging
        return float('inf'), error_msg

def calculate_bertscore(text1, text2, device, model_type='bert-base-uncased'):
    """Calculates BERTScore F1 using specified device and model."""
    if not BERTSCORE_AVAILABLE: return None, BS_MESSAGE
    if not text1 or not text1.strip() or not text2 or not text2.strip():
        # Handle empty strings gracefully
        return 0.0, "Empty input for BERTScore."
    try:
        # Ensure texts are lists (bert_score expects iterables)
        refs = [text1]
        cands = [text2]

        # Call bert_score, passing the target device
        # Use `rescale_with_baseline=True` for better calibrated scores (0-1 range)
        P, R, F1 = bert_score_calc(cands, refs, lang="en", verbose=False,
                                   model_type=model_type, device=device,
                                   rescale_with_baseline=True)
        f1_score = F1.mean().item() # Get the scalar F1 score
        # Clamp result to [0, 1]
        return np.clip(f1_score, 0.0, 1.0), None
    except Exception as e:
        # Catch specific errors for better reporting
        error_msg = f"BERTScore Error: {e}"
        err_str = str(e).lower()
        if "cuda out of memory" in err_str:
            error_msg += " (CUDA OOM)"
        elif "meta tensor" in err_str:
            # This is the error reported by the user
            error_msg += " (Meta Tensor Issue - Check PyTorch/Transformers/BERTScore versions or force CPU)"
        elif "safetensors_rust" in err_str:
             error_msg += " (SafeTensors Load Error - Check library install)"
        # Print traceback for detailed debugging in console
        traceback.print_exc()
        return None, error_msg

def calculate_hybrid(jaccard_score, bert_f1_score):
    """Simple hybrid score: average of Jaccard and BERTScore F1."""
    if jaccard_score is None or bert_f1_score is None:
        return None, "Requires valid Jaccard & BERTScore F1 results."
    try:
        # Ensure scores are floats before averaging
        j_score = float(jaccard_score)
        b_score = float(bert_f1_score)
        return (j_score + b_score) / 2.0, None
    except (ValueError, TypeError) as e:
        return None, f"Invalid score type for hybrid calculation: {e}"

# --- Readability/Style Metrics ---
def calculate_readability(text):
    """Calculates Gunning Fog index using textstat."""
    if not TEXTSTAT_AVAILABLE: return {'gunning_fog': 'N/A'}, "textstat library missing"
    if not text or text.isspace(): return {'gunning_fog': 'EmptyFile'}, "Empty text provided"
    try:
        # Ensure text is reasonably long enough for meaningful calculation
        if len(text.split()) < 50: # Heuristic threshold
             # return {'gunning_fog': 'TooShort'}, "Text too short for reliable Fog index"
             pass # Allow calculation but be aware it might be less reliable

        fog = textstat.gunning_fog(text)
        # Handle potential NaN or Inf results from textstat edge cases
        if np.isnan(fog) or np.isinf(fog):
             return {'gunning_fog': 'CalcError'}, "Textstat returned invalid number (NaN/Inf)"
        return {'gunning_fog': fog}, None
    except Exception as e:
        # Catch any calculation errors within textstat
        return {'gunning_fog': 'Error'}, f"Readability Calc Error: {e}"

def is_passive(sentence_tokens, tagged_sentence):
    """Helper to check if a tagged sentence is passive."""
    # Common 'be' forms and past participle tag
    be_forms = {'am', 'is', 'are', 'was', 'were', 'be', 'being', 'been'}
    past_participle_tag = 'VBN'
    # Tags that can indicate a form of 'be'
    be_tags = {'VB', 'VBP', 'VBZ', 'VBG', 'VBD', 'VBN'}

    for i, (word, tag) in enumerate(tagged_sentence):
        word_lower = word.lower()
        # Check if the word is a form of 'be' and has an appropriate tag
        if word_lower in be_forms and tag in be_tags:
            # Look ahead for a past participle (VBN)
            if i + 1 < len(tagged_sentence):
                next_word, next_tag = tagged_sentence[i+1]
                if next_tag == past_participle_tag:
                    # Avoid common exceptions like "is located", "is based" - heuristic
                    if next_word.lower() not in ['located', 'situated', 'based', 'born']:
                         return True
            # Check if 'been' is followed by VBN (e.g., "has been done")
            if word_lower == 'been' and tag == 'VBN':
                 if i > 0: # Ensure 'been' is not the first word
                     prev_word, prev_tag = tagged_sentence[i-1]
                     # Check for auxiliary verb before 'been' (e.g., 'has', 'have', 'had')
                     if prev_tag in ['VBZ', 'VBP', 'VBD']:
                          return True # Likely passive form like "has been VBN"
    return False

def calculate_passive_voice_ratio(text):
    """Calculates the ratio of passive voice sentences using NLTK POS tagging."""
    if not NLTK_READY or not nltk.data.find('taggers/averaged_perceptron_tagger'):
        return 'N/A', "NLTK tagger missing or NLTK not ready"
    if not text or text.isspace(): return 0.0, "Empty text provided" # Return 0.0 for empty text

    try:
        # Sentence tokenize first
        try: sentences = sent_tokenize(text)
        except Exception as sent_err: return 'Error', f"Sentence tokenization error: {sent_err}"

        if not sentences: return 0.0, None # No sentences, ratio is 0

        passive_count = 0
        analyzed_sentence_count = 0 # Count sentences complex enough to analyze

        for sentence in sentences:
            # Skip very short sentences unlikely to be passive or analyzable
            if len(sentence.split()) < 3: continue

            try:
                # Word tokenize and POS tag the sentence
                tokens = word_tokenize(sentence)
                tagged = nltk.pos_tag(tokens)
                # Check if the tagged sentence is passive
                if is_passive(tokens, tagged):
                    passive_count += 1
                analyzed_sentence_count += 1
            except Exception as tag_err:
                # Log or ignore tagging errors for single sentences
                # print(f"Warning: Could not tag sentence: {sentence[:50]}... Error: {tag_err}")
                pass # Continue with the next sentence

        # Calculate ratio based on sentences that were successfully analyzed
        if analyzed_sentence_count == 0:
             # This happens if all sentences were too short or tagging failed for all
             return 0.0 if len(sentences) == 0 else 'TaggingError', "No sentences could be analyzed for passivity"

        ratio = passive_count / analyzed_sentence_count
        return ratio, None
    except Exception as e:
        # Catch broader errors during the process
        return 'Error', f"Passive Ratio Calc Error: {e}"


# --- Function to Process a Single Pair (Excluding WMD) ---
def process_single_pair(args):
    """
    Calculates all pairwise metrics EXCEPT WMD for a single pair of files.
    Designed to be run in parallel. Uses pre-cached/calculated data.
    WMD will be calculated sequentially later.
    """
    # Unpack arguments including the bert_device and bert_model_type
    fpath1, fpath2, file_data_cache, st_embeddings, openai_embeddings, bert_device, bert_model_type = args
    fname1 = os.path.basename(fpath1)
    fname2 = os.path.basename(fpath2)

    # Retrieve cached data for the pair
    data1 = file_data_cache.get(fpath1)
    data2 = file_data_cache.get(fpath2)
    # Retrieve cached embeddings (expected to be CPU tensors/numpy arrays)
    st_emb1 = st_embeddings.get(fpath1)
    st_emb2 = st_embeddings.get(fpath2)
    oai_emb1 = openai_embeddings.get(fpath1)
    oai_emb2 = openai_embeddings.get(fpath2)

    # Initialize result dict with placeholders
    pair_result = {
        'File1': fname1, 'File2': fname2,
        'File1_GunningFog': data1['metrics'].get('gunning_fog', 'CacheMiss') if data1 else 'DataMissing',
        'File1_PassivePerc': data1['metrics'].get('passive_ratio', 'CacheMiss') if data1 else 'DataMissing',
        'File2_GunningFog': data2['metrics'].get('gunning_fog', 'CacheMiss') if data2 else 'DataMissing',
        'File2_PassivePerc': data2['metrics'].get('passive_ratio', 'CacheMiss') if data2 else 'DataMissing',
        'Jaccard': None, 'Cosine_ST': None, 'Cosine_OpenAI': None,
        'WMD': 'Pending', # Will be filled later sequentially
        'BERTScore_F1': None, 'Hybrid_Jacc_BERT': None,
        'Error': None # Store cumulative errors for this pair
    }

    error_log = [] # Collect errors for this pair

    try:
        # Check if essential data is present
        if not data1 or data1.get('content') is None:
            error_log.append(f"DataMissing: Missing cached data/content for {fname1}")
        if not data2 or data2.get('content') is None:
             error_log.append(f"DataMissing: Missing cached data/content for {fname2}")

        # Proceed only if both files have content
        if data1 and data2 and data1.get('content') is not None and data2.get('content') is not None:
            # --- Calculations using cached/pre-computed data (excluding WMD) ---

            # Jaccard Similarity
            jaccard_score, jac_err = calculate_jaccard(data1.get('tokens_simple', []), data2.get('tokens_simple', []))
            pair_result['Jaccard'] = jaccard_score
            if jac_err: error_log.append(f"Jaccard_Err: {jac_err}")

            # Sentence Transformer Cosine Similarity
            cosine_st_score, cs_err = calculate_cosine_st_from_embeddings(st_emb1, st_emb2)
            pair_result['Cosine_ST'] = cosine_st_score
            if cs_err: error_log.append(f"ST_Err: {cs_err}")

            # OpenAI Cosine Similarity
            cosine_openai_score, co_err = calculate_cosine_openai_from_embeddings(oai_emb1, oai_emb2)
            pair_result['Cosine_OpenAI'] = cosine_openai_score
            if co_err: error_log.append(f"OpenAI_Err: {co_err}")

            # BERTScore F1 (using specified device and model)
            bert_score, bs_err = calculate_bertscore(data1['content'], data2['content'], bert_device, bert_model_type)
            pair_result['BERTScore_F1'] = bert_score
            if bs_err: error_log.append(f"BERT_Err: {bs_err}") # Includes specific error details like (Meta Tensor Issue)

            # Hybrid Score (Jaccard + BERTScore)
            hybrid_score, hyb_err = calculate_hybrid(jaccard_score, bert_score)
            pair_result['Hybrid_Jacc_BERT'] = hybrid_score
            if hyb_err: error_log.append(f"Hybrid_Err: {hyb_err}")

        else:
            # If content was missing, mark scores as N/A or keep as None
             pair_result['Jaccard'] = None
             pair_result['Cosine_ST'] = None
             pair_result['Cosine_OpenAI'] = None
             pair_result['BERTScore_F1'] = None
             pair_result['Hybrid_Jacc_BERT'] = None
             pair_result['WMD'] = None # Cannot calculate WMD either

    except Exception as e:
        # Log unexpected errors during this pair's processing
        error_log.append(f"UnexpectedPairError: {e}")
        traceback.print_exc() # Print detailed traceback for debugging unexpected errors

    # Consolidate errors into the 'Error' field
    if error_log:
        pair_result['Error'] = "; ".join(error_log)

    return pair_result


