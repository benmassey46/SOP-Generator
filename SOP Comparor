    def update_status(self, message):
        """Updates the status bar label (thread-safe via queue)."""
        if self.master.winfo_exists():
            self.status_text.set(f"Status: {message}")

    def add_log_message(self, message):
        """Adds a message to the log listbox (thread-safe via queue)."""
        if self.master.winfo_exists() and self.log_listbox:
            self.log_listbox.insert(tk.END, f"{time.strftime('%H:%M:%S')} - {message}")
            self.log_listbox.see(tk.END) # Scroll to the bottom
            self.log_listbox.update_idletasks() # Ensure UI updates immediately

    def process_status_queue(self):
        """Processes messages from the status queue to update the GUI."""
        try:
            while True: # Process all messages currently in the queue
                msg_type, message = self.status_queue.get_nowait()
                if msg_type == "status":
                    self.update_status(message)
                elif msg_type == "log":
                    self.add_log_message(message)
                elif msg_type == "clear_log":
                    if self.master.winfo_exists() and self.log_listbox:
                        self.log_listbox.delete(0, tk.END)
                elif msg_type == "error_messagebox":
                     # Unpack title and message
                     title, msg = message
                     messagebox.showerror(title, msg)
                elif msg_type == "info_messagebox":
                     # Unpack title and message
                     title, msg = message
                     messagebox.showinfo(title, msg)
                elif msg_type == "enable_run_button":
                     if self.master.winfo_exists(): self.run_button.config(state=tk.NORMAL)
        except queue.Empty:
            pass # No more messages
        finally:
            # Reschedule after processing
            if self.master.winfo_exists():
                self.master.after(100, self.process_status_queue)

    def start_batch_comparison(self):
        """Validates inputs and starts the comparison logic in a separate thread."""
        # --- Input Validation ---
        folder = self.folder_path.get()
        output_csv = self.output_csv_path.get()
        st_model_name_val = self.st_model_name.get()
        openai_model_val = self.openai_embed_model.get()
        openai_key_val = self.openai_key.get()
        wmd_path_val = self.wmd_model_path.get()

        try: max_files = self.max_files_var.get()
        except tk.TclError: messagebox.showerror("Input Error", "Invalid value for Max Files. Please enter a number."); return
        if not folder or not os.path.isdir(folder): messagebox.showerror("Input Error", "Please select a valid input folder."); return
        if not output_csv: messagebox.showerror("Output Error", "Please specify an output CSV file path."); return
        if not st_model_name_val and ST_AVAILABLE: messagebox.showwarning("Input Warning", "Sentence Transformer model name is empty. ST Cosine Similarity will be skipped.");
        if not openai_model_val and OPENAI_AVAILABLE and openai_key_val: messagebox.showwarning("Input Warning", "OpenAI Embedding model name is empty. OpenAI Cosine Similarity will be skipped.");
        if openai_key_val and not OPENAI_AVAILABLE: messagebox.showerror("Dependency Error", "OpenAI API Key provided, but the 'openai' library is missing or outdated (needs v1+). Install with 'pip install --upgrade openai'."); return
        if wmd_path_val and (not GENSIM_AVAILABLE or not POT_AVAILABLE): messagebox.showerror("Dependency Error", f"WMD model path provided, but required libraries are missing: {WMD_MESSAGE}. Install 'gensim' and 'POT'."); return
        if wmd_path_val and not os.path.isfile(wmd_path_val): messagebox.showerror("Input Error", f"Specified WMD model file not found: {wmd_path_val}"); return
        if max_files < 2: messagebox.showerror("Input Error", "Max files must be at least 2 for pairwise comparison."); return

        # Check output directory writability
        output_dir = os.path.dirname(output_csv)
        if not os.path.isdir(output_dir):
            try:
                os.makedirs(output_dir, exist_ok=True)
                self.status_queue.put(("log", f"Created output directory: {output_dir}"))
            except Exception as e:
                messagebox.showerror("Output Error", f"Cannot create output directory:\n{output_dir}\nError: {e}"); return
        elif not os.access(output_dir, os.W_OK):
             messagebox.showerror("Output Error", f"Output directory is not writable:\n{output_dir}"); return

        # --- Prepare GUI and Start Thread ---
        self.run_button.config(state=tk.DISABLED) # Disable button during run
        self.status_queue.put(("clear_log", None)) # Clear previous logs
        self.status_queue.put(("log", f"--- Starting Optimized Batch Comparison ---"))
        self.status_queue.put(("log", f"Input Folder: {folder}"))
        self.status_queue.put(("log", f"Max Files: {max_files}"))
        self.status_queue.put(("log", f"Output CSV: {output_csv}"))
        self.status_queue.put(("log", f"ST Model: {st_model_name_val if st_model_name_val else 'N/A'}"))
        self.status_queue.put(("log", f"OpenAI Model: {openai_model_val if openai_key_val and openai_model_val else 'N/A'}"))
        self.status_queue.put(("log", f"WMD Model: {os.path.basename(wmd_path_val) if wmd_path_val else 'N/A'}"))
        self.status_queue.put(("status", "Starting..."))
        self.batch_results = [] # Clear previous results

        # Pass necessary config values to the background thread
        threading.Thread(target=self.run_batch_comparison_logic,
                         args=(folder, output_csv, max_files,
                               st_model_name_val, openai_key_val, openai_model_val, wmd_path_val),
                         daemon=True).start()

    # ================================================================
    # <<< CORE OPTIMIZED BATCH LOGIC with GPU Support >>>
    # ================================================================
    def run_batch_comparison_logic(self, folder_path, output_csv_path, max_files,
                                   st_model_name, openai_key_val, openai_embed_model_name, wmd_path_val):
        # --- Initialize ---
        wmd_model_instance = None
        st_model_instance = None
        openai_client = None
        file_data_cache = {} # Store: {fpath: {'content':..., 'tokens_simple':..., 'tokens_wmd':..., 'metrics':{...}}}
        st_embeddings = {}   # Store: {fpath: embedding_vector (CPU tensor)}
        openai_embeddings = {}# Store: {fpath: embedding_vector (list or numpy array)}
        all_results_data = []
        start_time_total = time.time()
        compute_device = 'cpu' # Default device

        # --- Determine Device for Torch Models ---
        if TORCH_AVAILABLE:
            if torch.cuda.is_available():
                try:
                    # Basic CUDA check
                    _ = torch.tensor([1.0]).cuda()
                    compute_device = 'cuda'
                    self.status_queue.put(("log", f"CUDA GPU detected ({torch.cuda.get_device_name(0)}). Will use GPU for ST/BERTScore."))
                except Exception as cuda_err:
                    self.status_queue.put(("log", f"CUDA detected but initialization failed: {cuda_err}. Falling back to CPU."))
                    compute_device = 'cpu'
            else:
                self.status_queue.put(("log", "CUDA GPU not detected or Torch configured incorrectly. Using CPU."))
        else:
            self.status_queue.put(("log", "Torch library missing. Models requiring Torch will use CPU if possible or fail."))

        # Device for BERTScore (passed to function) - can be overridden if needed
        bert_device = compute_device
        # Device for Sentence Transformers loading and initial encoding
        st_device = compute_device
        # Default BERT model (could be made configurable)
        bert_model_type = 'bert-base-uncased' # Default, common choice for BERTScore

        max_workers_to_use = max(1, MAX_WORKERS) # Ensure at least 1 worker for thread pool

        try:
            # --- 1. Scan Files ---
            self.status_queue.put(("status", "Scanning folder..."))
            self.status_queue.put(("log", f"Scanning folder for .txt files: {folder_path}"))
            try:
                # List files, sort for consistent order, filter for .txt
                all_files_found = sorted([
                    f for f in os.listdir(folder_path)
                    if f.lower().endswith('.txt') and os.path.isfile(os.path.join(folder_path, f))
                ])
            except Exception as e:
                raise ValueError(f"Error scanning folder {folder_path}: {e}")

            if len(all_files_found) < 2:
                raise ValueError(f"Found {len(all_files_found)} .txt files. Need at least 2 for comparison.")

            # Select up to max_files
            selected_files = all_files_found[:max_files]
            file_paths = [os.path.join(folder_path, f) for f in selected_files]
            num_files = len(file_paths)

            self.status_queue.put(("log", f"Found {len(all_files_found)} total .txt files; selected {num_files} for processing: {', '.join(selected_files)}"))
            if num_files < 2: # Should be caught above, but double-check
                 raise ValueError(f"Selected only {num_files} file(s). Need at least 2 for comparison.")

            # --- 2. Initial File Processing (Caching & Per-File Metrics) ---
            self.status_queue.put(("status", f"Processing {num_files} files (metrics & cache)..."))
            self.status_queue.put(("log", f"--- Stage 1/6: Pre-processing {num_files} files (Read, Metrics, Tokenize, Cache) ---"))
            initial_proc_start = time.time()
            texts_for_embedding = {} # {fpath: text_content} - only store if embedding needed

            for i, fpath in enumerate(file_paths):
                fname = os.path.basename(fpath)
                self.status_queue.put(("status", f"Processing file {i+1}/{num_files}: {fname}"))
                self.status_queue.put(("log", f"  Processing {fname}..."))

                content, read_err = read_file(fpath)
                fog_val, passive_val = 'N/A', 'N/A'
                tokens_simple_val, tokens_wmd_val = [], []
                file_metrics = {} # Store individual file metrics here

                if read_err:
                    self.status_queue.put(("log", f"    ERROR reading {fname}: {read_err}"))
                    file_metrics['gunning_fog'] = 'ReadError'
                    file_metrics['passive_ratio'] = 'ReadError'
                    content = None # Mark content as None on read error
                elif not content or content.isspace():
                    self.status_queue.put(("log", f"    File {fname} is empty."))
                    file_metrics['gunning_fog'] = 'EmptyFile'
                    file_metrics['passive_ratio'] = 0.0 # Passive ratio is 0 for empty file
                    content = "" # Use empty string for consistency downstream
                else:
                    # Calculate Readability Metrics
                    readability_res, read_err_msg = calculate_readability(content)
                    fog_val = readability_res.get('gunning_fog', 'Error')
                    if read_err_msg: self.status_queue.put(("log", f"    Readability warning for {fname}: {read_err_msg}"))
                    file_metrics['gunning_fog'] = fog_val

                    # Calculate Passive Voice Ratio
                    passive_ratio, passive_err_msg = calculate_passive_voice_ratio(content)
                    passive_val = passive_ratio
                    if passive_err_msg: self.status_queue.put(("log", f"    Passive voice warning for {fname}: {passive_err_msg}"))
                    file_metrics['passive_ratio'] = passive_val

                    # Preprocess Tokens (Simple for Jaccard)
                    tokens_simple_val = preprocess_text_simple(content)

                    # Preprocess Tokens for WMD (only if WMD path is valid)
                    if wmd_path_val:
                        tokens_wmd_val = preprocess_text_wmd(content)

                    # Store non-empty text for batch embedding
                    if content.strip():
                       texts_for_embedding[fpath] = content

                # Store results in cache
                file_data_cache[fpath] = {
                    'content': content, # Store raw content (or "" if empty, None if read error)
                    'tokens_simple': tokens_simple_val,
                    'tokens_wmd': tokens_wmd_val,
                    'metrics': file_metrics
                }

                # Log formatted results concisely
                fog_str = file_metrics.get('gunning_fog', 'N/A')
                pass_str = file_metrics.get('passive_ratio', 'N/A')
                if isinstance(pass_str, (float, int, np.number)): pass_str = f"{pass_str:.2%}"
                if isinstance(fog_str, (float, int, np.number)): fog_str = f"{fog_str:.2f}"
                log_msg_metrics = f"Fog={fog_str}, Passive={pass_str}"
                log_msg_tokens = f"SimpleTokens={len(tokens_simple_val)}, WmdTokens={len(tokens_wmd_val)}"
                self.status_queue.put(("log", f"    -> Metrics: {log_msg_metrics} | Tokens: {log_msg_tokens}"))

            initial_proc_duration = time.time() - initial_proc_start
            self.status_queue.put(("log", f"--- Stage 1 completed in {initial_proc_duration:.2f}s ---"))

            # --- 3. Load Models ---
            self.status_queue.put(("status", "Loading models..."))
            self.status_queue.put(("log", f"--- Stage 2/6: Loading Models (Target Device: {compute_device}) ---"))
            load_models_start = time.time()

            # Load WMD Model (Always on CPU)
            if wmd_path_val and GENSIM_AVAILABLE and POT_AVAILABLE:
                if os.path.exists(wmd_path_val):
                    self.status_queue.put(("log", f"  Loading WMD model (CPU): {os.path.basename(wmd_path_val)}..."))
                    try:
                        from gensim.models import KeyedVectors, Word2Vec, FastText # Import common types
                        # Determine loading method based on file extension or type
                        load_func = None
                        is_binary = False
                        if wmd_path_val.lower().endswith(".bin"):
                            load_func = KeyedVectors.load_word2vec_format
                            is_binary = True
                        elif wmd_path_val.lower().endswith(".vec") or wmd_path_val.lower().endswith(".txt"):
                             load_func = KeyedVectors.load_word2vec_format
                             is_binary = False
                        elif wmd_path_val.lower().endswith(".model"):
                             # Try loading as a full model first, then KeyedVectors
                             try: wmd_model_instance = Word2Vec.load(wmd_path_val)
                             except Exception:
                                 try: wmd_model_instance = FastText.load(wmd_path_val)
                                 except Exception: load_func = KeyedVectors.load # Fallback to KV load
                        else: # Assume native Gensim KeyedVectors format if no known extension
                             load_func = KeyedVectors.load

                        if load_func: # If format required specific load function
                             kwargs = {'binary': is_binary} if load_func == KeyedVectors.load_word2vec_format else {}
                             wmd_model_instance = load_func(wmd_path_val, **kwargs)

                        # Final check if model loaded
                        if wmd_model_instance:
                            self.status_queue.put(("log", f"  WMD model loaded successfully. Vocab size: {len(wmd_model_instance.key_to_index if hasattr(wmd_model_instance, 'key_to_index') else len(wmd_model_instance.wv.key_to_index))}"))
                        else:
                             raise ValueError("Model loading resulted in None.") # Should be caught below

                    except Exception as e:
                        self.status_queue.put(("log", f"  ERROR loading WMD model: {e}"))
                        traceback.print_exc()
                        wmd_model_instance = None # Ensure it's None if loading failed
                else:
                    self.status_queue.put(("log", f"  WMD path specified, but file not found: {wmd_path_val}. Skipping WMD."))
            elif wmd_path_val:
                self.status_queue.put(("log", f"  WMD path specified, but required libraries missing ({WMD_MESSAGE}). Skipping WMD."))

            # Load Sentence Transformer Model (on target device: st_device)
            if ST_AVAILABLE and st_model_name and any(texts_for_embedding.values()):
                self.status_queue.put(("log", f"  Loading ST model: {st_model_name} onto device '{st_device}'..."))
                try:
                    # Load the model, specifying the device
                    st_model_instance = SentenceTransformer(st_model_name, device=st_device)
                    # You could add a check here, e.g., st_model_instance.encode(["test sentence"])
                    # to ensure it loaded correctly, but might add overhead.
                    self.status_queue.put(("log", f"  ST model '{st_model_name}' loaded successfully onto '{st_model_instance.device}'."))
                except Exception as e:
                    self.status_queue.put(("log", f"  ERROR loading ST model '{st_model_name}' onto device '{st_device}': {e}"))
                    traceback.print_exc()
                    st_model_instance = None # Ensure it's None if loading failed
            elif ST_AVAILABLE and st_model_name:
                 self.status_queue.put(("log", "  ST model specified, but no non-empty text files found to embed. Skipping ST loading/embedding."))
            elif ST_AVAILABLE and not st_model_name:
                 self.status_queue.put(("log", "  Sentence Transformer library available, but no model name specified. Skipping ST loading/embedding."))


            # Setup OpenAI Client
            if OPENAI_AVAILABLE and openai_key_val and openai_embed_model_name and any(texts_for_embedding.values()):
                self.status_queue.put(("log", f"  Setting up OpenAI client for model '{openai_embed_model_name}'..."))
                try:
                    openai_client = OpenAI(api_key=openai_key_val)
                    # Optionally, test the client/key with a dummy call if needed, but adds cost/time
                    # openai_client.models.list()
                    self.status_queue.put(("log", "  OpenAI client setup successful."))
                except Exception as e:
                     self.status_queue.put(("log", f"  ERROR setting up OpenAI client: {e}"))
                     traceback.print_exc()
                     openai_client = None
            elif OPENAI_AVAILABLE and openai_key_val and openai_embed_model_name:
                 self.status_queue.put(("log", "  OpenAI configured, but no non-empty text files found to embed. Skipping OpenAI embedding."))
            elif OPENAI_AVAILABLE and (not openai_key_val or not openai_embed_model_name):
                 self.status_queue.put(("log", "  OpenAI library available, but API key or model name missing. Skipping OpenAI setup/embedding."))

            load_models_duration = time.time() - load_models_start
            self.status_queue.put(("log", f"--- Stage 2 completed in {load_models_duration:.2f}s ---"))

            # --- 4. Batch Embeddings ---
            self.status_queue.put(("status", "Calculating embeddings..."))
            self.status_queue.put(("log", f"--- Stage 3/6: Calculating Embeddings ---"))
            embedding_start = time.time()
            # Use only file paths that have corresponding non-empty text content
            ordered_fpaths_for_embedding = list(texts_for_embedding.keys())
            ordered_texts_for_embedding = [texts_for_embedding[fp] for fp in ordered_fpaths_for_embedding]

            # Batch ST Embeddings (use st_device, store resulting tensors on CPU)
            if st_model_instance and ordered_texts_for_embedding:
                self.status_queue.put(("log", f"  Calculating ST embeddings using device '{st_model_instance.device}' for {len(ordered_texts_for_embedding)} documents..."))
                try:
                    # Perform encoding. This might take time, especially on CPU or with large models/datasets.
                    computed_st_embeddings = st_model_instance.encode(
                        ordered_texts_for_embedding,
                        convert_to_tensor=True,
                        show_progress_bar=False # Disable internal progress bar for cleaner logs
                    )
                    # Move embeddings to CPU memory for storage and sharing between subsequent parallel tasks
                    st_embeddings = {fp: emb.cpu() for fp, emb in zip(ordered_fpaths_for_embedding, computed_st_embeddings)}
                    self.status_queue.put(("log", f"  ST embeddings calculated ({len(st_embeddings)} vectors)."))
                except Exception as e:
                    self.status_queue.put(("log", f"  ERROR during ST batch encoding: {e}"))
                    traceback.print_exc()
                    st_embeddings = {} # Clear potentially partial results on error
                    # Consider trying to free GPU memory if a CUDA OOM occurred
                    if "cuda" in str(e).lower() and compute_device == 'cuda':
                        del computed_st_embeddings # Remove reference
                        torch.cuda.empty_cache()
                        self.status_queue.put(("log", "  Attempted to clear CUDA cache after ST encoding error."))

            # Batch OpenAI Embeddings
            if openai_client and ordered_texts_for_embedding:
                self.status_queue.put(("log", f"  Calculating OpenAI embeddings using model '{openai_embed_model_name}' for {len(ordered_texts_for_embedding)} documents..."))
                try:
                    # OpenAI API has limits on input size and token count per request.
                    # Simple approach: process all at once if count is reasonable.
                    # For very large numbers, batching requests might be needed.
                    # Clean texts slightly (replace newlines, strip whitespace)
                    cleaned_texts = [t.replace("\n", " ").strip() for t in ordered_texts_for_embedding]

                    # Call OpenAI API
                    response = openai_client.embeddings.create(
                        input=cleaned_texts,
                        model=openai_embed_model_name
                    )

                    # Store embeddings (as lists or numpy arrays)
                    computed_openai_embeddings = [item.embedding for item in response.data]
                    if len(computed_openai_embeddings) == len(ordered_fpaths_for_embedding):
                         openai_embeddings = {fp: emb for fp, emb in zip(ordered_fpaths_for_embedding, computed_openai_embeddings)}
                         self.status_queue.put(("log", f"  OpenAI embeddings calculated ({len(openai_embeddings)} vectors)."))
                    else:
                        self.status_queue.put(("log", f"  WARNING: OpenAI returned {len(computed_openai_embeddings)} embeddings, but expected {len(ordered_fpaths_for_embedding)}. Results may be incomplete."))
                        # Try to match based on order, but it's risky
                        openai_embeddings = {fp: emb for fp, emb in zip(ordered_fpaths_for_embedding[:len(computed_openai_embeddings)], computed_openai_embeddings)}

                except Exception as e:
                    self.status_queue.put(("log", f"  ERROR during OpenAI batch embedding: {e}"))
                    traceback.print_exc()
                    openai_embeddings = {}

            embedding_duration = time.time() - embedding_start
            self.status_queue.put(("log", f"--- Stage 3 completed in {embedding_duration:.2f}s ---"))

            # --- 5. Prepare and Run Pairwise Comparisons (Parallel - Excluding WMD) ---
            file_pairs = list(combinations(file_paths, 2))
            total_pairs = len(file_pairs)
            if total_pairs == 0:
                # This case should only happen if num_files < 2, which is checked earlier.
                raise ValueError("Internal Error: No file pairs generated for comparison.")

            self.status_queue.put(("status", f"Calculating metrics (excl. WMD) for {total_pairs} pairs (parallel)..."))
            self.status_queue.put(("log", f"--- Stage 4/6: Calculating Pairwise Metrics (excl. WMD) ---"))
            self.status_queue.put(("log", f"  Comparing {total_pairs} pairs using up to {max_workers_to_use} parallel workers."))
            self.status_queue.put(("log", f"  (Using device '{bert_device}' for BERTScore calculations within workers)"))
            pairwise_start = time.time()
            all_results_data = [] # Re-initialize list to store results from threads

            # Prepare arguments for each parallel task
            # Pass all necessary data: file paths, caches, embeddings, and devices
            task_args = [
                (fp1, fp2, file_data_cache, st_embeddings, openai_embeddings, bert_device, bert_model_type)
                for fp1, fp2 in file_pairs
            ]

            # Use ThreadPoolExecutor for I/O bound tasks (like reading cache) and CPU-bound tasks (like Jaccard)
            # GPU tasks (like BERTScore, ST encode) release the GIL, allowing some parallelism.
            with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers_to_use) as executor:
                # Use executor.map for simplicity if order doesn't matter or for collecting all results
                results_iterator = executor.map(process_single_pair, task_args)

                processed_count = 0
                # Process results as they complete
                for result in results_iterator:
                    all_results_data.append(result) # Collect results
                    processed_count += 1
                    # Update status periodically
                    if processed_count % 20 == 0 or processed_count == total_pairs: # Update less frequently
                        self.status_queue.put(("status", f"Processed {processed_count}/{total_pairs} pairs (metrics excl. WMD)..."))
                        # Log progress occasionally
                        if processed_count % 100 == 0 or processed_count == total_pairs:
                             self.status_queue.put(("log", f"  ... processed {processed_count}/{total_pairs} pairs"))

            pairwise_duration = time.time() - pairwise_start
            self.status_queue.put(("log", f"--- Stage 4 completed in {pairwise_duration:.2f}s ---"))

            # --- 6. Calculate WMD Sequentially (CPU Only) ---
            if wmd_model_instance:
                 self.status_queue.put(("status", f"Calculating WMD for {total_pairs} pairs (sequentially on CPU)..."))
                 self.status_queue.put(("log", f"--- Stage 5/6: Calculating WMD Sequentially (CPU) ---"))
                 wmd_start_seq = time.time()
                 wmd_processed_count = 0

                 for result_dict in all_results_data: # Iterate through results collected from parallel tasks
                     # Only calculate if WMD is marked 'Pending' and no critical error occurred earlier
                     if result_dict.get('WMD') != 'Pending':
                         continue

                     fname1 = result_dict['File1']
                     fname2 = result_dict['File2']
                     # Construct full paths using the folder_path
                     fpath1_key = os.path.join(folder_path, fname1)
                     fpath2_key = os.path.join(folder_path, fname2)

                     # Retrieve cached WMD tokens
                     data1 = file_data_cache.get(fpath1_key)
                     data2 = file_data_cache.get(fpath2_key)

                     wmd_score = float('inf') # Default to infinity (error/no overlap)
                     wmd_err = "WMD calculation skipped or failed." # Default error

                     # Check if data and tokens are available
                     if data1 and data2 and 'tokens_wmd' in data1 and 'tokens_wmd' in data2:
                         tokens1_wmd = data1['tokens_wmd']
                         tokens2_wmd = data2['tokens_wmd']

                         # Proceed only if both token lists are non-empty
                         if tokens1_wmd and tokens2_wmd:
                             wmd_score, wmd_err_msg = calculate_wmd(tokens1_wmd, tokens2_wmd, wmd_model_instance)
                             if wmd_err_msg:
                                 wmd_err = f"WMD_Err (Seq): {wmd_err_msg}"
                                 # Ensure score reflects error
                                 if wmd_score is None or wmd_score != float('inf'): wmd_score = float('inf')
                             else:
                                  wmd_err = None # No error for this pair

                         else:
                             wmd_err = "WMD_Err (Seq): Empty WMD tokens for one/both files after preprocessing."
                             wmd_score = float('inf') # Treat as infinite distance
                     else:
                         wmd_err = "WMD_Err (Seq): Missing cached WMD tokens for one/both files."
                         wmd_score = None # Use None to indicate it couldn't be run (vs. Inf which means run but no overlap/error)

                     # Update the result dictionary
                     result_dict['WMD'] = wmd_score
                     if wmd_err:
                         # Append WMD error to existing errors
                         result_dict['Error'] = (result_dict.get('Error') or "") + f"; {wmd_err}"

                     wmd_processed_count += 1
                     if wmd_processed_count % 20 == 0 or wmd_processed_count == total_pairs: # Update less frequently
                          self.status_queue.put(("status", f"Calculated WMD for {wmd_processed_count}/{total_pairs} pairs..."))
                          if wmd_processed_count % 100 == 0 or wmd_processed_count == total_pairs:
                               self.status_queue.put(("log", f"  ... calculated WMD for {wmd_processed_count}/{total_pairs} pairs"))


                 wmd_seq_duration = time.time() - wmd_start_seq
                 self.status_queue.put(("log", f"--- Stage 5 completed in {wmd_seq_duration:.2f}s ---"))
            else:
                 # If no WMD model or path, mark WMD as None (N/A) for all pairs where it's pending
                 self.status_queue.put(("log", f"--- Stage 5/6: Skipping WMD (no model loaded or path specified) ---"))
                 for result_dict in all_results_data:
                     if result_dict.get('WMD') == 'Pending':
                          result_dict['WMD'] = None # Indicate not calculated

            # --- 7. Write Results to CSV ---
            if not all_results_data:
                 # This should ideally not happen if initial checks passed
                 raise ValueError("No pairwise results were generated.")

            self.status_queue.put(("status", f"Writing {len(all_results_data)} results to CSV..."))
            self.status_queue.put(("log", f"--- Stage 6/6: Writing Results to CSV ---"))
            self.status_queue.put(("log", f"  Saving results to: {output_csv_path}"))
            csv_start = time.time()

            # Define the desired order of columns
            final_headers = [
                'File1', 'File2',
                'Jaccard', 'Cosine_ST', 'Cosine_OpenAI', 'BERTScore_F1', 'Hybrid_Jacc_BERT', 'WMD', # Similarity Metrics
                'File1_GunningFog', 'File1_PassivePerc', # File 1 Metrics
                'File2_GunningFog', 'File2_PassivePerc', # File 2 Metrics
                'Error' # Error column last
            ]

            try:
                with open(output_csv_path, 'w', newline='', encoding='utf-8') as csvfile:
                    # Use the defined headers; ignore any extra keys found in data (shouldn't be any)
                    writer = csv.DictWriter(csvfile, fieldnames=final_headers, extrasaction='ignore')
                    writer.writeheader()

                    for row_data in all_results_data:
                         formatted_row = {}
                         for key in final_headers: # Iterate through desired headers
                             value = row_data.get(key) # Get value safely

                             # Format based on key/type
                             if key in ['File1', 'File2', 'Error']:
                                 formatted_row[key] = value if value is not None else ""
                             elif key in ['File1_PassivePerc', 'File2_PassivePerc']:
                                 if isinstance(value, (float, int, np.number)) and not np.isnan(value):
                                     formatted_row[key] = f"{value:.2%}" # Format as percentage
                                 else: formatted_row[key] = str(value) if value is not None else "N/A" # Handle N/A, Error, etc.
                             elif value is None:
                                 formatted_row[key] = "N/A"
                             elif value == float('inf'):
                                 formatted_row[key] = "Inf/Error" # Consistent representation for WMD errors/no overlap
                             elif isinstance(value, (float, int, np.number)):
                                 if np.isnan(value): formatted_row[key] = "NaN" # Explicitly handle NaN
                                 else:
                                     # Use more precision for similarity scores, less for readability
                                     precision = 6 if key not in ['File1_GunningFog', 'File2_GunningFog'] else 2
                                     try: formatted_row[key] = f"{float(value):.{precision}f}"
                                     except (ValueError, TypeError): formatted_row[key] = str(value) # Fallback
                             else: # Catch-all for other types (e.g., string error messages in metric columns)
                                 formatted_row[key] = str(value)

                         writer.writerow(formatted_row)

            except PermissionError:
                raise IOError(f"Permission denied writing CSV file '{output_csv_path}'. Is the file open in another application (e.g., Excel)?")
            except Exception as e:
                 raise IOError(f"Error writing CSV file '{output_csv_path}': {e}")

            csv_duration = time.time() - csv_start
            self.status_queue.put(("log", f"--- Stage 6 completed in {csv_duration:.2f}s ---"))

            # --- Final Success Logging ---
            total_script_duration = time.time() - start_time_total
            self.status_queue.put(("log", f"--- Batch Comparison Complete ---"))
            success_message = f"Successfully processed {num_files} files and compared {len(all_results_data)} pairs.\nResults saved to:\n{output_csv_path}"
            self.status_queue.put(("log", success_message))
            self.status_queue.put(("log", f"Total time taken: {total_script_duration:.2f} seconds."))
            self.status_queue.put(("status", "Batch comparison finished successfully."))
            # Show success message box via the main thread queue
            self.status_queue.put(("info_messagebox", ("Success", success_message)))

        except Exception as e: # Catch errors from any stage
            error_message = f"FATAL BATCH ERROR: {type(e).__name__}: {e}"
            # Print full traceback to console for detailed debugging
            print("="*60)
            print(error_message)
            traceback.print_exc()
            print("="*60)

            # Log concise error in GUI log
            self.status_queue.put(("log", f"!!! {error_message} !!!"))

            # Add specific advice based on common errors
            err_str = str(e).lower()
            if "cuda out of memory" in err_str:
                 advice = "CUDA Out of Memory detected. Try a smaller model (ST/BERT), reduce 'Max Files', close other GPU-heavy apps, or run on CPU."
                 self.status_queue.put(("log", f"!!! Advice: {advice} !!!"))
                 error_message += f"\n\nAdvice: {advice}"
            elif "memory" in err_str and "wmd" in traceback.format_exc().lower():
                 advice = "Potential Memory Error during WMD calculation. Ensure sufficient RAM for the WMD model and data. Try processing fewer files if RAM is limited."
                 self.status_queue.put(("log", f"!!! Advice: {advice} !!!"))
                 error_message += f"\n\nAdvice: {advice}"
            elif "meta tensor" in err_str:
                 advice = "BERTScore 'meta tensor' error. This often relates to library versions. Try updating PyTorch, Transformers, and BERTScore (`pip install --upgrade ...`). If using GPU, forcing CPU might be a workaround."
                 self.status_queue.put(("log", f"!!! Advice: {advice} !!!"))
                 error_message += f"\n\nAdvice: {advice}"
            elif isinstance(e, IOError) and "Permission denied" in str(e):
                 advice = "Cannot write the output CSV file. Please ensure the file is not open in another program (like Excel) and that you have write permissions to the directory."
                 # Error message already contains this info
                 self.status_queue.put(("log", f"!!! Advice: {advice} !!!"))

            self.status_queue.put(("log", "Batch processing halted due to error. Check log and console for details."))
            self.status_queue.put(("status", "Error during batch comparison. Check logs."))
            # Show error message box via the main thread queue
            self.status_queue.put(("error_messagebox", ("Batch Processing Error", f"An error occurred:\n{error_message}\n\nPlease check the log panel and console output for more details.")))

        finally: # Cleanup and final GUI updates
            # --- Clear large data structures ---
            del file_data_cache, st_embeddings, openai_embeddings, all_results_data
            if wmd_model_instance: del wmd_model_instance
            if st_model_instance: del st_model_instance
            if openai_client: del openai_client

            # --- Attempt to clear CUDA cache if GPU was used ---
            if compute_device == 'cuda' and TORCH_AVAILABLE and torch.cuda.is_available():
                  try:
                      torch.cuda.empty_cache()
                      self.status_queue.put(("log", "Attempted to clear CUDA cache."))
                  except Exception as cache_e:
                      self.status_queue.put(("log", f"Note: Error trying to clear CUDA cache: {cache_e}"))

            # --- Re-enable the run button via the queue ---
            self.status_queue.put(("enable_run_button", None))


