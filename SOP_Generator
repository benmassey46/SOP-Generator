def clean_filename(name):
    """Removes invalid characters for filenames and replaces spaces with underscores."""
    if not name: return "Untitled"
    # Remove characters invalid in Windows/Linux/Mac filenames using regex
    name = re.sub(r'[\\/*?:"<>|]+', "", name)
    # Replace sequences of whitespace (including spaces, tabs, newlines) with a single underscore
    name = re.sub(r'\s+', '_', name)
    # Remove leading/trailing underscores that might result from replacements
    name = name.strip('_')
    # Ensure filename isn't empty after cleaning (e.g., if input was just invalid chars)
    # Limit length to avoid issues on some filesystems
    max_len = 100
    return name[:max_len] if name else "Untitled"


