def on_fine_grained_window_close(window_instance):
    """Callback when the fine-grained comparison window is closed."""
    global fine_grained_comparison_window, fine_grained_results_cache
    if window_instance and window_instance.winfo_exists():
        try:
            window_instance.grab_release() # Release modal grab
            window_instance.destroy()
        except tk.TclError as e:
            print(f"Error closing fine-grained comparison window: {e}")
    # Reset global state associated with this window
    fine_grained_comparison_window = None
    fine_grained_results_cache = {}
    update_menu_states() # Update main window menu states


def run_fine_grained_comparison_thread(m1_name, text1, m2_name, text2, results_widget, save_button, status_var, progress_bar, window_ref):
    """Worker thread that performs fine-grained comparison."""
    global fine_grained_results_cache
    results_data = None
    error_occurred = False
    critical_error_msg = ""

    def update_fg_status(msg):
        # ... (status update helper remains the same) ...
        if window_ref and window_ref.winfo_exists() and status_var:
            try:
                window_ref.after(0, lambda m=msg: status_var.set(m) if status_var else None)
            except tk.TclError: pass

    try:
        update_fg_status("Status: Parsing documents into sections...")
        parsed1 = parse_sop_sections(text1)
        parsed2 = parse_sop_sections(text2)

        update_fg_status("Status: Comparing sections and structure...")
        results_data = compare_parsed_sops(parsed1, parsed2, status_callback=update_fg_status)

        # <<< --- FIX: ADD MODEL NAMES TO RESULTS DICT --- >>>
        if results_data and isinstance(results_data, dict):
            # Only add if compare_parsed_sops returned a valid dictionary
            results_data['model1_name'] = m1_name
            results_data['model2_name'] = m2_name
        elif not results_data:
            # Handle case where compare_parsed_sops might return None or empty
            results_data = {
                'error': 'Comparison function returned no data.',
                'model1_name': m1_name, # Still store names even on error
                'model2_name': m2_name
            }
            error_occurred = True # Mark as error if base comparison failed
        # <<< --- END FIX --- >>>

        # Store results in cache (now includes model names)
        fine_grained_results_cache = results_data

    except Exception as e:
        critical_error_msg = f"Critical Error during Fine-Grained Analysis:\n{type(e).__name__}: {e}\n\n{traceback.format_exc()}"
        print(critical_error_msg)
        # <<< FIX: Ensure names are in cache even on critical error >>>
        fine_grained_results_cache = {
            'error': critical_error_msg,
            'model1_name': m1_name,
            'model2_name': m2_name
        }
        # <<< END FIX >>>
        error_occurred = True
        if window_ref and window_ref.winfo_exists() and status_var:
             try:
                 window_ref.after(0, lambda: status_var.set("Status: Critical Error during analysis! See console."))
             except tk.TclError: pass

    finally:
        # Schedule Final GUI Update (passing the cache which now reliably has names)
        if window_ref and window_ref.winfo_exists():
            try:
                window_ref.after(0, lambda err=error_occurred, data=results_data, cache=fine_grained_results_cache.copy(): _update_fine_grained_gui_final(
                    err, data, cache, m1_name, m2_name, # Pass m1/m2 name still for direct use in GUI report gen
                    results_widget, save_button, status_var, progress_bar, window_ref
                ))
            except tk.TclError: pass 


def _update_fine_grained_gui_final(error_occurred, results_data, results_cache, m1_name, m2_name,
                                   results_widget, save_button, status_var, progress_bar, window_ref):
    """Updates the Fine-Grained Comparison GUI on the main thread after analysis."""
    if not window_ref or not window_ref.winfo_exists(): return

    # --- Stop and Hide Progress Bar ---
    if progress_bar and progress_bar.winfo_exists():
        try:
            progress_bar.stop()
            progress_bar.grid_forget() # Use grid_forget if placed with grid
        except tk.TclError: pass

    # --- Generate and Display Report ---
    report_segments = [] # Initialize
    nl = "\n" # Define newline character alias for clarity

    if results_widget and results_widget.winfo_exists():
        try:
            results_widget.config(state='normal')
            results_widget.delete('1.0', tk.END)

            if 'error' in results_cache:
                # Display critical error using tags
                # <<< FIX: Changed /n to \n (newline character) >>>
                report_segments = [
                    (f"--- ANALYSIS FAILED ---{nl}", "fg_header"),
                    (f"{nl}{results_cache['error']}{nl}", "fg_status_error")
                ]
                error_occurred = True # Ensure flag reflects cache state
            elif results_data:
                # Generate the list of (text, tag) segments
                report_segments = generate_fine_grained_report(m1_name, m2_name, results_data)
            else:
                # <<< FIX: Changed /n to \n (newline character) >>>
                report_segments = [(f"Analysis completed, but no results data was generated. Check logs.{nl}", "fg_warning")]
                error_occurred = True # Treat as error state

            # --- Insert segments with tags ---
            if report_segments:
                for text_segment, tag_name in report_segments:
                    # Ensure tag exists before applying
                    tag_exists = False
                    try:
                        # Check if tag is configured in the widget
                        results_widget.tag_cget(tag_name, 'foreground') # Or any other option
                        tag_exists = True
                    except tk.TclError:
                        # Tag doesn't exist, use default insertion
                        print(f"Warning: Tag '{tag_name}' not found. Using default.")

                    if tag_name and tag_exists:
                        results_widget.insert(tk.END, text_segment, (tag_name,))
                    else: # Fallback if tag is missing or doesn't exist
                        results_widget.insert(tk.END, text_segment)
            # --- END Insert segments ---

            results_widget.config(state='disabled') # Make read-only again
            results_widget.see("1.0") # Scroll to top

            # --- Update Save Button State ---
            can_save = not error_occurred and results_data
            if save_button and save_button.winfo_exists():
                 save_button.config(
                     state=tk.NORMAL if can_save else tk.DISABLED,
                     # <<< FIX: Lambda now only needs to pass the captured cache >>>
                     command=lambda cache=results_cache.copy(): save_fine_grained_report(
                         cache, # Pass the captured data cache
                         status_var, # Pass the status_var from the scope
                         window_ref  # Pass the window_ref from the scope
                     ) if can_save else None
                 )

        except tk.TclError as e:
            print(f"TclError updating fine-grained results widget: {e}")
        except Exception as e:
            print(f"Error generating/displaying fine-grained report: {e}")
            traceback.print_exc()
            # Try to display error in widget
            try:
                results_widget.config(state='normal')
                results_widget.delete('1.0', tk.END)
                results_widget.insert('1.0', f"--- Error Generating Report Display ---\n{type(e).__name__}: {e}\n(See console for details)", ("fg_status_error",))
                results_widget.config(state='disabled')
            except tk.TclError: pass # Ignore if widget error occurs during error display

    # --- Update Status Bar ---
    final_status = "Status: Fine-grained analysis complete." if not error_occurred else "Status: Fine-grained analysis failed."
    if status_var:
        try: status_var.set(final_status)
        except tk.TclError: pass

    # Update main menu states (e.g., enable save report)
    try:
        update_menu_states()
    except NameError:
        print("Warning: update_menu_states function not found.")
    except Exception as e_menu:
        print(f"Error calling update_menu_states: {e_menu}")

