def get_active_output_widget():
    """Gets the ScrolledText widget associated with the currently selected output tab."""
    try:
        # Ensure notebook and its backing dictionary exist and are valid
        if ('output_notebook' not in globals() or not output_notebook or not output_notebook.winfo_exists() or
            'output_widgets' not in globals() or not isinstance(output_widgets, dict)):
             return None

        # Check if there are any tabs at all
        if not output_notebook.tabs():
             return None

        selected_tab_id = output_notebook.select() # Get the ID of the currently selected tab
        if not selected_tab_id:
             return None # No tab selected

        # Get the text label of the selected tab
        tab_text = output_notebook.tab(selected_tab_id, "text")

        # Check if it's the placeholder tab (which has no associated generation widget)
        if tab_text == "Outputs":
            return None

        # Retrieve the widget associated with this tab name from our dictionary
        widget = output_widgets.get(tab_text)

        # Verify the widget still exists and hasn't been destroyed
        if widget and widget.winfo_exists():
            return widget
        else:
            # Clean up the dictionary if the widget reference is broken
            if tab_text in output_widgets:
                 output_widgets.pop(tab_text)
                 print(f"Widget cache warning: Widget reference for tab '{tab_text}' was invalid/destroyed.")
            return None

    except tk.TclError as e:
        # Catch errors like invalid tab ID if tab removed between getting ID and getting text
        # print(f"TclError getting active output widget: {e}") # Optional debug
        return None
    except (AttributeError, KeyError) as e:
        # Catch other potential errors accessing notebook/widget properties
        print(f"Error getting active output widget: {e}")
        return None


