def get_system_message():
    """
    Constructs the final system message by reading the base text from the UI,
    getting the selected target audience, formatting examples (if enabled),
    and substituting placeholders.
    """
    base_message = DEFAULT_SYSTEM_MESSAGE # Start with the raw default
    role_desc = DEFAULT_ROLE_DESCRIPTION # Use the defined role
    selected_audience = DEFAULT_TARGET_AUDIENCE # Default audience
    examples_section = "" # Placeholder for formatted examples

    # Try to get the user's potentially edited message from the text widget
    sys_msg_widget = globals().get('system_message_text')
    if sys_msg_widget and sys_msg_widget.winfo_exists():
        try:
            current_widget_text = sys_msg_widget.get("1.0", tk.END).strip()
            if current_widget_text:
                base_message = current_widget_text
        except tk.TclError: print("Warning: Could not read custom system message from widget.")
        except Exception as e: print(f"Warning: Unexpected error reading system message widget: {e}")

    # Try to get the selected audience from the combobox
    aud_var = globals().get('audience_var')
    if aud_var:
        try:
            selected_audience = aud_var.get() or DEFAULT_TARGET_AUDIENCE
        except Exception as e: print(f"Warning: Could not get selected audience: {e}")

    # Check and add examples if enabled
    use_examples_flag = False
    use_ex_var = globals().get('use_examples_var')
    if use_ex_var:
        try: use_examples_flag = use_ex_var.get()
        except Exception as e: print(f"Warning: Could not get 'use examples' flag: {e}")

    if use_examples_flag:
        ex_widget = globals().get('examples_text_widget')
        if ex_widget and ex_widget.winfo_exists():
            try:
                example_text = ex_widget.get("1.0", tk.END).strip()
                if example_text:
                    # Format the examples section clearly
                    examples_section = f"\n\nFollow the style, structure, and level of detail demonstrated in the examples below:\n"
                    examples_section += f"{EXAMPLE_START_MARKER}\n"
                    examples_section += example_text # Add the raw user examples
                    examples_section += f"\n{EXAMPLE_END_MARKER}\n"
            except tk.TclError: print("Warning: Could not read examples text widget.")
            except Exception as e: print(f"Warning: Unexpected error reading examples text widget: {e}")

    # --- Substitute Placeholders and Assemble ---
    final_message = base_message # Start with the potentially customized base

    # Substitute {ROLE_DESCRIPTION}
    if "{ROLE_DESCRIPTION}" in final_message:
        final_message = final_message.replace("{ROLE_DESCRIPTION}", role_desc, 1)
    else:
        final_message = role_desc + "\n" + final_message

    # Substitute {TARGET_AUDIENCE}
    if "{TARGET_AUDIENCE}" in final_message:
        final_message = final_message.replace("{TARGET_AUDIENCE}", selected_audience, 1)
    else:
        print("Warning: {TARGET_AUDIENCE} placeholder missing in system message. Appending audience info.")
        # Attempt to insert audience info somewhat logically
        guideline_1_pos = final_message.find("1. ") # Find first guideline
        if guideline_1_pos != -1:
             final_message = final_message[:guideline_1_pos] + f"The target audience for this SOP is: **{selected_audience}**. Tailor the language, level of detail, and terminology accordingly.\n\n" + final_message[guideline_1_pos:]
        else: # Fallback: append
             final_message += f"\n\n(Note: Target audience specified as: **{selected_audience}**)"


    # Insert Examples (if any) before the guidelines section
    guidelines_marker = "When generating the SOP, please follow these guidelines:"
    marker_pos = final_message.find(guidelines_marker)

    if examples_section and marker_pos != -1:
        final_message = final_message[:marker_pos] + examples_section + "\n" + final_message[marker_pos:]
    elif examples_section:
        print("Warning: Could not find guideline marker to insert examples. Appending examples.")
        final_message += examples_section

    return final_message.strip()


def engineer_user_prompt(sop_topic, additional_context):
    """
    Takes the raw user topic and context, and engineers a more structured
    prompt for the AI model to generate an SOP.

    Args:
        sop_topic (str): The core topic for the SOP.
        additional_context (str): Any extra details or requirements provided by the user.

    Returns:
        str: A structured user prompt string ready for the AI model.
    """
    if not sop_topic:
        # Handle cases where topic might be missing (should be validated earlier, but safe)
        return "Please generate a Standard Operating Procedure (SOP)."

    # Start with a clear, direct instruction
    prompt_lines = [
        "Generate a detailed and comprehensive Standard Operating Procedure (SOP) for the following topic:",
        f'Topic: "{sop_topic.strip()}"'
    ]

    # Incorporate additional context if provided
    if additional_context and additional_context.strip():
        prompt_lines.extend([
            "\nIncorporate the following specific requirements, context, or details:",
            "--- START CONTEXT ---",
            additional_context.strip(),
            "--- END CONTEXT ---"
        ])

    # Add a concluding instruction to reinforce focus and desired output format
    # (This complements the system message)
    prompt_lines.append(
        "\nEnsure the SOP is well-structured according to standard practices (e.g., sections like Purpose, Scope, Responsibilities, Procedure, etc.), uses clear language, and incorporates all provided context effectively."
    )

    return "\n".join(prompt_lines)

