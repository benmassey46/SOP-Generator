def run_follow_up_query_thread(model_name, convo_widget, button_widget, status_var, window_ref):
    """Worker thread to call AI API for follow-up queries."""
    global review_data_cache
    model_response_text = ""
    error_message = None
    api_provider = AVAILABLE_MODELS.get(model_name, {}).get("provider")

    try:
        # --- Prepare Context for API ---
        original_sop = review_data_cache.get("original_sop", "SOP context is missing.")
        history = review_data_cache.get("conversation_history", []) # Should be [{'role': 'user'/'assistant', 'content':...}]

        system_prompt = f"""You are assisting a user reviewing a Standard Operating Procedure (SOP) that you ({model_name}) previously generated.
The original SOP content is provided below. Answer the user's follow-up questions or instructions based on this SOP context and the previous conversation turns.
Keep your answers concise and relevant to the SOP.

--- ORIGINAL SOP START ---
{original_sop}
--- ORIGINAL SOP END ---
"""
        # Construct messages list based on provider requirements
        messages = []
        if api_provider == "Google Gemini":
             # Gemini expects specific format: {'role': 'user'/'model', 'parts': [{'text': ...}]}
             gemini_messages = []
             for turn in history:
                 role = turn.get("role")
                 content = turn.get("content", "")
                 # Map 'assistant' role from our cache to 'model' for Gemini API
                 api_role = "model" if role == "assistant" else "user"
                 # Ensure content is not empty before adding part
                 if content:
                     gemini_messages.append({'role': api_role, 'parts': [{'text': content}]})
                 else:
                      print(f"Warning: Skipping empty content turn for role '{role}' in Gemini history.")
             # We will pass system_prompt separately via system_instruction
        else:
            # OpenAI / Anthropic format (Anthropic system handled in stream call)
            if api_provider != "Anthropic Claude":
                messages.append({"role": "system", "content": system_prompt})
            # Add conversation history (keeping original roles)
            messages.extend(history)


        # --- API Call ---
        if api_provider == "OpenAI":
            if not openai_client: raise ValueError("OpenAI client not available.")
            stream = openai_client.chat.completions.create(
                model=model_name, messages=messages, stream=True, max_tokens=1024, temperature=0.5
            )
            # ... (rest of OpenAI streaming logic - no changes needed here) ...
            for chunk in stream:
                 content = chunk.choices[0].delta.content
                 if content:
                      model_response_text += content
                      if window_ref and window_ref.winfo_exists():
                          window_ref.after(0, lambda txt=content: _update_review_conversation_gui(convo_widget, txt, "model_response", append=True))


        elif api_provider == "Google Gemini":
            if not google_api_configured: raise ValueError("Google Gemini API not configured.")
            # Pass system prompt separately
            model = genai.GenerativeModel(model_name, system_instruction=system_prompt)
            # Use the correctly formatted gemini_messages list
            # <<< FIX: Pass the correctly formatted list >>>
            response = model.generate_content(gemini_messages, stream=True, generation_config=genai.types.GenerationConfig(temperature=0.5))
            # ... (rest of Gemini streaming logic - no changes needed here) ...
            for chunk in response:
                 chunk_text = ""
                 try:
                     if hasattr(chunk, 'parts') and chunk.parts: chunk_text = "".join(part.text for part in chunk.parts if hasattr(part, 'text'))
                     elif hasattr(chunk, 'text'): chunk_text = chunk.text
                 except Exception: pass
                 if chunk_text:
                     model_response_text += chunk_text
                     if window_ref and window_ref.winfo_exists():
                         window_ref.after(0, lambda txt=chunk_text: _update_review_conversation_gui(convo_widget, txt, "model_response", append=True))


        elif api_provider == "Anthropic Claude":
            if not anthropic_client: raise ValueError("Anthropic client not available.")
            # Anthropic takes system prompt separately in the stream call
            # Use the 'messages' list which contains user/assistant roles
            claude_messages = [m for m in messages if m.get("role") != "system"] # Ensure system isn't duplicated
            with anthropic_client.messages.stream(
                model=model_name, max_tokens=1024, system=system_prompt, messages=claude_messages, temperature=0.5
            ) as stream:
                 # ... (rest of Anthropic streaming logic - no changes needed here) ...
                for text_chunk in stream.text_stream:
                    model_response_text += text_chunk
                    if window_ref and window_ref.winfo_exists():
                        window_ref.after(0, lambda txt=text_chunk: _update_review_conversation_gui(convo_widget, txt, "model_response", append=True))
            final_msg = stream.get_final_message()
            if final_msg.stop_reason not in ['end_turn', 'stop_sequence']:
                 error_message = f"Model stopped unexpectedly ({final_msg.stop_reason})."

        else:
            raise ValueError(f"Follow-up query not implemented for provider: {api_provider}")

        # Add a newline after the complete response for separation
        if model_response_text and window_ref and window_ref.winfo_exists():
            window_ref.after(0, lambda: _update_review_conversation_gui(convo_widget, "\n", "model_response", append=True))

    except Exception as e:
        error_message = f"Error during query to {model_name}:\n{type(e).__name__}: {e}"
        print(f"Follow-up Query Error: {e}")
        traceback.print_exc()
        if window_ref and window_ref.winfo_exists():
            window_ref.after(0, lambda: _update_review_conversation_gui(convo_widget, f"\n--- {error_message} ---\n", "error_message", append=True))

    finally:
        # --- Update GUI State (on main thread) ---
        # ... (rest of finally block - no changes needed here) ...
        if window_ref and window_ref.winfo_exists():
            def final_update():
                # Re-enable button
                if button_widget and button_widget.winfo_exists():
                    try: button_widget.config(state=tk.NORMAL)
                    except tk.TclError: pass
                # Update status
                if status_var:
                    final_status = "Status: Model response received." if not error_message else "Status: Error receiving model response."
                    try: status_var.set(final_status)
                    except tk.TclError: pass
                # Add complete model response (or error marker) to cache history
                if not error_message and model_response_text:
                    review_data_cache["conversation_history"].append({"role": "assistant", "content": model_response_text})
                elif error_message:
                     review_data_cache["conversation_history"].append({"role": "assistant", "content": f"[ERROR: {error_message}]"})

            window_ref.after(0, final_update)


def _update_review_conversation_gui(widget, text, tag, append=False, replace=False):
    """Safely updates the conversation ScrolledText widget."""
    if not widget or not widget.winfo_exists(): return
    try:
        widget.config(state=tk.NORMAL)
        if replace:
            widget.delete("1.0", tk.END)
        if append:
            # Insert text with the specified tag
            widget.insert(tk.END, text, (tag,))
        else: # Insert with prefix and tag
             prefix = "You: " if tag == "user_query" else "AI: "
             if tag == "error_message": prefix = "" # No prefix for errors
             widget.insert(tk.END, f"{prefix}{text}\n", (tag,))

        widget.see(tk.END) # Scroll to bottom
        widget.config(state=tk.DISABLED)
    except tk.TclError as e:
        print(f"TclError updating conversation widget: {e}")
    except Exception as e:
        print(f"Unexpected error updating conversation widget: {e}")

def calculate_automated_metrics(sop_text):
    """Calculates readability and basic structure/consistency metrics."""
    metrics = {
        "readability": {"flesch_reading_ease": None, "gunning_fog": None, "avg_sentence_length": None},
        "structure": {"section_headings": [], "list_item_count": 0, "heading_levels": {}, "list_types": set()},
        # <<<--- NEW: Add categories for other checks --->>>
        "clarity_proxy": {"passive_voice_sentences": 0, "total_sentences": 0, "passive_voice_ratio": None},
        "completeness_proxy": {"standard_sections_found": [], "standard_sections_missing": []},
        "consistency_proxy": {"heading_level_usage": {}, "list_type_usage": "N/A"}
    }
    if not sop_text:
        return metrics # Return empty if no text

    total_sentences = 0
    passive_sentences = 0

    # --- Readability (Requires textstat and NLTK) ---
    avg_sent_len = None
    if TEXTSTAT_AVAILABLE:
        try:
            metrics["readability"]["flesch_reading_ease"] = textstat.flesch_reading_ease(sop_text)
            metrics["readability"]["gunning_fog"] = textstat.gunning_fog(sop_text)
        except Exception as e:
            print(f"Warning: textstat calculation failed: {e}")

    sentences = [] # Keep sentences list for reuse
    if NLTK_AVAILABLE:
        try:
            sentences = nltk.sent_tokenize(sop_text)
            total_sentences = len(sentences)
            metrics["clarity_proxy"]["total_sentences"] = total_sentences
            if sentences:
                 word_counts = [len(nltk.word_tokenize(s)) for s in sentences]
                 avg_sent_len = sum(word_counts) / total_sentences if total_sentences > 0 else 0
                 metrics["readability"]["avg_sentence_length"] = avg_sent_len
        except LookupError:
             print("Warning: NLTK 'punkt' resource needed for sentence tokenization. Some metrics skipped.")
             total_sentences = 0 # Reset if failed
        except Exception as e:
             print(f"Warning: NLTK sentence processing failed: {e}")
             total_sentences = 0 # Reset if failed

    # --- Passive Voice Check (Requires spaCy and NLTK sentences) ---
    if SPACY_AVAILABLE and nlp_spacy and sentences:
        try:
            # Process sentences efficiently with nlp.pipe if many sentences, or just loop
            for sent_text in sentences:
                 if len(sent_text) > nlp_spacy.max_length: continue # Skip too long sentences for spaCy
                 doc = nlp_spacy(sent_text)
                 is_passive = False
                 for token in doc:
                     # Check for passive auxiliary or passive nominal subject
                     if token.dep_ == "nsubjpass" or (token.dep_ == "auxpass"):
                         is_passive = True
                         break
                 if is_passive:
                     passive_sentences += 1
            metrics["clarity_proxy"]["passive_voice_sentences"] = passive_sentences
            if total_sentences > 0:
                metrics["clarity_proxy"]["passive_voice_ratio"] = passive_sentences / total_sentences
        except Exception as e:
            print(f"Warning: spaCy passive voice check failed: {e}")
    elif sentences: # If spaCy not available but we have sentences
         metrics["clarity_proxy"]["passive_voice_ratio"] = "N/A (spaCy unavailable)"


    # --- Structure & Consistency ---
    detected_headings = []
    heading_level_counts = {} # Store counts for each level
    list_types_found = set()
    list_item_count = 0

    try:
        lines = sop_text.splitlines()
        heading_pattern = re.compile(r"^\s*(#+)\s+(.*)") # Markdown headings

        for line in lines:
            line_strip = line.strip()
            # Heading check
            match = heading_pattern.match(line_strip)
            if match:
                 level = len(match.group(1))
                 heading_text = match.group(2).strip()
                 detected_headings.append(heading_text)
                 heading_level_counts[level] = heading_level_counts.get(level, 0) + 1
            # List item check (using refined pattern from detect_list_items)
            list_match = re.match(r"^\s*(?:(?:\d+\.)|(?:\*)|(?:\-)|(?:\([a-zA-Z0-9]+\)))\s+", line_strip)
            if list_match:
                list_item_count += 1
                marker = list_match.group(0).strip() # Get the marker part
                if marker.endswith('.') or marker.startswith('('):
                     list_types_found.add("numbered/lettered")
                elif marker in ['*', '-']:
                     list_types_found.add("bullet")

        metrics["structure"]["section_headings"] = detected_headings
        metrics["structure"]["list_item_count"] = list_item_count
        metrics["consistency_proxy"]["heading_level_usage"] = heading_level_counts

        # Analyze list type usage
        list_usage_desc = "N/A"
        if list_item_count == 0:
            list_usage_desc = "No list items detected."
        elif len(list_types_found) == 1:
            list_usage_desc = f"Consistent ({list(list_types_found)[0]} only)."
        elif len(list_types_found) > 1:
            list_usage_desc = f"Mixed ({', '.join(sorted(list(list_types_found)))})."
        metrics["consistency_proxy"]["list_type_usage"] = list_usage_desc

    except Exception as e:
        print(f"Warning: Error during structure/consistency analysis: {e}")

    # --- Completeness Proxy (Standard Sections) ---
    standard_sections_expected = {"purpose", "scope", "responsibilities", "procedure", "safety", "definitions", "references"} # Lowercase
    found_normalized = set()
    if detected_headings: # Use headings detected earlier
        for h in detected_headings:
            # Basic normalization: lower, remove punctuation, check first word(s)
            normalized_h = re.sub(r'[^\w\s]', '', h.lower()).strip()
            # Check if the normalized heading starts with a standard section name
            for std_sec in standard_sections_expected:
                 if normalized_h.startswith(std_sec):
                      found_normalized.add(std_sec)
                      break # Found a match for this heading

    metrics["completeness_proxy"]["standard_sections_found"] = sorted(list(found_normalized))
    metrics["completeness_proxy"]["standard_sections_missing"] = sorted(list(standard_sections_expected - found_normalized))

    return metrics


