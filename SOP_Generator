             sim_text = f"ST Cosine ({st_label}) = {f'{avg_st:.4f}' if avg_st is not None else 'N/A'}"
        elif avg_bs is not None:
             sim_text = f"BERTScore F1 = {f'{avg_bs:.4f}' if avg_bs is not None else 'N/A'}"

        kt_jac_text = f"Key Term Overlap (Jaccard): {f'{kt_jac:.4f}' if kt_jac is not None else 'N/A'}"
