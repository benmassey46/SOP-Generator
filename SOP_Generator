def open_file_external(filepath):
    """Attempts to open a given file using the default system application."""
    parent_window = root if 'root' in globals() and root and root.winfo_exists() else None

    if not filepath or not os.path.exists(filepath):
        messagebox.showwarning("File Not Found", f"The specified file does not exist or path is invalid:\n{filepath}", parent=parent_window)
        return

    try:
        current_system = platform.system()
        if current_system == "Windows":
            os.startfile(filepath) # Recommended way on Windows
        elif current_system == "Darwin": # macOS
            subprocess.run(['open', filepath], check=True) # 'open' command
        else: # Linux and other POSIX systems
            subprocess.run(['xdg-open', filepath], check=True) # 'xdg-open' is standard

    except FileNotFoundError:
         # This might happen if the command (open, xdg-open) isn't in the system's PATH
         messagebox.showerror("Command Not Found", f"Could not find the command required to open the file on this system ({current_system}).", parent=parent_window)
    except subprocess.CalledProcessError as e:
         # This happens if the command runs but returns an error code
         messagebox.showerror("Error Opening File", f"The system command ('{e.cmd}') failed with error code {e.returncode}.\nIs there an application associated with this file type?", parent=parent_window)
    except Exception as e:
        # Catch other potential errors (e.g., permissions)
        messagebox.showerror("Error Opening File", f"An unexpected error occurred while trying to open the file:\n{e}", parent=parent_window)


