    if provider == "OpenAI":
        # Check both key presence AND successful client initialization
        return bool(OPENAI_API_KEY) and bool(openai_client)
    elif provider == "Google Gemini":
        # Check key presence AND successful configuration flag
        return bool(GOOGLE_API_KEY) and google_api_configured
    elif provider == "Anthropic Claude":
        return bool(ANTHROPIC_API_KEY) and bool(anthropic_client)
