DEBOUNCE_DELAY_MS = 600 # Milliseconds to wait after user stops typing

def schedule_feedback_update(widget_id, immediate=False):
    """Cancels previous timer and schedules a new feedback update after a delay."""
    global topic_debounce_timer, context_debounce_timer, sys_msg_debounce_timer
    global root # Need access to root for 'after'

    timer_var = None
    feedback_func = None

    if widget_id == "topic":
        timer_var = topic_debounce_timer
        feedback_func = lambda: run_feedback_analysis("topic")
    elif widget_id == "context":
        timer_var = context_debounce_timer
        feedback_func = lambda: run_feedback_analysis("context")
    elif widget_id == "sys_msg":
        timer_var = sys_msg_debounce_timer
        feedback_func = lambda: run_feedback_analysis("sys_msg")
    else:
        return # Unknown widget ID

    # Cancel the previous timer for this specific widget, if it exists
    if timer_var:
        try:
            root.after_cancel(timer_var)
            # print(f"Cancelled timer for {widget_id}: {timer_var}") # Debug
        except Exception as e:
            # print(f"Could not cancel timer for {widget_id}: {e}") # Debug (ignore errors)
            pass

    # Schedule the new analysis or run immediately
    if immediate:
        # print(f"Running feedback immediately for {widget_id}") # Debug
        if feedback_func: feedback_func()
        new_timer = None # No new timer needed
    else:
        if feedback_func:
            new_timer = root.after(DEBOUNCE_DELAY_MS, feedback_func)
            # print(f"Scheduled timer for {widget_id}: {new_timer}") # Debug
        else:
            new_timer = None

    # Store the new timer ID back into the global variable
    if widget_id == "topic": topic_debounce_timer = new_timer
    elif widget_id == "context": context_debounce_timer = new_timer
    elif widget_id == "sys_msg": sys_msg_debounce_timer = new_timer


def run_feedback_analysis(widget_id):
    """Gets text and runs the appropriate analysis function."""
    text = ""
    widget = None
    feedback_label = None
    # Define the globals needed within this function's scope
    global custom_topic_entry, topic_feedback_label, custom_topic_var
    global context_entry, context_feedback_label
    global system_message_text, sys_msg_feedback_label

    try:
        if widget_id == "topic":
            widget = custom_topic_entry
            feedback_label = topic_feedback_label
            # Ensure custom_topic_var is accessible and get its value
            if widget and widget.winfo_exists() and 'custom_topic_var' in globals() and custom_topic_var:
                 text = custom_topic_var.get()
            else: return # Exit if var missing
        elif widget_id == "context":
            widget = context_entry
            feedback_label = context_feedback_label
            if widget and widget.winfo_exists(): text = widget.get("1.0", tk.END)
        elif widget_id == "sys_msg":
            widget = system_message_text
            feedback_label = sys_msg_feedback_label
            if widget and widget.winfo_exists(): text = widget.get("1.0", tk.END)

        if not widget or not widget.winfo_exists() or not feedback_label or not feedback_label.winfo_exists():
            # print(f"Feedback widget or label missing for {widget_id}") # Debug
            return # Stop if widgets are gone

        # Run analysis based on widget ID
        feedback_message, feedback_style = "", "FeedbackInfo.TLabel" # Defaults
        if widget_id == "topic":
            feedback_message, feedback_style = analyze_topic_input(text)
        elif widget_id == "context":
            feedback_message, feedback_style = analyze_context_input(text)
        elif widget_id == "sys_msg":
            feedback_message, feedback_style = analyze_system_message_input(text)

        # Update the feedback label
        feedback_label.config(text=feedback_message, style=feedback_style)

    except tk.TclError as e:
        # print(f"TclError during feedback analysis for {widget_id}: {e}") # Debug
        pass # Ignore if widgets are destroyed during processing
    except NameError as e:
         print(f"NameError in run_feedback_analysis (widget variable might be missing?): {e}")
         traceback.print_exc()
    except Exception as e:
        print(f"Error running feedback analysis for {widget_id}: {e}")
        traceback.print_exc()
        if feedback_label and feedback_label.winfo_exists():
            feedback_label.config(text="Error checking input!", style="FeedbackError.TLabel")


def analyze_topic_input(text):
    """Analyzes the custom SOP topic input."""
    text = text.strip()
    if not text:
        return "Please enter a specific topic for the SOP.", "FeedbackWarn.TLabel"
    if len(text) < 5:
        return "Topic seems very short. Is it specific enough?", "FeedbackWarn.TLabel"
    # Add more checks if needed (e.g., very generic terms)
    return "Topic looks reasonable.", "FeedbackInfo.TLabel" # Default positive feedback


def analyze_context_input(text):
    """Analyzes the additional context input."""
    text = text.strip()
    lines = len(text.splitlines())
    word_count = len(text.split())

    if word_count == 0:
        return "Tip: Add specific steps, resources, or constraints.", "FeedbackInfo.TLabel"
    if word_count < 10:
        return "Consider adding more detail for better results.", "FeedbackWarn.TLabel"
    if "[insert" in text.lower() or "[tbd]" in text.lower() or "[placeholder]" in text.lower():
        return "Warning: Found placeholder text like '[insert...]'. Fill these in?", "FeedbackError.TLabel"
    if len(text) > 2000: # Arbitrary limit, adjust as needed
        return "Context is quite long. Ensure it's focused. (May increase cost/latency)", "FeedbackWarn.TLabel"

    # Check for action verbs or specific instructions
    action_verbs = ["include", "ensure", "focus on", "steps are", "use", "list", "avoid", "specify"]
    if any(verb in text.lower() for verb in action_verbs):
        return "Context seems informative.", "FeedbackInfo.TLabel"
    else:
        return "Is the context specific enough? Consider adding details.", "FeedbackWarn.TLabel"

def analyze_system_message_input(text):
    """Analyzes the system message input."""
    text = text.strip()
    warnings = []
    errors = []

    # Critical checks
    if "{ROLE_DESCRIPTION}" not in text:
        errors.append("Missing critical placeholder: {ROLE_DESCRIPTION}")
    if "{TARGET_AUDIENCE}" not in text:
        errors.append("Missing critical placeholder: {TARGET_AUDIENCE}")
    if "Internal Chain-of-Thought Process" not in text:
        warnings.append("Chain-of-Thought instructions may be missing or modified.")
    if "DO NOT include this reasoning" not in text:
        warnings.append("Instruction to hide CoT reasoning might be missing.")
    if "Start the output directly" not in text and "## Purpose" not in text: # Check for key output instruction
         warnings.append("Guideline #8 (start output directly) might be missing/altered.")

    # Length checks
    if len(text) < 300:
        warnings.append("System message seems short. Ensure all necessary guidelines are present.")
    if len(text) > 4000: # Very long prompt might cause issues
        warnings.append("System message is very long. Consider brevity. (May increase cost/latency)")

    # Construct feedback message
    if errors:
        return f"Errors: {'; '.join(errors)}", "FeedbackError.TLabel"
    elif warnings:
        return f"Warnings: {'; '.join(warnings)}", "FeedbackWarn.TLabel"
    else:
        return "System message structure looks OK.", "FeedbackInfo.TLabel"


