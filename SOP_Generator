    report_lines.append(f"SOP Topic: {current_topic if current_topic else 'N/A'}")
    report_lines.append(f"Compared Model 1: '{m1_name}'")
    report_lines.append(f"Compared Model 2: '{m2_name}'")
    report_lines.append(nl) # Add initial space

    # --- Quick Summary ---
    report_lines.extend(create_title_header("Quick Summary", separator_char, separator_width))
    report_lines.append(nl) # Space after header
    try:
        matched_count = results_data.get('matched_sections', 0)
