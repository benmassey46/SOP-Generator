def load_wmd_model_once(status_callback=None, window_ref=None, progress_callback=None):
    """Loads the WMD model in the background if available and not already loaded/loading."""
    global wmd_model, wmd_model_loading, wmd_model_loaded, initial_loads_pending
    # Check dependencies first
    if not GENSIM_AVAILABLE or not POT_AVAILABLE:
        if progress_callback: progress_callback(False, 100, model_type="WMD") # Indicate completion even if skipped
        return

    with wmd_model_lock:
        if wmd_model is None and not wmd_model_loading:
            wmd_model_loading = True
            model_filename = os.path.basename(WMD_MODEL_PATH) if WMD_MODEL_PATH else "Not Specified"
            msg = f"Status: Loading WMD model from '{model_filename}' (this takes time)..."
            print(msg)
            if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            if progress_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: progress_callback(True, 0, model_type="WMD")) # Start progress

            try:
                if not WMD_MODEL_PATH or not os.path.exists(WMD_MODEL_PATH):
                     raise FileNotFoundError(f"WMD model file not found or path not set: {WMD_MODEL_PATH}")
                print(f"Attempting to load WMD model from: {WMD_MODEL_PATH}")
                start_time = time.time()
                wmd_model = gensim.models.KeyedVectors.load_word2vec_format(WMD_MODEL_PATH, binary=True)
                load_time = time.time() - start_time
                wmd_model_loaded = True
                msg = f"Status: WMD model loaded ({load_time:.2f}s)."
                print(msg);
                if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            except FileNotFoundError as e:
                 error_msg = f"Error: WMD model file not found.\nPath: {WMD_MODEL_PATH}\nPlease check the path/env variable.\nWMD unavailable."
                 print(error_msg); wmd_model, wmd_model_loaded = None, False; msg = "Status: Error loading WMD model (File Not Found)!"
                 if 'root' in globals() and root and root.winfo_exists(): root.after(0, lambda: messagebox.showerror("Model Load Error", error_msg, parent=root))
                 if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            except Exception as e:
                 error_msg = f"Failed to load WMD model:\n{e}\nWMD unavailable."
                 print(f"Error loading WMD model: {e}"); traceback.print_exc()
                 wmd_model, wmd_model_loaded = None, False; msg = "Status: Error loading WMD model!"
                 if 'root' in globals() and root and root.winfo_exists(): root.after(0, lambda: messagebox.showerror("Model Load Error", error_msg, parent=root))
                 if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            finally:
                wmd_model_loading = False
                # Notify progress completion (success or failure)
                if progress_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: progress_callback(False, 100, model_type="WMD"))
        elif wmd_model_loading:
             print("Waiting for WMD model lock..."); # Already loading, do nothing else
        else: # Already loaded or failed previously
            if progress_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: progress_callback(False, 100, model_type="WMD"))


def load_st_model_once(status_callback=None, window_ref=None, progress_callback=None):
    """Loads the default Sentence Transformer model in the background."""
    global st_model, st_model_loading, st_model_loaded, initial_loads_pending
    with st_model_lock:
        if st_model is None and not st_model_loading:
            st_model_loading = True
            msg = "Status: Loading DEFAULT ST model (all-MiniLM-L6-v2)..."
            print(msg)
            if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            if progress_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: progress_callback(True, 0, model_type="ST_Default"))

            try:
                start_time = time.time()
                st_model = SentenceTransformer('all-MiniLM-L6-v2')
                load_time = time.time() - start_time
                st_model_loaded = True
                msg = f"Status: Default ST model loaded ({load_time:.2f}s)."
                print(msg) # Print success message
                if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            except Exception as e:
                 error_msg = f"Failed to load DEFAULT ST model:\n{e}\nComparison quality may be reduced."
                 print(f"Error loading DEFAULT ST model: {e}"); traceback.print_exc()
                 st_model, st_model_loaded = None, False; msg = "Status: Error loading DEFAULT ST model!"
                 if 'root' in globals() and root and root.winfo_exists(): root.after(0, lambda: messagebox.showerror("Model Load Error", error_msg, parent=root))
                 if status_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: status_callback(msg))
            finally:
                st_model_loading = False
                if progress_callback and window_ref and window_ref.winfo_exists(): window_ref.after(0, lambda: progress_callback(False, 100, model_type="ST_Default"))
        elif st_model_loading:
