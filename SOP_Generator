    if not openai_client: raise ValueError("OpenAI client not initialized.")
    if not text or not text.strip(): return None # Handle empty/whitespace text

    try:
        # OpenAI recommends replacing newlines with spaces for their embedding models
        text_processed = text.replace("\n", " ")
        # ada-002 has a limit of 8191 tokens. Truncation is needed for longer texts.
        # Direct token counting is complex; use character limit as proxy (1 token ~ 4 chars).
        # Be conservative to avoid exceeding the limit.
        max_tokens = 8191
        max_chars = max_tokens * 3 # Approx 24k chars
        if len(text_processed) > max_chars:
            print(f"Warning: Truncating text for OpenAI embedding (>{max_chars} chars)")
            text_processed = text_processed[:max_chars]

        # API expects a list of inputs, even if just one
        response = openai_client.embeddings.create(input=[text_processed], model="text-embedding-ada-002")
        # Return the embedding vector for the first (and only) input
