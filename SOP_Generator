def cosine_similarity(v1, v2):
    """Calculates cosine similarity between two vectors, handling None and zero vectors."""
    if v1 is None or v2 is None:
        return 0.0 # Treat None input as no similarity

    # Ensure inputs are numpy arrays of appropriate type
    v1 = np.asarray(v1, dtype=np.float32)
    v2 = np.asarray(v2, dtype=np.float32)

    # Check for empty vectors (e.g., from encoding empty strings)
    if v1.size == 0 or v2.size == 0:
        return 0.0

    # Calculate norms
    norm_v1 = np.linalg.norm(v1)
    norm_v2 = np.linalg.norm(v2)

    # Handle zero vectors (vectors with zero magnitude)
    if norm_v1 == 0 or norm_v2 == 0:
        return 0.0 # Or 1.0 if both are zero? Conventionally 0.0 for similarity.

    # Calculate cosine similarity
    # Ensure dot product is calculated correctly for 1D arrays
    dot_product = np.dot(v1, v2)
    similarity = dot_product / (norm_v1 * norm_v2)

    # Clip result to [0.0, 1.0] range due to potential floating-point inaccuracies
    # Especially relevant since we use normalize_embeddings=True for ST
    return np.clip(similarity, 0.0, 1.0)


def jaccard_similarity(text1, text2):
    """Calculates Jaccard similarity between the sets of unique words in two texts."""
    if not text1 or not text2:
        return 0.0 # No overlap if one is empty

    try:
        # Tokenize using NLTK if available, otherwise basic split
        if NLTK_AVAILABLE:
             tokens1 = word_tokenize(text1.lower())
             tokens2 = word_tokenize(text2.lower())
        else: # Fallback
             tokens1 = text1.lower().split()
             tokens2 = text2.lower().split()

        # Create sets of unique *alphanumeric* words
        words_text1 = set(word for word in tokens1 if word.isalnum())
        words_text2 = set(word for word in tokens2 if word.isalnum())

        # Calculate intersection and union
        intersection = words_text1.intersection(words_text2)
        union = words_text1.union(words_text2)

        # Handle division by zero: if union is empty, it means both sets were empty.
        if not union:
            # If intersection is also empty, similarity is 1 (empty set compared to empty set)
            # This case is unlikely if input texts weren't empty, but handles edge case.
            return 1.0
        else:
            return len(intersection) / len(union)

    except Exception as e:
        print(f"Error during Jaccard calculation: {e}. Returning 0.0")
        # Fallback to basic split within the exception handler if needed, but simpler to return 0
        return 0.0


def word_movers_distance(text1, text2):
    """Calculates Word Mover's Distance between two texts using a loaded Gensim model."""
    # Check dependencies and model state
    if not GENSIM_AVAILABLE or not POT_AVAILABLE:
        raise ModuleNotFoundError("WMD requires 'gensim' and 'POT' libraries.")
    if not wmd_model_loaded or wmd_model is None:
        raise ValueError("WMD model is not loaded.")

    # Handle empty inputs: Treat as infinitely distant
    if not text1 or not text2:
        return float('inf')

    # Preprocess texts: lowercase, remove punctuation, tokenize, remove stopwords
    words1 = preprocess_text_wmd(text1)
    words2 = preprocess_text_wmd(text2)

    # Handle cases where preprocessing results in empty lists (e.g., only stopwords)
    if not words1 or not words2:
        return float('inf')

    try:
        # Filter words to only include those present in the WMD model's vocabulary *before* calculating distance
        # This prevents errors if the model doesn't contain certain words.
        words1_in_vocab = [word for word in words1 if word in wmd_model.key_to_index]
        words2_in_vocab = [word for word in words2 if word in wmd_model.key_to_index]

        # If filtering leaves either list empty, meaningful comparison isn't possible
        if not words1_in_vocab or not words2_in_vocab:
            # print("WMD Warning: No overlapping vocabulary found after filtering for WMD calculation.")
            return float('inf') # Indicate inability to compare

        # Calculate WMD using the filtered lists of words in vocabulary
        distance = wmd_model.wmdistance(words1_in_vocab, words2_in_vocab)

        # Gensim might return inf; ensure we return it correctly
        return float('inf') if distance == float('inf') else distance

    except Exception as e:
        print(f"Error calculating WMD: {e}")
        traceback.print_exc() # Provide more detail for debugging WMD issues
        return float('inf') # Return infinity on error


def calculate_bertscore(text1, text2):
    """Calculates BERTScore (P, R, F1) between two texts."""
    if not BERTSCORE_AVAILABLE:
        raise ModuleNotFoundError("BERTScore library not available ('bert_score').")
    if not text1 or not text2:
        return (None, None, None) # Return tuple of Nones for consistency

    try:
        # Determine device (use GPU if available and torch found)
        device = 'cuda' if TORCH_AVAILABLE and torch.cuda.is_available() else 'cpu'
        # print(f"BERTScore using device: {device}") # Optional debug info

        # --- Truncation ---
        # BERT-based models have token limits (often 512).
        # Simple word count truncation as an approximation. Use NLTK tokenizer if available.
        max_bert_words = 400 # Be conservative with word count limit
        if NLTK_AVAILABLE:
            tokens1 = word_tokenize(text1)
            tokens2 = word_tokenize(text2)
        else:
            tokens1 = text1.split()
            tokens2 = text2.split()

        text1_trunc = " ".join(tokens1[:max_bert_words])
        text2_trunc = " ".join(tokens2[:max_bert_words])
        if len(tokens1) > max_bert_words or len(tokens2) > max_bert_words:
             print(f"Warning: Truncated input for BERTScore (>{max_bert_words} words)")

        # bert_score expects lists of candidates and references
        cands = [text1_trunc]
        refs = [text2_trunc]

        # --- Calculate Scores ---
        # Common model: 'bert-base-uncased'. Others possible: 'roberta-large', etc.
        # rescale_with_baseline=True maps scores to be more interpretable (closer to 0-1 range).
        P, R, F1 = bert_score_calc(
            cands, refs,
            lang="en",                # Language
            model_type='bert-base-uncased', # Model identifier
            rescale_with_baseline=True, # Recommended for better interpretation
            device=device,            # Use GPU if available
            verbose=False             # Suppress progress bar from bert_score
        )

        # Extract scalar values from tensors, checking for NaN (Not a Number) results
        p_val = P.item() if P is not None and not torch.isnan(P).any() else None
        r_val = R.item() if R is not None and not torch.isnan(R).any() else None
        f1_val = F1.item() if F1 is not None and not torch.isnan(F1).any() else None

        return (p_val, r_val, f1_val)

    except Exception as e:
        print(f"Error calculating BERTScore: {e}")
        traceback.print_exc() # Full traceback for debugging
        return (None, None, None) # Return Nones on error


def calculate_hybrid_score(jaccard_score, bertscore_f1):
    """Calculates a hybrid similarity score by averaging Jaccard and BERTScore F1."""
    # Check if both input scores are valid numbers
    if jaccard_score is not None and bertscore_f1 is not None:
        try:
            # Convert to float just in case they aren't already
            j_float = float(jaccard_score)
            b_float = float(bertscore_f1)
            # Ensure scores are within expected range if needed (optional)
            # j_float = max(0.0, min(1.0, j_float))
            # b_float = max(0.0, min(1.0, b_float))
            return (j_float + b_float) / 2.0
        except (ValueError, TypeError) as e:
            print(f"Error calculating hybrid score (invalid inputs?): J={jaccard_score}, B={bertscore_f1}. Error: {e}")
            return None # Return None if conversion or calculation fails
    else:
        # If either score is None, hybrid score cannot be calculated
        # print(f"Hybrid score skipped: Jaccard={jaccard_score}, BERTScoreF1={bertscore_f1}") # Optional debug
        return None


