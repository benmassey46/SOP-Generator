def update_status_for_selection():
    """Updates the main status bar based on model loading status and selected model availability."""
    # Ensure status_var exists and is a Tkinter variable
    if 'status_var' not in globals() or not isinstance(status_var, tk.Variable):
        return

    try:
        current_status = status_var.get()
        # List of prefixes indicating an ongoing critical operation
        critical_prefixes = [
            "Status: Generating", "Status: Loading", "Status: Comparing",
            "Status: Parsing", "Status: Processing", "Status: Saving",
            "Status: Initializing", "Status: Preparing", "Status: Starting",
            "Status: Running"
        ]
        # Check if the current status indicates an operation is actively running
        is_critical_status = any(current_status.startswith(prefix) for prefix in critical_prefixes)

        # Only update the status if no critical operation is in progress
        if not is_critical_status:
            base_status = "Status: Ready"
            issues = [] # Collect loading/dependency issues
            warnings = [] # Collect non-blocking issues (like missing optional libs/models)

            # Check core model load status
            if not st_model_loaded: issues.append("Default ST Failed!")
            # Check optional models/libs
            if FINE_TUNED_SBERT_PATH and not st_finetuned_model_loaded: warnings.append("Fine-Tuned ST Failed!")
            if GENSIM_AVAILABLE and POT_AVAILABLE and not wmd_model_loaded: warnings.append("WMD Load Failed!")
            if not BERTSCORE_AVAILABLE: warnings.append("BERTScore Lib Missing!")
            if not NLTK_AVAILABLE: warnings.append("NLTK Lib Missing!")
            elif not english_stopwords: warnings.append("NLTK Stopwords Failed!") # More specific
            if not SPACY_AVAILABLE: warnings.append("spaCy Lib Missing!")
            elif not nlp_spacy: warnings.append("spaCy Model Missing!")

            # Append issues/warnings to base status
            status_parts = [base_status]
            if issues: status_parts.append(f"[Errors: {', '.join(issues)}]")
            if warnings: status_parts.append(f"[Warnings: {', '.join(warnings)}]")
            current_display_status = " ".join(status_parts)


            # Check availability of *selected* models
            selected_models = get_selected_models()
            unavailable_selected_providers = []
            if selected_models: # Only check if models are actually selected
                for model_name in selected_models:
                    if not check_model_availability(model_name):
                        provider = AVAILABLE_MODELS.get(model_name, {}).get("provider", "Unknown")
                        if provider not in unavailable_selected_providers:
                            unavailable_selected_providers.append(provider)

            # Append provider warning if necessary
            if unavailable_selected_providers:
                providers_str = ", ".join(unavailable_selected_providers)
                final_status = f"{current_display_status} - [Selected Unavailable: {providers_str}]"
            else:
                final_status = current_display_status

            # Update status bar only if the message has changed
            if status_var.get() != final_status:
                status_var.set(final_status)

    except tk.TclError as e:
        # Handle cases where the status bar widget might be destroyed
        print(f"Error updating status bar: {e}")
    except Exception as e:
        print(f"Unexpected error in update_status_for_selection: {e}")


