class SelectModelsDialog(simpledialog.Dialog):
    """Custom dialog to select two different models from a list."""
    def __init__(self, parent, title, prompt, model_list):
        self.prompt = prompt # Instruction text for the dialog
        self.model_list = sorted(model_list) # Ensure consistent order
        self.result = None # Stores the tuple of selected models if OK clicked
        super().__init__(parent, title=title)

    def body(self, master):
        """Creates the dialog body (widgets)."""
        # Display the prompt message
        ttk.Label(master, text=self.prompt, wraplength=350, justify=tk.LEFT).grid(
            row=0, column=0, columnspan=2, padx=5, pady=(5, 10), sticky="w")

        # Combobox for Model 1
        ttk.Label(master, text="Model 1:").grid(row=1, column=0, padx=5, pady=5, sticky="w")
        self.combo1_var = tk.StringVar()
        self.combo1 = ttk.Combobox(master, textvariable=self.combo1_var, values=self.model_list, state="readonly", width=30)
        self.combo1.grid(row=1, column=1, padx=5, pady=5, sticky="ew")
        if self.model_list: self.combo1.current(0) # Pre-select first item

        # Combobox for Model 2
        ttk.Label(master, text="Model 2:").grid(row=2, column=0, padx=5, pady=5, sticky="w")
        self.combo2_var = tk.StringVar()
        self.combo2 = ttk.Combobox(master, textvariable=self.combo2_var, values=self.model_list, state="readonly", width=30)
        self.combo2.grid(row=2, column=1, padx=5, pady=5, sticky="ew")
        if len(self.model_list) > 1: self.combo2.current(1) # Pre-select second item if available

        # Allow the combobox column to expand
        master.grid_columnconfigure(1, weight=1)
        return self.combo1 # Set initial focus to the first combobox

    def validate(self):
        """Validates the selection before closing the dialog."""
        m1 = self.combo1_var.get()
        m2 = self.combo2_var.get()
        if not m1 or not m2:
             messagebox.showwarning("Selection Error", "Please select two models from the dropdown lists.", parent=self)
             return 0 # Keep dialog open
        if m1 == m2:
             messagebox.showwarning("Selection Error", "Please select two *different* models for comparison.", parent=self)
             return 0 # Keep dialog open
        return 1 # Validation successful, allow dialog to close

    def apply(self):
        """Stores the selected pair when the OK button is pressed."""
        self.result = (self.combo1_var.get(), self.combo2_var.get())


