def convert_markdown_to_pdf(markdown_content, output_filename, title="SOP Document", preformatted=False):
    """
    Converts Markdown text (or preformatted text) to a styled PDF file.
    Args: ... (args remain the same) ...
    Returns: ... (returns remain the same) ...
    """
    if not PDF_GENERATION_POSSIBLE:
        print("Error: Cannot generate PDF, required libraries (markdown2, xhtml2pdf) are missing.")
        return False

    try:
        # --- Simplified CSS (No @frame) ---
        css = """
        @page {
            size: a4 portrait;
            margin: 1.5cm; /* Consistent margins */
        }
        body { font-family: "Helvetica", "Arial", sans-serif; font-size: 11pt; line-height: 1.4; color: #333; }
        h1, h2, h3, h4, h5, h6 { font-family: "Helvetica", "Arial", sans-serif; font-weight: bold; margin-top: 1.2em; margin-bottom: 0.6em; line-height: 1.2; color: #000; }
        h1 { font-size: 18pt; } h2 { font-size: 16pt; border-bottom: 1px solid #eee; padding-bottom: 0.2em; } h3 { font-size: 14pt; } h4 { font-size: 12pt; }
        p { margin-top: 0.5em; margin-bottom: 0.8em; text-align: justify; }
        ul, ol { margin-top: 0.5em; margin-bottom: 0.8em; padding-left: 1.5em; } li { margin-bottom: 0.3em; }
        ul { list-style-type: disc; } ol { list-style-type: decimal; }
        ul ul, ol ul { list-style-type: circle; margin-top: 0.2em; margin-bottom: 0.2em;}
        ul ol, ol ol { list-style-type: lower-alpha; margin-top: 0.2em; margin-bottom: 0.2em;}
        pre { font-family: "Courier New", monospace; font-size: 9pt; background-color: #f8f8f8; border: 1px solid #ddd; padding: 10px; white-space: pre-wrap; word-wrap: break-word; margin-top: 1em; margin-bottom: 1em; overflow-x: auto; display: block; }
        code { font-family: "Courier New", monospace; font-size: 9pt; background-color: #f0f0f0; padding: 0.1em 0.3em; border-radius: 3px; }
        strong, b { font-weight: bold; } em, i { font-style: italic; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
        th { background-color: #f2f2f2; font-weight: bold; }
        """

        # --- Prepare HTML ---
        if preformatted:
            # Wrap plain text content in <pre> for reports
            # Ensure the content itself is escaped before putting in <pre>
            escaped_content = escape(markdown_content)
            html_content = f"""
            <html><head><title>{title}</title><style>{css}</style></head>
            <body><pre>{escaped_content}</pre></body></html>
            """
        else:
            # Convert Markdown to HTML
            html_body = markdown2.markdown(
                markdown_content,
                extras=["tables", "fenced-code-blocks", "strike", "markdown-in-html", "cuddled-lists", "footnotes"]
            )
            html_content = f"""
            <html><head><title>{title}</title><style>{css}</style></head>
            <body>{html_body}</body></html>
            """

        # --- Generate PDF ---
        with open(output_filename, "wb") as output_file:
            pisa_status = pisa.CreatePDF(
                src=html_content.encode('utf-8'),
                dest=output_file,
                encoding='utf-8'
            )

        # --- Check Result ---
        if pisa_status.err:
            print(f"Error generating PDF '{os.path.basename(output_filename)}': {pisa_status.err}")
            # Log the exception details if available
            if pisa_status.exc_info:
                try:
                    exc_type, exc_value, exc_traceback = pisa_status.exc_info
                    print("--- xhtml2pdf Exception Traceback ---")
                    traceback.print_exception(exc_type, exc_value, exc_traceback)
                    print("------------------------------------")
                except Exception as log_e:
                     print(f"Error logging pisa exception details: {log_e}")
            return False
        else:
            print(f"Successfully generated PDF: {os.path.basename(output_filename)}")
            return True

    except ImportError as e:
        print(f"PDF Generation Import Error: {e}. Make sure markdown2 and xhtml2pdf are installed.")
        return False
    except Exception as e:
        print(f"Error during PDF conversion for '{os.path.basename(output_filename)}': {e}")
        traceback.print_exc()
        return False    

