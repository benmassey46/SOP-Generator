def insert_text_safely(widget, text, replace=False):
    """Safely inserts or replaces text in a ScrolledText widget on the main GUI thread."""
    try:
        if widget and widget.winfo_exists():
            original_state = widget.cget('state')
            # Ensure widget is writable before modification
            if original_state == tk.DISABLED:
                widget.config(state=tk.NORMAL)

            if replace:
                widget.delete("1.0", tk.END)
                widget.insert("1.0", text)
            else:
                widget.insert(tk.END, text) # Append

            widget.see(tk.END) # Scroll to the end to show the latest text

            # Restore original state if it was disabled
            if original_state == tk.DISABLED:
                widget.config(state=tk.DISABLED)
    except tk.TclError as e:
        # Ignore errors if widget is destroyed during the update process
        # print(f"TclError inserting text safely: {e}") # Optional debug
        pass
    except Exception as e:
        # Catch other unexpected errors during widget manipulation
        print(f"Unexpected error updating widget text: {e}")
        traceback.print_exc()


def update_generation_controls_state(generating: bool):
    """Enables/disables main control buttons based on generation state and output availability."""
    new_main_state = tk.DISABLED if generating else tk.NORMAL
    # Comparison buttons depend on having >= 2 valid outputs AND not currently generating
    can_compare = len(last_generated_models) >= 2 and not generating
    # Save/Copy buttons depend on having >= 1 valid output AND not currently generating
    has_output = bool(last_generated_models) and not generating
    # <<<--- NEW: Determine Review Button State --- >>>
    can_review = False
    active_widget = get_active_output_widget() # Check if a valid tab is selected
    review_window_open = bool(review_window and review_window.winfo_exists())
    if active_widget and has_output and not review_window_open: # Enable if output exists, not generating, no review window open
         can_review = True
    # <<<--- END NEW --- >>>

    # Helper to safely configure widget state, checking existence first
    def config_state(widget_name, state): # Modified to take widget name string
        # Use globals().get for safer access
        widget_ref = globals().get(widget_name)
        if widget_ref and widget_ref.winfo_exists():
            try: widget_ref.config(state=state)
            except tk.TclError: pass # Ignore if widget destroyed

    # Configure button states using widget names (as strings)
    config_state("generate_button", new_main_state)
    config_state("copy_button", tk.NORMAL if has_output else tk.DISABLED)
    config_state("save_button", tk.NORMAL if has_output else tk.DISABLED)
    config_state("save_all_button", tk.NORMAL if has_output else tk.DISABLED)
    config_state("compare_button", tk.NORMAL if can_compare else tk.DISABLED) # Advanced Compare
    config_state("fine_grained_compare_button", tk.NORMAL if can_compare else tk.DISABLED) # Fine-Grained Compare
    # <<<--- NEW: Configure Review Button --- >>>
    config_state("review_sop_button", tk.NORMAL if can_review else tk.DISABLED)
    # <<<--- END NEW --- >>>

    # Update menu states as well, reflecting button states
    update_menu_states()


def update_ui_after_all_generations_done():
    """Called on the main thread after all generation threads have finished."""
    global last_generated_models, structure_widgets # Added structure_widgets
    if not root or not root.winfo_exists(): return # Exit if main window is gone

    valid_models_generated = []
    any_errors_encountered = False
    any_success_achieved = False
    struct_nb = globals().get('structure_notebook') # Get structure notebook

    # --- Verify generated content and identify successes/failures ---
    if 'output_widgets' in globals() and isinstance(output_widgets, dict):
        sorted_model_names = sorted(output_widgets.keys())

        for model_name in sorted_model_names:
            widget = output_widgets.get(model_name)
            structure_tree = structure_widgets.get(model_name) # Get corresponding tree
            struct_tab_id = None
            # Find the structure tab ID for this model
            if struct_nb:
                try:
                    for i, tab_id in enumerate(struct_nb.tabs()):
                         tab_info = struct_nb.tab(tab_id) # Get tab info dict
                         if tab_info and tab_info.get("text") == model_name: # Safer check
                              struct_tab_id = tab_id
                              break
                except tk.TclError: pass

            is_valid_output = False
            if widget and widget.winfo_exists():
                try:
                    # Make widget readable temporarily to get content
                    original_state = widget.cget('state')
                    widget.config(state=tk.NORMAL)
                    content = widget.get("1.0", tk.END).strip()
                    widget.config(state=original_state) # Restore state

                    # Define markers indicating failure or incomplete generation
                    error_markers = [
                        "--- ERROR", "--- BLOCKED", "--- STOPPED",
                        "--- GENERATION ENDED (", # Parenthesis to catch reasons like MAX_TOKENS etc.
                        "Unknown model type",
                        "API not configured",
                        "client not initialized",
                        "API Overloaded" # Added check for overload message
                    ]
                    contains_error = any(marker in content for marker in error_markers)

                    # Check for success: must have content AND no errors
                    if content and not contains_error:
                        # Check for completion marker as extra validation
                        if "[End Generation -" in content:
                           is_valid_output = True
                           any_success_achieved = True
                        else:
                           is_valid_output = True
                           any_success_achieved = True
                           print(f"Warning: Output for {model_name} seems valid but lacks completion marker.")

                        # <<<--- NEW: Populate Structure Tree on Success --- >>>
                        if structure_tree and structure_tree.winfo_exists():
                             populate_structure_tree(structure_tree, content)
                             # Unhide the corresponding structure tab
                             if struct_nb and struct_tab_id:
                                  try: struct_nb.tab(struct_tab_id, state='normal')
                                  except tk.TclError: pass
                        # <<<--- END NEW --- >>>

                    elif contains_error:
                        any_errors_encountered = True
                        # Optionally hide structure tab on error
                        if struct_nb and struct_tab_id:
                            try: struct_nb.tab(struct_tab_id, state='hidden')
                            except tk.TclError: pass
                    elif not content:
                         any_errors_encountered = True
                         print(f"Note: Output for {model_name} was empty.")
                         # Optionally hide structure tab on empty
                         if struct_nb and struct_tab_id:
                            try: struct_nb.tab(struct_tab_id, state='hidden')
                            except tk.TclError: pass

                except tk.TclError:
                    print(f"Error accessing widget content for {model_name} during final check.")
                    any_errors_encountered = True
                except Exception as e:
                    print(f"Unexpected error checking final widget content for {model_name}: {e}")
                    any_errors_encountered = True
            else:
                 any_errors_encountered = True
                 print(f"Widget for model {model_name} not found during final check.")

            if is_valid_output:
                 valid_models_generated.append(model_name)

    # Update the global list with only the models that produced valid output
    last_generated_models = valid_models_generated

    # --- Handle Placeholder Tabs ---
    # Output Placeholder
    if not any_success_achieved and output_notebook and output_notebook.winfo_exists():
         create_placeholder_tab() # Handles output notebook placeholder
         # Try select it
         try:
             for i, tab_id in enumerate(output_notebook.tabs()):
                  if output_notebook.tab(tab_id, "text") == "Outputs":
                       output_notebook.select(i); break
         except tk.TclError: pass

    # Structure Placeholder (Select if no structure tabs are visible)
    if struct_nb and struct_nb.winfo_exists():
        any_structure_visible = False
        try:
            for tab_id in struct_nb.tabs():
                 tab_info = struct_nb.tab(tab_id)
                 if tab_info and tab_info.get("text") != "Structure" and tab_info.get("state") == 'normal':
                      any_structure_visible = True
                      break
            if not any_structure_visible:
                 # Select the main "Structure" placeholder tab
                 for i, tab_id in enumerate(struct_nb.tabs()):
                     tab_info = struct_nb.tab(tab_id)
                     if tab_info and tab_info.get("text") == "Structure":
                         struct_nb.select(i); break
        except tk.TclError as e:
            print(f"Error managing structure placeholder selection: {e}")

    # --- Update Controls and Status ---
    update_generation_controls_state(generating=False)

    # Set final status message
    final_status = "Status: Idle."
    if any_success_achieved and any_errors_encountered:
        final_status = f"Status: Generation complete. {len(last_generated_models)} successful, errors/blocks/overloads on others."
    elif any_success_achieved:
        final_status = f"Status: Generation complete. ({len(last_generated_models)} successful)."
    elif any_errors_encountered:
        final_status = "Status: Generation finished, but all selected models failed, were blocked, or API was overloaded."
    elif not output_widgets:
        final_status = "Status: Generation attempt failed. No outputs were produced."

    if status_var:
        try:
            status_var.set(final_status)
            root.after(100, update_status_for_selection)
        except tk.TclError: pass

    update_menu_states()


def create_placeholder_tab():
    """Creates or recreates the placeholder 'Outputs' tab in the output notebook."""
    global placeholder_frame
    if not output_notebook or not output_notebook.winfo_exists():
        print("Cannot create placeholder tab: Output notebook invalid.")
        return

    placeholder_exists = False
    placeholder_index = -1

    # Check for and Remove Existing Placeholder
    try:
        tab_ids = list(output_notebook.tabs())
        for i, tab_id in enumerate(tab_ids):
             try:
                 if output_notebook.tab(tab_id, "text") == "Outputs":
                      placeholder_exists = True
                      placeholder_index = i
                      break
             except tk.TclError: continue

        if placeholder_exists and placeholder_index != -1:
             current_tabs = output_notebook.tabs()
             if placeholder_index < len(current_tabs):
                  output_notebook.forget(placeholder_index)
             if placeholder_frame and placeholder_frame.winfo_exists():
                  placeholder_frame.destroy()
             placeholder_frame = None
    except tk.TclError as e:
         print(f"Error removing existing placeholder tab: {e}")

    # Create New Placeholder Frame and Label only if no other *real* tabs exist
    has_real_tabs = False
    if output_notebook.tabs():
        for tab_id in output_notebook.tabs():
            try:
                if output_notebook.tab(tab_id, "text") != "Outputs":
                    has_real_tabs = True
                    break
            except tk.TclError: continue

    if not has_real_tabs:
        try:
            placeholder_frame = ttk.Frame(output_notebook, padding=20)
            placeholder_label = ttk.Label(
                placeholder_frame,
                text="Generated SOP outputs will appear here in separate tabs.\nSelect models and enter a topic to begin.",
                style="Header.TLabel", anchor="center", justify=tk.CENTER, wraplength=400
            )
            placeholder_label.pack(expand=True, padx=10, pady=10)
            output_notebook.add(placeholder_frame, text="Outputs", sticky="nsew")
        except tk.TclError as e:
             print(f"Error creating or adding new placeholder tab: {e}")
             if placeholder_frame and placeholder_frame.winfo_exists():
                  placeholder_frame.destroy()
             placeholder_frame = None

