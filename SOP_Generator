def update_menu_states():
    """Updates the enabled/disabled state of menu items based on application context."""
    if not main_menu or not root or not root.winfo_exists(): return # Ensure menu and root exist

    try:
        # === STEP 1: Calculate ALL state variables based on globals ===
        # Ensure these global lookups happen first
        is_generating = active_generation_thread_count > 0
        current_last_generated_models = last_generated_models # Use a temp var for clarity

        # Calculate the boolean flags sequentially
        has_output = bool(current_last_generated_models) and not is_generating
        can_compare = len(current_last_generated_models) >= 2 and not is_generating
        adv_report_ready = bool(comparison_results_cache and 'error' not in comparison_results_cache)
        fg_report_ready = bool(fine_grained_results_cache and 'error' not in fine_grained_results_cache)
        adv_window_open = bool(comparison_window and comparison_window.winfo_exists())
        fg_window_open = bool(fine_grained_comparison_window and fine_grained_comparison_window.winfo_exists())
        review_window_open = bool(review_window and review_window.winfo_exists())
        active_widget = get_active_output_widget()

        # Now calculate can_review_menu using the flags calculated above
        can_review_menu = bool(active_widget and has_output and not is_generating and not review_window_open)

        # === STEP 2: Define helper (local scope) ===
        def set_menu_state(menu, label_or_index, state):
            if menu and menu.winfo_exists():
                try: menu.entryconfig(label_or_index, state=state)
                except tk.TclError: pass

        # === STEP 3: Apply states using calculated variables ===
        # --- File Menu States ---
        set_menu_state(file_menu, "Save Current Output Tab...", tk.NORMAL if has_output else tk.DISABLED)
