from html import escape # Ensure escape is imported at the top level

def _generate_html_fg_report(m1_name, m2_name, results_data):
    """Generates an HTML string fragment for the fine-grained report with CSS classes."""
    html_parts = [] # List to hold HTML strings
    nl = "<br>\n" # Use HTML line break

    # <<<--- DEFINE NESTED HELPER FUNCTION HERE --- >>>
    def add_html(text, class_name, element="span", add_br=True):
        """Helper to wrap text in an HTML tag with a class and escape content."""
        tag = "div" if element.lower() == "div" else "span"
        # Ensure text is string before escaping, handle None gracefully
        escaped_text = escape(str(text) if text is not None else "")
        html_parts.append(f'<{tag} class="{class_name}">{escaped_text}</{tag}>' + (nl if add_br else ""))
    # <<<--- END HELPER FUNCTION DEFINITION --- >>>

    # --- Helper function for scores ---
    def get_score_class(score, is_distance=False):
        if score is None or score == "N/A": return "fg_score_na"
        try:
            score_f = float(score)
            if is_distance:
                if score_f == float('inf'): return "fg_score_na"
                if score_f < 0.75: return "fg_score_good"
                if score_f < 1.75: return "fg_score_medium"
                return "fg_score_low"
            else:
                if score_f >= 0.75: return "fg_score_good"
                if score_f >= 0.50: return "fg_score_medium"
                return "fg_score_low"
        except (ValueError, TypeError):
            return "fg_score_na"

    # --- Helper to format score values ---
    def fmt(score, precision=4, is_distance=False):
        if score is None: return "N/A"
        if is_distance and score == float('inf'): return "Inf/Error"
        try: return f"{float(score):.{precision}f}"
        except (ValueError, TypeError): return "Invalid"

    # --- Report Header ---
    now = datetime.datetime.now()
    # Now use the nested add_html function
    add_html("Fine-Grained Comparison Report", "fg_header", element="div")
    add_html(f"Generated: {now:%Y-%m-%d %H:%M:%S}", "fg_label")
    current_topic = get_sop_topic()
    add_html(f"SOP Topic: {current_topic if current_topic else 'N/A'}", "fg_label")
    add_html(f"Model 1: '{m1_name}'", "fg_label")
    add_html(f"Model 2: '{m2_name}'", "fg_label")
    add_html("=" * 70, "fg_separator", element="div")

    # --- Quick Summary ---
    add_html("Quick Summary", "fg_subheader", element="div")
    try:
        matched_count = results_data.get('matched_sections', 0)
        unmatched1_keys = results_data.get('unmatched_sections1', [])
        unmatched2_keys = results_data.get('unmatched_sections2', [])
        avg_st = results_data.get('average_st_cosine')
        avg_bs = results_data.get('average_bertscore_f1')
        st_label = results_data.get('st_model_used', 'N/A')
        kt_jac = results_data.get('key_term_jaccard')
        total_sections = matched_count + len(unmatched1_keys) + len(unmatched2_keys)

        summary_line1 = f"Compared {total_sections} sections: {matched_count} matched, {len(unmatched1_keys)} unique to '{m1_name}', {len(unmatched2_keys)} unique to '{m2_name}'."
        add_html(summary_line1, "fg_value", element="div")

        html_parts.append('<div class="fg_summary_line">')
        sim_text = "N/A"
        sim_class = "fg_score_na"
        if avg_st is not None:
             sim_text = f"ST Cosine ({st_label}) = {fmt(avg_st)}"
             sim_class = get_score_class(avg_st)
        elif avg_bs is not None:
             sim_text = f"BERTScore F1 = {fmt(avg_bs)}"
             sim_class = get_score_class(avg_bs)
        html_parts.append(f'<span class="fg_label">Avg Semantic Sim (Matched): </span><span class="{sim_class}">{escape(sim_text)}</span> | ')

        kt_jac_fmt = fmt(kt_jac)
        jac_class = get_score_class(kt_jac)
        html_parts.append(f'<span class="fg_label">Key Term Overlap (Jaccard): </span><span class="{jac_class}">{escape(kt_jac_fmt)}</span>')
        html_parts.append('</div>' + nl)

    except Exception as e_sum:
