def save_advanced_comparison_results(model1_name, model2_name, status_var_widget, window_ref):
    """Saves the results from the advanced comparison cache to a visually styled PDF file."""
    parent_window = window_ref if window_ref and window_ref.winfo_exists() else \
                    (root if 'root' in globals() and root and root.winfo_exists() else None)

    if not PDF_GENERATION_POSSIBLE:
        messagebox.showerror("PDF Library Missing", "Cannot save report as PDF. Please install 'markdown2' and 'xhtml2pdf'.", parent=parent_window)
        return

    if not comparison_results_cache or 'error' in comparison_results_cache:
        messagebox.showerror("Save Error", "No valid comparison results available to save.", parent=parent_window)
        return

    m1 = comparison_results_cache.get('model1_name', model1_name)
    m2 = comparison_results_cache.get('model2_name', model2_name)
    if not m1 or not m2: # Fallback/error
        messagebox.showerror("Save Error", "Could not determine which models were compared. Unable to generate filename.", parent=parent_window)
        return

    topic = get_sop_topic()
    cleaned_topic = clean_filename(topic) if topic else "Untitled_SOP"
    now = datetime.datetime.now()
    now_fmt = now.strftime("%Y-%m-%d %H:%M:%S")
    now_file_fmt = now.strftime("%Y%m%d_%H%M%S")
    clean_m1 = clean_filename(m1); clean_m2 = clean_filename(m2)
    report_title = f"Advanced Comparison: {m1} vs {m2}"
    initial_filename = f"AdvCompare_{cleaned_topic}_{clean_m1}_vs_{clean_m2}_{now_file_fmt}.pdf"

    file_path = filedialog.asksaveasfilename(
        initialfile=initial_filename,
        defaultextension=".pdf",
        filetypes=[("PDF Files", "*.pdf"), ("All Files", "*.*")],
        title="Save Advanced Comparison Report as PDF",
        parent=parent_window
    )

    if file_path:
        if status_var_widget: status_var_widget.set("Status: Generating PDF report...")
        try:
            # --- Generate the report content as MARKDOWN ---
            report_md_lines = []

            # Helper to format score values (local)
            def fmt(score, precision=4, is_distance=False):
                if score is None: return "N/A"
                if is_distance and score == float('inf'): return "Inf / Error"
                try: return f"{float(score):.{precision}f}"
                except (ValueError, TypeError): return "Invalid Data"

            # --- Report Header (Markdown) ---
            report_md_lines.append(f"# {report_title}")
            report_md_lines.append(f"**Generated:** {now_fmt}")
            report_md_lines.append(f"**SOP Topic:** {topic if topic else 'N/A'}")
            report_md_lines.append(f"**Compared Model 1:** `{m1}`")
            report_md_lines.append(f"**Compared Model 2:** `{m2}`")
            report_md_lines.append("\n---\n")

            # --- Quantitative Scores (Markdown List) ---
            report_md_lines.append("## Quantitative Scores")
            st_used = comparison_results_cache.get('st_model_used', 'Unknown')
            report_md_lines.append(f"*   **Jaccard Similarity (Lexical):** {fmt(comparison_results_cache.get('jaccard'))}")
            report_md_lines.append(f"*   **ST Cosine Similarity ({st_used}):** {fmt(comparison_results_cache.get('st_cosine'))}")
            report_md_lines.append(f"*   **OpenAI Cosine Similarity:** {fmt(comparison_results_cache.get('openai_cosine'))}")
            report_md_lines.append(f"*   **Word Mover Distance (Lower=Better):** {fmt(comparison_results_cache.get('wmd_distance'), is_distance=True)}")
            report_md_lines.append(f"*   **BERTScore F1:** {fmt(comparison_results_cache.get('bertscore_f1'))}")
            report_md_lines.append(f"*   **Hybrid (Jaccard + BERTScore F1):** {fmt(comparison_results_cache.get('hybrid_jaccard_bertscore'))}")
            report_md_lines.append("\n---\n")

            # --- Score Explanations (Markdown) ---
            report_md_lines.append("## Score Explanations")

            # <<< FIX: Perform replace *before* the f-string >>>
            jaccard_expl_fmt = JACCARD_EXPLANATION.replace('\n', '\n> ')
            cosine_expl_fmt = COSINE_EXPLANATION.replace('\n', '\n> ')
            wmd_expl_fmt = WMD_EXPLANATION.replace('\n', '\n> ')
            bertscore_expl_fmt = BERTSCORE_EXPLANATION.replace('\n', '\n> ')
            hybrid_expl_fmt = HYBRID_EXPLANATION.replace('\n', '\n> ')
            openai_analysis_expl_fmt = OPENAI_ANALYSIS_EXPLANATION.replace('\n', '\n> ')

            report_md_lines.append(f"### Jaccard Similarity\n> {jaccard_expl_fmt}\n")
            report_md_lines.append(f"### Cosine Similarity (ST / OpenAI)\n> {cosine_expl_fmt}\n")
            report_md_lines.append(f"### Word Mover's Distance (WMD)\n> {wmd_expl_fmt}\n")
            report_md_lines.append(f"### BERTScore\n> {bertscore_expl_fmt}\n")
            report_md_lines.append(f"### Hybrid (Jaccard + BERTScore F1)\n> {hybrid_expl_fmt}\n")
            report_md_lines.append(f"### AI Qualitative Analysis\n> {openai_analysis_expl_fmt}\n")
            # <<< END FIX >>>

            report_md_lines.append("\n---\n")

            # --- AI Qualitative Analysis (Markdown) ---
            report_md_lines.append("## AI Qualitative Analysis (GPT-4o)")
            analysis_content = comparison_results_cache.get('gpt4_analysis', "_Analysis was not run or failed._") # Italicize placeholder
            report_md_lines.append(analysis_content) # Insert the analysis text directly
            report_md_lines.append("\n\n--- End of Report ---")

            # --- Combine Markdown Lines ---
            report_markdown = "\n".join(report_md_lines)

            # --- Convert Markdown to PDF ---
            success = convert_markdown_to_pdf(
                markdown_content=report_markdown,
                output_filename=file_path,
                title=report_title
            )

            if success:
                if status_var_widget: status_var_widget.set(f"Status: Report saved to {os.path.basename(file_path)}")
            else:
                messagebox.showerror("PDF Generation Failed", "Could not generate PDF report file.\nCheck console logs for details.", parent=parent_window)
                if status_var_widget: status_var_widget.set("Status: PDF report generation failed.")

        except Exception as e:
            messagebox.showerror("Save Error", f"Could not save the report file:\n{e}", parent=parent_window)
            if status_var_widget: status_var_widget.set("Status: Report save failed.")
            print(f"Error generating/saving advanced comparison PDF: {e}")
            traceback.print_exc()

