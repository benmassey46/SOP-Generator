def generate_side_by_side_diff(text1, text2, width=80):
    """
    Generates data for a side-by-side diff view using SequenceMatcher.

    Args:
        text1 (str): The first text (original).
        text2 (str): The second text (modified).
        width (int): Approximate total character width for the combined line.

    Returns:
        list: A list of tuples, where each tuple is:
              (formatted_line_string, left_tag, right_tag, left_content_len)
              Tags can be 'added', 'deleted', 'unchanged', or None.
              left_content_len helps with applying tags later.
    """
    lines1 = text1.splitlines() # Don't keep ends for this method
    lines2 = text2.splitlines()
    matcher = difflib.SequenceMatcher(None, lines1, lines2)
    results = []

    # Calculate column width (leave space for separator)
    separator = ' | '
    sep_len = len(separator)
    # Ensure width is somewhat reasonable, prevent negative column widths
    if width < 10: width = 80
    col_width = max(5, (width - sep_len) // 2) # Ensure at least 5 chars per column

    # Helper to format and pad a line
    def format_col(line, max_len):
        line = line[:max_len] # Truncate if too long
        return line.ljust(max_len) # Pad with spaces

    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        lines_left = lines1[i1:i2]
        lines_right = lines2[j1:j2]
        max_len = max(len(lines_left), len(lines_right))

        for i in range(max_len):
            left_line = lines_left[i] if i < len(lines_left) else ""
            right_line = lines_right[i] if i < len(lines_right) else ""

            left_tag = None
            right_tag = None
            left_content = left_line # Store original content before padding
            right_content = right_line

            if tag == 'equal':
                left_tag = 'unchanged'
                right_tag = 'unchanged'
            elif tag == 'delete':
                left_tag = 'deleted'
                right_tag = None # Nothing on the right
                right_content = "" # Explicitly clear right side content
            elif tag == 'insert':
                left_tag = None # Nothing on the left
                right_tag = 'added'
                left_content = "" # Explicitly clear left side content
            elif tag == 'replace':
                left_tag = 'deleted' # Left side shows what was deleted
                right_tag = 'added'   # Right side shows what was added

            formatted_left = format_col(left_content, col_width)
            formatted_right = format_col(right_content, col_width) # Use same width

            combined_line = formatted_left + separator + formatted_right
            # Store original length of left content for tag application
            left_content_len = len(left_content.rstrip()) # Use rstrip to ignore trailing spaces for tagging extent

            results.append((combined_line, left_tag, right_tag, left_content_len))

    return results

def on_comparison_window_close(window_instance):
    """Callback when the advanced comparison window is closed."""
    global comparison_window, comparison_results_cache
    if window_instance and window_instance.winfo_exists():
        try:
            window_instance.grab_release() # Release modal grab first
            window_instance.destroy()
        except tk.TclError as e:
            print(f"Error closing comparison window: {e}")
    # Reset global state associated with this window
    comparison_window = None
    comparison_results_cache = {}
    update_menu_states() # Update main window menu states


def start_tab_comparison(model1_var, model2_var, scores_frame_widget, explanation_widget,
                        gpt_text_widget, status_var_widget, button_widget, progress_widget,
                        save_button_widget, window_ref,
                        diff_widget): # <<<--- NEW: Added diff_widget parameter
    """Initiates the comparison process when the 'Run' button is clicked."""
    global comparison_results_cache
    # Ensure parent window still exists
    if not window_ref or not window_ref.winfo_exists(): return

    m1 = model1_var.get()
    m2 = model2_var.get()

    # --- Validation ---
    if not m1 or not m2:
        messagebox.showerror("Selection Error", "Please select two different outputs to compare.", parent=window_ref)
        return
    if m1 == m2:
        messagebox.showerror("Selection Error", "Cannot compare an output with itself. Please select two *different* outputs.", parent=window_ref)
        return

    # Re-check dependency/model availability before starting
    issues, warnings = [], []
    st_available = st_model_loaded or st_finetuned_model_loaded
    wmd_available = wmd_model_loaded or not (GENSIM_AVAILABLE and POT_AVAILABLE) # Check libs AND model loaded status
    if not st_available: issues.append("ST model(s) not loaded.")
    if GENSIM_AVAILABLE and POT_AVAILABLE and not wmd_available: issues.append("WMD model not loaded.")
    if not BERTSCORE_AVAILABLE: warnings.append("BERTScore lib missing - score skipped.")
    if not openai_client: warnings.append("OpenAI key missing - AI Analysis & OpenAI Cosine skipped.")
    if FINE_TUNED_SBERT_PATH and not st_finetuned_model_loaded and st_model_loaded: warnings.append("Using default ST (Fine-tuned failed).")
    elif FINE_TUNED_SBERT_PATH and not st_finetuned_model_loaded and not st_model_loaded: issues.append("Fine-tuned SBERT specified but no ST models loaded.")

    if issues:
        messagebox.showerror("Model Error", "Cannot run comparison due to missing components:\n- " + "\n- ".join(issues), parent=window_ref)
        return
    if warnings:
        messagebox.showwarning("Metrics Unavailable", "Some metrics will be skipped:\n- " + "\n- ".join(warnings), parent=window_ref)

    # --- Get Text Content ---
    widget1 = output_widgets.get(m1)
    widget2 = output_widgets.get(m2)
    if not widget1 or not widget1.winfo_exists() or not widget2 or not widget2.winfo_exists():
        messagebox.showerror("Widget Error", f"Could not find the text display for '{m1}' or '{m2}'. Has it been closed or changed?", parent=window_ref)
        return

    text1, text2 = "", ""
    try: # Temporarily enable widgets to get their text content
         state1 = widget1.cget('state'); widget1.config(state=tk.NORMAL); text1 = widget1.get("1.0", tk.END).strip(); widget1.config(state=state1)
         state2 = widget2.cget('state'); widget2.config(state=tk.NORMAL); text2 = widget2.get("1.0", tk.END).strip(); widget2.config(state=state2)
    except tk.TclError as e:
         messagebox.showerror("Widget Error", f"Failed to retrieve text from output widgets: {e}", parent=window_ref)
         return
    except Exception as e_get:
        messagebox.showerror("Error", f"Unexpected error getting text content: {e_get}", parent=window_ref)
        return


    if not text1 or not text2:
        # Warn but allow proceeding - comparison functions should handle empty strings
        messagebox.showwarning("Empty Output", f"Warning: One or both selected outputs ('{m1}', '{m2}') appear to be empty. Comparison results may be zero or invalid.", parent=window_ref)

    # --- Reset UI for Comparison Run ---
    comparison_results_cache = {} # Clear previous results
    if button_widget and button_widget.winfo_exists(): button_widget.config(state='disabled')
    if save_button_widget and save_button_widget.winfo_exists(): save_button_widget.config(state='disabled')
    update_menu_states() # Update main menu too

    # Clear previous score display area
    if scores_frame_widget and scores_frame_widget.winfo_exists():
        for child in scores_frame_widget.winfo_children():
            try: child.destroy()
            except tk.TclError: pass

    # Clear/update AI analysis text area
    if gpt_text_widget and gpt_text_widget.winfo_exists():
        try:
            gpt_text_widget.config(state='normal')
            gpt_text_widget.delete('1.0', tk.END)
            gpt_text_widget.insert('1.0', "Running AI analysis (using GPT-4o)... Please wait.") # Placeholder
            gpt_text_widget.config(state='disabled')
        except tk.TclError: pass

    # <<<--- NEW: Clear previous diff view --- >>>
    if diff_widget and diff_widget.winfo_exists():
        try:
            diff_widget.config(state='normal')
            diff_widget.delete('1.0', tk.END)
            diff_widget.insert('1.0', "Calculating differences...") # Placeholder
            diff_widget.config(state='disabled')
        except tk.TclError: pass
    # <<<--- END NEW --- >>>

    # Show and start progress bar (ensure it's placed correctly relative to Run button)
    if progress_widget and progress_widget.winfo_exists():
        try:
             # Assuming progress_widget's parent is 'action_frame' from open_comparison_window
             progress_widget.grid(row=0, column=1, padx=5, sticky="ew") # Place next to button
             progress_widget.start(10) # Start indeterminate animation
        except tk.TclError: pass


    # Update status bar in the comparison window
    if status_var_widget:
        try: status_var_widget.set(f"Status: Comparing '{m1}' vs '{m2}'... Calculating metrics.")
        except tk.TclError: pass

    # --- Start Background Thread for Calculations ---
    threading.Thread(
        target=run_tab_comparison_thread,
        args=(m1, text1, m2, text2, scores_frame_widget, explanation_widget, gpt_text_widget,
              status_var_widget, button_widget, save_button_widget, progress_widget, window_ref,
              diff_widget), # <<<--- NEW: Pass diff_widget to thread --- >>>
        daemon=True
    ).start()


def run_tab_comparison_thread(m1_name, text1, m2_name, text2, scores_frame, explanation_widget, gpt_widget,
                             status_var_wid, button_wid, save_button_wid, progress_wid, window_ref,
                             diff_widget): # Pass diff_widget
    global comparison_results_cache
    comparison_succeeded = False
    results_data = { # Initialize results dict
        'model1_name': m1_name, 'model2_name': m2_name, 'jaccard': None, 'st_cosine': None,
        'st_model_used': 'N/A', 'openai_cosine': None, 'wmd_distance': None,
        'bertscore_p': None, 'bertscore_r': None, 'bertscore_f1': None,
        'hybrid_jaccard_bertscore': None, 'gpt4_analysis': "AI Analysis pending or skipped.",
        # <<<--- NEW: Change diff storage --->>>
        # 'diff_lines': None # Remove this
        'diff_formatted': None # Store formatted diff data
        # <<<--- END NEW --->>>
    }
    errors_encountered = []

    # Helper for thread-safe status updates via root.after
    def update_comp_status(msg):
        if window_ref and window_ref.winfo_exists() and status_var_wid:
            # Use window_ref.after (Toplevel is Tk-like) to schedule the update
            try:
                window_ref.after(0, lambda m=msg: status_var_wid.set(f"Status: {m}") if status_var_wid else None)
            except tk.TclError: # Catch error if window closed between check and after() call
                pass

    try:
        # --- Calculate Metrics (Catch errors for each) ---
        update_comp_status("Calculating Jaccard Similarity...")
        try: results_data['jaccard'] = jaccard_similarity(text1, text2)
        except Exception as e: errors_encountered.append(f"Jaccard Error: {e}"); print(f"Jaccard Error: {e}")

        st_available = st_model_loaded or st_finetuned_model_loaded
        if st_available:
            model_label = "Fine-Tuned" if FINE_TUNED_SBERT_PATH and st_finetuned_model_loaded else "Default"
            results_data['st_model_used'] = model_label
            update_comp_status(f"Calculating ST Cosine ({model_label})...")
            try:
                use_ft = bool(FINE_TUNED_SBERT_PATH and st_finetuned_model_loaded)
                st_emb1 = get_st_embedding(text1, use_fine_tuned_if_available=use_ft)
                st_emb2 = get_st_embedding(text2, use_fine_tuned_if_available=use_ft)
                results_data['st_cosine'] = cosine_similarity(st_emb1, st_emb2)
            except Exception as e: errors_encountered.append(f"ST Cosine ({model_label}) Error: {e}"); print(f"ST Cosine Error ({model_label}): {e}"); results_data['st_model_used'] = "Error"
        else: results_data['st_model_used'] = "Unavailable"; update_comp_status("Skipping ST Cosine (model unavailable).")

        if openai_client:
            update_comp_status("Calculating OpenAI Cosine...")
            try:
                oai_emb1 = get_openai_embedding(text1)
                oai_emb2 = get_openai_embedding(text2)
                results_data['openai_cosine'] = cosine_similarity(oai_emb1, oai_emb2)
            except Exception as e: errors_encountered.append(f"OpenAI Cosine Error: {e}"); print(f"OpenAI Cosine Error: {e}")
        else: update_comp_status("Skipping OpenAI Cosine (key missing).")

        if GENSIM_AVAILABLE and POT_AVAILABLE and wmd_model_loaded and wmd_model:
            update_comp_status("Calculating Word Mover's Distance...")
            try: results_data['wmd_distance'] = word_movers_distance(text1, text2)
            except Exception as e: errors_encountered.append(f"WMD Error: {e}"); print(f"WMD Error: {e}"); results_data['wmd_distance'] = float('inf') # Mark as error state
        elif GENSIM_AVAILABLE and POT_AVAILABLE: update_comp_status("Skipping WMD (model not loaded).")
        else: update_comp_status("Skipping WMD (libs missing).")

        if BERTSCORE_AVAILABLE:
            update_comp_status("Calculating BERTScore...")
            try:
                p, r, f1 = calculate_bertscore(text1, text2)
                results_data['bertscore_p'], results_data['bertscore_r'], results_data['bertscore_f1'] = p, r, f1
            except Exception as e: errors_encountered.append(f"BERTScore Error: {e}"); print(f"BERTScore Error: {e}")
        else: update_comp_status("Skipping BERTScore (library missing).")

        update_comp_status("Calculating Hybrid Score...")
        try: results_data['hybrid_jaccard_bertscore'] = calculate_hybrid_score(results_data['jaccard'], results_data['bertscore_f1'])
        except Exception as e: errors_encountered.append(f"Hybrid Score Error: {e}"); print(f"Hybrid Score Error: {e}")

# <<<--- NEW: Calculate Side-by-Side Diff --- >>>
        if text1 or text2:
            update_comp_status("Calculating side-by-side differences...")
            try:
                # Use a reasonable default width or try to get from widget if possible (complex)
                # Let's start with a fixed width like 90
                diff_width = 90
                results_data['diff_formatted'] = generate_side_by_side_diff(text1, text2, width=diff_width)
            except Exception as e:
                errors_encountered.append(f"Side-by-Side Diff Error: {e}"); print(f"Diff Error: {e}")
                results_data['diff_formatted'] = [ (f"--- Error calculating diff: {e} ---".ljust(diff_width), 'deleted', None, diff_width) ]
        else:
             results_data['diff_formatted'] = [ ("--- Both inputs were empty, no differences to show. ---".ljust(90), 'unchanged', 'unchanged', 90)]
        # <<<--- END NEW Diff Calculation --- >>>


        # AI Analysis (runs last as it can be slow)
        if openai_client:
            update_comp_status("Running AI Analysis (GPT-4o)... This may take some time.")
            try: results_data['gpt4_analysis'] = gpt4_similarity_analysis(text1, text2)
            except Exception as e:
                 ai_error_msg = f"AI Analysis Error: {type(e).__name__}"
                 errors_encountered.append(ai_error_msg); print(f"AI Analysis Error: {e}")
                 results_data['gpt4_analysis'] = f"--- AI ANALYSIS ERROR ---\n{type(e).__name__}: {e}\n(See console log for details)"
        else:
            update_comp_status("Skipping AI Analysis (key missing).")
            results_data['gpt4_analysis'] = "Skipped (OpenAI Key Missing)."

        # --- Finalize ---
        comparison_succeeded = not errors_encountered # Success if no errors were logged
        comparison_results_cache = results_data # Store results (including partial results/errors)

    except Exception as e:
        # Catch unexpected errors within the thread itself
        critical_error_msg = f"Unexpected Comparison Thread Error:\n{type(e).__name__}: {e}"
        print(critical_error_msg); traceback.print_exc()
        # Store the critical error message in the cache
        comparison_results_cache = {'error': critical_error_msg, 'model1_name': m1_name, 'model2_name': m2_name}
        errors_encountered.append("Critical thread error.") # Add to error list
        comparison_succeeded = False # Mark as failed
        update_comp_status(f"Critical Comparison Error! Check Logs.")
        # <<<--- NEW: Ensure diff_lines has error message in critical failure --- >>>
        if 'diff_lines' not in comparison_results_cache: # If error happened before diff
             comparison_results_cache['diff_lines'] = [f"--- Comparison critically failed before diff: {critical_error_msg} ---"]
        # Schedule GUI update specifically for error display
        if window_ref and window_ref.winfo_exists():
             try:
                 window_ref.after(0, lambda: show_comparison_error(scores_frame, gpt_widget, critical_error_msg))
             except tk.TclError: pass

    finally:
        # Schedule the final GUI update on the main thread, passing the success status and any errors
        if window_ref and window_ref.winfo_exists():
            # Pass diff_widget again for the final update function
            try:
                window_ref.after(0, lambda success=comparison_succeeded, errors=errors_encountered[:], cache=comparison_results_cache.copy(): _update_comparison_gui_final(
                    success, errors, cache, m1_name, m2_name, scores_frame, explanation_widget, gpt_widget,
                    status_var_wid, button_wid, save_button_wid, progress_wid, window_ref,
                    diff_widget # <<<--- NEW: Pass diff_widget --- >>>
                ))
            except tk.TclError: pass # Window might close before this runs


def _update_comparison_gui_final(comparison_succeeded, errors, results_cache, m1_name, m2_name, scores_frame, explanation_widget, gpt_widget,
                                 status_var_wid, button_wid, save_button_wid, progress_wid, window_ref,
                                 diff_widget): # <<<--- Pass diff_widget --- >>>
    """Updates the Advanced Comparison GUI on the main thread after calculations."""
    if not window_ref or not window_ref.winfo_exists(): return # Ensure window is still valid

    # --- Hide Progress Bar ---
    if progress_wid and progress_wid.winfo_exists():
        try:
            progress_wid.stop()
            progress_wid.grid_forget() # Use grid_forget since it was placed with grid
        except tk.TclError: pass

    # --- Re-enable Run Button ---
    if button_wid and button_wid.winfo_exists():
        try: button_wid.config(state=tk.NORMAL)
        except tk.TclError: pass

    # --- Populate Scores Tab ---
    if scores_frame and scores_frame.winfo_exists():
        # Clear previous score rows/error messages first
        for child in scores_frame.winfo_children():
             try: child.destroy()
             except tk.TclError: pass

        # Check for critical error first
        if 'error' in results_cache:
            show_comparison_error(scores_frame, gpt_widget, results_cache['error'])
        # Otherwise, display results (even if some metrics failed)
        else:
            try:
                # Add Header
                ttk.Label(scores_frame, text=f"Comparison Results: '{m1_name}' vs '{m2_name}'", font="-weight bold").pack(anchor='w', pady=(0, 10))

                # Helper to create score row with label, value, and optional progress bar
                def create_score_row(parent, label_text, score_value, is_distance=False):
                    if not parent or not parent.winfo_exists(): return
                    row = ttk.Frame(parent); row.pack(fill=tk.X, pady=2)

                    # Format score value (handle None, Inf)
                    score_fmt = "{:.4f}" if isinstance(score_value, (int, float)) and score_value != float('inf') else "{}"
                    score_txt = score_fmt.format(score_value) if score_value is not None else "N/A"
                    if is_distance and score_value == float('inf'): score_txt = "Inf/Error" # Special display for WMD errors

                    # Create widgets: Label, Score Value, Progress Bar (optional)
                    label_wid = ttk.Label(row, text=f"{label_text}:", width=28, anchor='w'); label_wid.pack(side=tk.LEFT, padx=(0, 5))
                    score_val_wid = ttk.Label(row, text=score_txt, width=10, anchor='w'); score_val_wid.pack(side=tk.LEFT, padx=(0, 10))

                    # Add progress bar for similarity scores (0-1 range)
                    if not is_distance and isinstance(score_value, (int, float)) and 0.0 <= score_value <= 1.0:
                         pb = ttk.Progressbar(row, orient='horizontal', length=200, maximum=100, value=score_value * 100, mode='determinate')
                         pb.pack(side=tk.LEFT, fill=tk.X, expand=True)
                    else: # Add filler frame if no progress bar to maintain alignment
                         ttk.Frame(row).pack(side=tk.LEFT, fill=tk.X, expand=True)

                # Create rows for each metric found in the results cache
                st_model_label = f"({results_cache.get('st_model_used', 'Unknown')})"
                create_score_row(scores_frame, "Jaccard (Lexical)", results_cache.get('jaccard'))
                create_score_row(scores_frame, f"ST Cosine {st_model_label}", results_cache.get('st_cosine'))
                create_score_row(scores_frame, "OpenAI Cosine", results_cache.get('openai_cosine'))
                create_score_row(scores_frame, "WMD (Lower=Better)", results_cache.get('wmd_distance'), is_distance=True)
                create_score_row(scores_frame, "BERTScore F1", results_cache.get('bertscore_f1'))
                # Optionally show BERTScore P/R:
                # create_score_row(scores_frame, "  BERTScore Precision", results_cache.get('bertscore_p'))
                # create_score_row(scores_frame, "  BERTScore Recall", results_cache.get('bertscore_r'))
                create_score_row(scores_frame, "Hybrid (Jac+BERT F1)", results_cache.get('hybrid_jaccard_bertscore'))

                # Enable Save button now that results are displayed
                if save_button_wid and save_button_wid.winfo_exists():
                     try: save_button_wid.config(state=tk.NORMAL)
                     except tk.TclError: pass

            except tk.TclError as e: print(f"Error populating scores frame UI: {e}")
            except Exception as e: print(f"Unexpected error populating scores: {e}"); traceback.print_exc()


    # --- Update AI Analysis Tab ---
    if gpt_widget and gpt_widget.winfo_exists():
        try:
            gpt_widget.config(state='normal') # Enable writing
            gpt_widget.delete('1.0', tk.END)
            # Get analysis text from cache, default to "N/A" or error message
            analysis_text = results_cache.get('gpt4_analysis', "AI Analysis data not available.")
            if 'error' in results_cache and 'gpt4_analysis' not in results_cache: # If critical error occurred before AI analysis
                 analysis_text = f"--- COMPARISON FAILED ---\n{results_cache['error']}"

            gpt_widget.insert('1.0', analysis_text)
            gpt_widget.config(state='disabled') # Make read-only again
        except tk.TclError as e: print(f"Error updating AI analysis widget: {e}")
        except Exception as e: print(f"Unexpected error updating AI analysis widget: {e}")


     # <<<--- NEW: Populate Side-by-Side Diff View Tab WITH TAGS --- >>>
    if diff_widget and diff_widget.winfo_exists():
        try:
            diff_widget.config(state='normal') # Enable writing
            diff_widget.delete('1.0', tk.END) # Clear placeholder/previous

            diff_formatted_data = results_cache.get('diff_formatted')
            separator = ' | '
            sep_len = len(separator)

            if diff_formatted_data:
                # Estimate column width from the first formatted line
                # Assumes consistent formatting from generate_side_by_side_diff
                first_line_len = len(diff_formatted_data[0][0]) if diff_formatted_data else 90
                col_width = max(5, (first_line_len - sep_len) // 2)

                current_line_start = "1.0" # Track start index for tagging

                for line_text, left_tag, right_tag, left_content_len in diff_formatted_data:
                    # Insert the line
                    # We add the newline here during insertion
                    diff_widget.insert(tk.END, line_text + "\n")

                    # Calculate tag ranges for the *just inserted* line
                    # Start index of the line we just inserted
                    line_start_index = diff_widget.index(f"{current_line_start}")
                    # End index of the line (before the newline)
                    line_content_end_index = diff_widget.index(f"{current_line_start} + {len(line_text)}c")

                    # Apply left tag (handle None)
                    if left_tag:
                        left_tag_start = line_start_index
                        # Tag only the actual content, not the padding
                        left_tag_end_offset = min(left_content_len, col_width) # Don't tag past column width
                        left_tag_end = f"{line_start_index} + {left_tag_end_offset}c"
                        diff_widget.tag_add(left_tag, left_tag_start, left_tag_end)

                    # Apply right tag (handle None)
                    if right_tag:
                        right_tag_start_offset = col_width + sep_len
                        right_tag_start = f"{line_start_index} + {right_tag_start_offset}c"
                        # The end of the right tag is the end of the line's content
                        right_tag_end = line_content_end_index
                        diff_widget.tag_add(right_tag, right_tag_start, right_tag_end)

                    # Update line start tracker for the next iteration
                    current_line_start = diff_widget.index(f"{line_content_end_index} + 1c") # Move past the newline

            elif 'error' in results_cache:
                 diff_widget.insert(tk.END, f"--- Comparison Failed ---\n{results_cache['error']}\n", ("deleted",))
            else:
                diff_widget.insert(tk.END, "--- Difference calculation failed, was skipped, or inputs were identical. ---\n", ("unchanged",))

            diff_widget.config(state='disabled') # Make read-only again
            diff_widget.see("1.0") # Scroll to top

        except tk.TclError as e: print(f"TclError updating side-by-side diff widget: {e}")
        except Exception as e: print(f"Unexpected error updating side-by-side diff widget: {e}"); traceback.print_exc()
    # <<<--- END NEW Diff Population --- >>>


    # --- Update Status Bar ---
    final_status = "Status: Comparison complete."
    if errors:
        final_status = f"Status: Comparison complete with {len(errors)} error(s). Check scores/console."
    elif not comparison_succeeded and 'error' in results_cache: # Critical error case
         final_status = "Status: Critical comparison error!"
    elif not comparison_succeeded: # General failure without critical error
        final_status = "Status: Comparison failed or was interrupted."

    if status_var_wid:
        try: status_var_wid.set(final_status)
        except tk.TclError: pass

    # Update main menu states (e.g., enable save report options)
    update_menu_states()


def show_comparison_error(scores_frame, gpt_widget, error_message):
    """Displays a prominent error message in the comparison results area."""
    # Display in Scores Tab
    if scores_frame and scores_frame.winfo_exists():
        try:
            # Clear previous content
            for child in scores_frame.winfo_children(): child.destroy()
            # Display error prominently
            ttk.Label(scores_frame, text="Comparison Failed!", foreground="red", font="-weight bold").pack(anchor='center', pady=10)
            # Show error details in a small text box
            error_detail_text = scrolledtext.ScrolledText(scores_frame, wrap=tk.WORD, height=5, width=70, font=("Arial", 9), relief=tk.SOLID, borderwidth=1)
            error_detail_text.pack(fill=tk.X, expand=False, pady=5, padx=10)
            error_detail_text.insert('1.0', error_message)
            error_detail_text.config(state='disabled') # Make read-only
        except tk.TclError as e: print(f"TclError displaying comparison error in scores frame: {e}")
        except Exception as e: print(f"Error displaying comparison error in scores frame: {e}")

    # Display in AI Analysis Tab as well
    if gpt_widget and gpt_widget.winfo_exists():
        try:
            gpt_widget.config(state='normal')
            gpt_widget.delete('1.0', tk.END)
            gpt_widget.insert('1.0', f"--- COMPARISON ERROR ---\n\n{error_message}")
            gpt_widget.config(state='disabled')
        except tk.TclError as e: print(f"TclError displaying comparison error in AI frame: {e}")
        except Exception as e: print(f"Error displaying comparison error in AI frame: {e}")

