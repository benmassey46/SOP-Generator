def preprocess_text_wmd(text):
    """Preprocesses text for Word Mover's Distance: lowercase, remove punctuation, tokenize, remove stopwords."""
    if not text: return []
    text = text.lower()
    text = re.sub(r'[^\w\s]', '', text) # Keep spaces for split/tokenization

    try:
        # Use NLTK if available and stopwords list is populated
        if NLTK_AVAILABLE and english_stopwords:
             tokens = word_tokenize(text)
             # Filter stopwords and ensure words are alphanumeric after tokenization
             return [word for word in tokens if word.isalnum() and word not in english_stopwords]
        else: # Fallback to basic split
            tokens = text.split()
            # Filter out non-alphanumeric tokens resulting from split
            return [word for word in tokens if word.isalnum()]
    except Exception as e:
        print(f"Error during WMD tokenization: {e}. Falling back to basic split.")
        tokens = text.split()
        return [word for word in tokens if word.isalnum()]


