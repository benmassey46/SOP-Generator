from html import escape

def save_review_data(window_ref):
    """Saves the edited SOP, review metrics, comments, conversation, and automated metrics to a PDF."""
    global review_data_cache
    parent_window = window_ref if window_ref and window_ref.winfo_exists() else \
                    (root if 'root' in globals() and root and root.winfo_exists() else None)
    status_var = getattr(window_ref, 'status_var', None)

    if not PDF_GENERATION_POSSIBLE:
        messagebox.showerror("PDF Library Missing", "Cannot save report as PDF. Please install 'markdown2' and 'xhtml2pdf'.", parent=parent_window)
        return

    if status_var: status_var.set("Status: Preparing save...")

    # --- Get Latest Data ---
    if hasattr(window_ref, 'sop_editor') and window_ref.sop_editor.winfo_exists():
        review_data_cache['edited_sop'] = window_ref.sop_editor.get("1.0", tk.END).strip()
    if hasattr(window_ref, 'comments_widget') and window_ref.comments_widget.winfo_exists():
        review_data_cache['review_comments'] = window_ref.comments_widget.get("1.0", tk.END).strip()

    edited_sop_markdown = review_data_cache.get('edited_sop', '')
    if not edited_sop_markdown:
        messagebox.showerror("Save Error", "The SOP content is empty. Nothing to save.", parent=parent_window)
        if status_var: status_var.set("Status: Save cancelled (empty SOP).")
        return

    # --- Calculate Metrics ---
    if status_var: status_var.set("Status: Calculating automated metrics...")
    try:
        review_data_cache['automated_metrics'] = calculate_automated_metrics(edited_sop_markdown)
    except Exception as e:
        print(f"Error calculating automated metrics during save: {e}")
        review_data_cache['automated_metrics'] = {"error": str(e)}
        messagebox.showwarning("Metrics Error", f"Could not calculate automated metrics: {e}", parent=parent_window)

    # --- Prepare Filename ---
    model_name = review_data_cache.get('model_name', 'UnknownModel')
    topic = get_sop_topic()
    cleaned_topic = clean_filename(topic) if topic else "Untitled_SOP"
    now = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    initial_filename = f"ReviewedSOP_{cleaned_topic}_{clean_filename(model_name)}_{now}.pdf"

    # --- Ask for Save Location ---
    file_path = filedialog.asksaveasfilename(
        initialfile=initial_filename,
        defaultextension=".pdf",
        filetypes=[("PDF Files", "*.pdf"), ("All Files", "*.*")],
        title="Save Reviewed SOP and Metrics as PDF",
        parent=parent_window
    )

    if not file_path:
        if status_var: status_var.set("Status: Save cancelled by user.")
        return

    # --- Write Data to File ---
    if status_var: status_var.set(f"Status: Generating reviewed SOP PDF...")
    try:
        # 1. Convert SOP Markdown to HTML body
        sop_html_body = markdown2.markdown(
            edited_sop_markdown,
            extras=["tables", "fenced-code-blocks", "strike", "markdown-in-html", "cuddled-lists", "footnotes"]
        )

        # 2. Generate Report Sections as Plain Text
        report_lines = []
        # --- Build the plain text report part ---
        report_lines.append("="*40 + "\n") # Start with separator
        report_lines.append("User Review Metrics")
        report_lines.append("-"*20)
        scores = review_data_cache.get("review_scores", {})
        for metric, score in scores.items():
            report_lines.append(f"- {metric.capitalize()}: {score}/5")

        report_lines.append("\nUser Comments")
        report_lines.append("-"*20)
        comments = review_data_cache.get("review_comments", "(No comments provided)")
        # Wrap comments within the text generation, not relying on <pre> solely
        report_lines.append(textwrap.fill(comments if comments else "(No comments provided)", width=70)) # Slightly narrower width for pre

        report_lines.append("\n\n" + "="*40 + "\n")
        report_lines.append("Automated Metrics (Experimental)")
        report_lines.append("-"*30)
        auto_metrics = review_data_cache.get("automated_metrics", {})
        if auto_metrics.get("error"):
             report_lines.append(f"Error calculating metrics: {auto_metrics['error']}")
        else:
             # Readability
             readability = auto_metrics.get("readability", {})
             report_lines.append("Readability Indicators:")
             report_lines.append(f"  Flesch Reading Ease: {readability.get('flesch_reading_ease', 'N/A'):.2f} (Higher is easier)" if readability.get('flesch_reading_ease') is not None else "  Flesch Reading Ease: N/A")
             report_lines.append(f"  Gunning Fog Index:   {readability.get('gunning_fog', 'N/A'):.2f} (Lower is usually clearer)" if readability.get('gunning_fog') is not None else "  Gunning Fog Index:   N/A")
             report_lines.append(f"  Avg Sentence Length: {readability.get('avg_sentence_length', 'N/A'):.1f} words" if readability.get('avg_sentence_length') is not None else "  Avg Sentence Length: N/A")
             if not TEXTSTAT_AVAILABLE: report_lines.append("    (Note: 'textstat' library missing)")
             if not NLTK_AVAILABLE: report_lines.append("    (Note: 'nltk' library missing for sentence length)")
             # Clarity Proxy
             clarity = auto_metrics.get("clarity_proxy", {})
             report_lines.append("\nClarity Indicators:")
             passive_ratio = clarity.get('passive_voice_ratio')
             report_lines.append(f"  Passive Voice Ratio: {passive_ratio:.1%} (Lower is often clearer)" if isinstance(passive_ratio, float) else f"  Passive Voice Ratio: {passive_ratio}")
             if clarity.get("total_sentences", 0) > 0:
                  report_lines.append(f"    (Based on {clarity.get('passive_voice_sentences', 0)} passive / {clarity.get('total_sentences', 0)} total sentences)")
             if not SPACY_AVAILABLE or not nlp_spacy: report_lines.append("    (Note: 'spaCy' missing or model failed)")
             # Completeness Proxy
             completeness = auto_metrics.get("completeness_proxy", {})
             report_lines.append("\nCompleteness Proxy (Standard Sections):")
             report_lines.append("  Found:     {}".format(', '.join(completeness.get('standard_sections_found', [])) or "None"))
             report_lines.append("  Missing:   {}".format(', '.join(completeness.get('standard_sections_missing', [])) or "None"))
             report_lines.append("    (Note: Basic check based on common headings.)")
             # Structure & Consistency Proxy
             structure = auto_metrics.get("structure", {})
             consistency = auto_metrics.get("consistency_proxy", {})
             report_lines.append("\nStructure & Consistency Indicators:")
             report_lines.append(f"  Detected Section Headings: {len(structure.get('section_headings',[]))}")
             heading_usage = consistency.get('heading_level_usage', {})
             heading_usage_str = ', '.join([f"Level {lvl}: {cnt}" for lvl, cnt in sorted(heading_usage.items())]) or "None detected"
             report_lines.append(f"  Heading Level Usage (#): {heading_usage_str}")
             report_lines.append(f"  List Item Count: {structure.get('list_item_count', 'N/A')}")
             report_lines.append(f"  List Type Usage: {consistency.get('list_type_usage', 'N/A')}")
             report_lines.append("    (Note: Basic checks. Review manually.)")

        report_lines.append("\n\n" + "="*40 + "\n")
        report_lines.append("Follow-up Conversation History")
        report_lines.append("-"*30)
        history = review_data_cache.get("conversation_history", [])
        if not history:
            report_lines.append("(No follow-up queries were made.)")
        else:
            for turn in history:
                 role = turn.get("role", "unknown").capitalize()
                 content = turn.get("content", "")
                 prefix = ">> User:" if role == "User" else "<< AI:"
                 # Wrap content within the plain text report
                 wrapped_content = textwrap.fill(content, width=70, initial_indent='  ', subsequent_indent='  ')
                 report_lines.append(f"\n{prefix}\n{wrapped_content}")

        report_text_plain = "\n".join(report_lines)
        escaped_report_text_plain = escape(report_text_plain) # Escape for HTML <pre>

        # --- 3. Define Simplified CSS (No @frame) ---
        # Use standard page margins and let content flow
        css = """
        @page {
            size: a4 portrait;
            margin: 1.5cm; /* Slightly smaller margins */
        }
        body { font-family: "Helvetica", "Arial", sans-serif; font-size: 11pt; line-height: 1.4; color: #333; }
        h1, h2, h3, h4, h5, h6 { font-family: "Helvetica", "Arial", sans-serif; font-weight: bold; margin-top: 1.2em; margin-bottom: 0.6em; line-height: 1.2; color: #000; }
        h1 { font-size: 18pt; }
        h2 { font-size: 16pt; border-bottom: 1px solid #eee; padding-bottom: 0.2em; }
        h3 { font-size: 14pt; }
        h4 { font-size: 12pt; }
        p { margin-top: 0.5em; margin-bottom: 0.8em; text-align: justify; }
        ul, ol { margin-top: 0.5em; margin-bottom: 0.8em; padding-left: 1.5em; }
        li { margin-bottom: 0.3em; }
        ul { list-style-type: disc; } ol { list-style-type: decimal; }
        ul ul, ol ul { list-style-type: circle; margin-top: 0.2em; margin-bottom: 0.2em;}
        ul ol, ol ol { list-style-type: lower-alpha; margin-top: 0.2em; margin-bottom: 0.2em;}
        pre {
            font-family: "Courier New", monospace;
            font-size: 9pt;
            background-color: #f8f8f8;
            border: 1px solid #ddd;
            padding: 10px;
            white-space: pre-wrap;
            word-wrap: break-word;
            margin-top: 1em;
            margin-bottom: 1em;
            overflow-x: auto;
            display: block; /* Ensure pre is block level */
        }
        code { font-family: "Courier New", monospace; font-size: 9pt; background-color: #f0f0f0; padding: 0.1em 0.3em; border-radius: 3px; }
        strong, b { font-weight: bold; } em, i { font-style: italic; }
        table { border-collapse: collapse; width: 100%; margin-bottom: 1em; }
        th, td { border: 1px solid #ccc; padding: 6px 10px; text-align: left; }
        th { background-color: #f2f2f2; font-weight: bold; }
        /* Style the separator and the wrapper for the report section */
        .report-separator {
             border: 0;
             border-top: 2px solid #aaa; /* Make separator more prominent */
             margin: 2.5em 0; /* Increase spacing around separator */
             display: block;
        }
        .review-details {
            margin-top: 2em; /* Add space above the review section */
            display: block; /* Ensure it's treated as a block */
        }
        """

        # --- 4. Combine into final HTML ---
        # Wrap the <pre> block in a div with a class for potential styling/spacing
        # Use a proper <hr> for semantic separation, styled by CSS
        combined_html_body = f"""
            {sop_html_body}
            <hr class="report-separator" />
            <div class="review-details">
                <h2>Review Details & History</h2>
                <pre>{escaped_report_text_plain}</pre>
            </div>
        """

        final_html_for_pdf = f"""
        <html><head><title>Reviewed SOP: {topic or 'Untitled'}</title><style>{css}</style></head>
        <body>{combined_html_body}</body></html>
        """

        # --- 5. Generate PDF ---
        with open(file_path, "wb") as output_file:
            pisa_status = pisa.CreatePDF(
                src=final_html_for_pdf.encode('utf-8'),
                dest=output_file,
                encoding='utf-8'
            )

        if pisa_status.err:
            # Provide more specific error if possible
            error_detail = f"xhtml2pdf error ({pisa_status.err}): Check console/logs for details."
            # Attempt to log the full exception traceback if available
            if pisa_status.exc_info:
                try:
                    exc_type, exc_value, exc_traceback = pisa_status.exc_info
                    print("--- xhtml2pdf Exception Traceback ---")
                    traceback.print_exception(exc_type, exc_value, exc_traceback)
                    print("------------------------------------")
                    # Add snippet of exception message to the error detail if useful
                    error_detail += f"\nException: {exc_type.__name__} - {exc_value}"
                except Exception as log_e:
                    print(f"Error logging pisa exception details: {log_e}")
            raise RuntimeError(error_detail) # Raise clearer error

        if status_var: status_var.set(f"Status: Report saved successfully to {os.path.basename(file_path)}")

    except Exception as e:
        # Catch both conversion errors and other file errors
        error_msg = f"Could not save the reviewed report PDF:\n{e}"
        messagebox.showerror("Save Error", error_msg, parent=parent_window)
        if status_var: status_var.set("Status: Reviewed PDF save failed!")
        print(f"Save Review Error: {e}"); traceback.print_exc()


# Helper function to update score cache when scale changes
def update_review_score(metric_name, value):
    global review_data_cache
    try:
        # Value from scale might be float string, convert to int
        score_int = int(float(value))
        if metric_name in review_data_cache.get("review_scores", {}):
            review_data_cache["review_scores"][metric_name] = score_int
            # print(f"Score cache updated: {metric_name}={score_int}") # Debug
    except (ValueError, TypeError, KeyError) as e:
        print(f"Error updating score cache for {metric_name}: {e}")


def trigger_open_review_window():
    """Validates selection and initiates the opening of the review window."""
    global output_notebook, output_widgets, review_window
    parent_window = root if 'root' in globals() and root and root.winfo_exists() else None

    # Check if review window is already open
    if review_window and review_window.winfo_exists():
        try:
            review_window.lift()
            review_window.focus_set()
            status_var.set("Status: Review window is already open.")
        except tk.TclError:
            review_window = None # Window was destroyed
        return

    # --- Get Selected Tab Info ---
    selected_model_name = None
    selected_widget = None
    try:
        if output_notebook and output_notebook.winfo_exists() and output_notebook.tabs():
            selected_tab_id = output_notebook.select()
            if selected_tab_id:
                tab_text = output_notebook.tab(selected_tab_id, "text")
                # Ensure it's not the placeholder and it's a valid generated output
                if tab_text != "Outputs" and tab_text in output_widgets:
                    widget_ref = output_widgets[tab_text]
                    if widget_ref and widget_ref.winfo_exists():
                        selected_model_name = tab_text
                        selected_widget = widget_ref
    except (tk.TclError, KeyError, IndexError) as e:
        print(f"Error identifying selected tab for review: {e}")

    # --- Validation ---
    if not selected_model_name or not selected_widget:
        messagebox.showwarning("Selection Error", "Please select a valid generated SOP tab to review.", parent=parent_window)
        return

    # Check if the selected model's provider is actually available for follow-up queries
    if not check_model_availability(selected_model_name):
         provider = AVAILABLE_MODELS.get(selected_model_name, {}).get("provider", "Unknown")
         messagebox.showerror("API Error", f"The API for the selected model's provider ({provider}) is not available.\nCannot perform follow-up queries.\nPlease check API keys/config.", parent=parent_window)
         return # Prevent opening review window if querying isn't possible

    # --- Get SOP Text ---
    sop_text = ""
    try:
        original_state = selected_widget.cget('state')
        selected_widget.config(state=tk.NORMAL)
        sop_text = selected_widget.get("1.0", tk.END).strip()
        selected_widget.config(state=original_state)
        # Optional: Clean the "[End Generation...]" marker if present
        end_marker_match = re.search(r"\[End Generation -.*?\]", sop_text, re.IGNORECASE | re.DOTALL)
        if end_marker_match:
             sop_text = sop_text[:end_marker_match.start()].strip()
    except tk.TclError as e:
        messagebox.showerror("Widget Error", f"Failed to get SOP text from tab '{selected_model_name}':\n{e}", parent=parent_window)
        return
    except Exception as e_get:
        messagebox.showerror("Error", f"Unexpected error getting SOP text: {e_get}", parent=parent_window)
        return

    if not sop_text:
        messagebox.showwarning("Empty SOP", f"The selected SOP tab '{selected_model_name}' is empty. Cannot review.", parent=parent_window)
        return

    # --- Open the Review Window ---
    open_review_window(selected_model_name, sop_text)

