def normalize_section_heading(heading):
    """Normalizes heading text to create consistent keys for section comparison."""
    if not heading: return "unknown_section"
    text = heading.lower()
    # Remove common prefixes like '# ', '## ', '1.', '* ', '- ' etc. and trailing punctuation : *
    text = re.sub(r'^\s*(?:#+\s*|\d+\.?\s*|\*\s*|\-\s*)|[:\*]\s*$', '', text).strip()
    # Replace sequences of whitespace with a single space
    text = re.sub(r'\s+', ' ', text).strip()
    # Replace remaining non-alphanumeric characters (excluding underscore) with underscore
    text = re.sub(r'[^a-z0-9_]+', '_', text)
    # Collapse multiple consecutive underscores
    text = re.sub(r'_+', '_', text).strip('_')
    # Handle cases where everything is removed (e.g., heading was just '#')
    return text if text else "unknown_section"


def parse_sop_sections(sop_text):
    """Parses SOP text into an OrderedDict of {normalized_heading: content}."""
    sections = OrderedDict()
    if not sop_text or not sop_text.strip():
        return sections # Return empty if input is empty or only whitespace

    # --- Robust Heading Pattern ---
    # Matches lines likely intended as headings:
    # - Optional leading whitespace: ^\s*
    # - Optional prefixes: Markdown (#+), Numbers (1.), Bullets (*, -) : (?:...) denotes non-capturing group
    # - Heading Text (Group 1): Starts uppercase OR all caps (3+), allows letters, numbers, space, -, _, (), /
    # - Uses non-greedy matching for heading text: .+?
    # - Requires a colon OR newline OR end-of-string immediately after (allows optional space before): \s*(?::|\n|$)
    heading_pattern = re.compile(
        r"^\s*(?:(?:#+\s*)|(?:\d+\.\s*)|(?:\*\s*)|(?:\-\s*))?" # Optional prefixes
        r"([A-Z][A-Za-z0-9\s\-_()\/]+?|[A-Z]{3,})"            # Heading text (Group 1)
        r"\s*(?::|\n|$)",                                     # Ending colon, newline, or end of string
        re.MULTILINE # Match ^ at the start of each line
    )

    last_section_end_pos = 0
    current_heading_match = None

    # --- Handle Potential Content Before First Heading ---
    first_match = heading_pattern.search(sop_text)
    if first_match and first_match.start() > 0:
        # Capture content from the beginning up to the start of the first heading
        intro_content = sop_text[0:first_match.start()].strip()
        if intro_content:
            sections["introduction"] = intro_content # Assign a generic key
            last_section_end_pos = first_match.start() # Update position marker
    elif not first_match:
        # If no headings found at all, treat the whole text as one section
        full_content = sop_text.strip()
        if full_content:
             sections["full_text"] = full_content
        return sections # Return early

    # --- Iterate Through Heading Matches ---
    for match in heading_pattern.finditer(sop_text):
        current_heading_text = match.group(1).strip() if match.group(1) else "unknown_heading"
        current_heading_start_pos = match.start() # Start index of the current heading line

        # If we have processed a previous heading, capture the content between them
        if current_heading_match is not None:
            prev_heading_text = current_heading_match.group(1).strip() if current_heading_match.group(1) else "unknown_heading"
            # Content starts *after* the end of the previous heading match
            # Using match.end() gives the position right after the matched heading line (including newline/colon)
            content_start_pos = current_heading_match.end()
            section_content = sop_text[content_start_pos:current_heading_start_pos].strip()

            if section_content:
                normalized_prev_name = normalize_section_heading(prev_heading_text)
                # Append content if section name already exists (handles duplicate headings)
                sections[normalized_prev_name] = sections.get(normalized_prev_name, "") + "\n\n" + section_content if normalized_prev_name in sections else section_content

        # Update tracking for the next iteration
        current_heading_match = match
        last_section_end_pos = match.end() # Mark the end of the current heading line

    # --- Handle Content After the Last Detected Heading ---
    if current_heading_match is not None:
        final_heading_text = current_heading_match.group(1).strip() if current_heading_match.group(1) else "unknown_heading"
        # Content starts after the end of the last matched heading line
        final_content = sop_text[last_section_end_pos:].strip()

        if final_content:
            normalized_final_name = normalize_section_heading(final_heading_text)
            # Append if section name already exists
            sections[normalized_final_name] = sections.get(normalized_final_name, "") + "\n\n" + final_content if normalized_final_name in sections else final_content

    # --- Clean Up ---
    # Filter out any sections that might have ended up empty after stripping
    return OrderedDict((k, v.strip()) for k, v in sections.items() if v.strip())


def extract_key_terms(text, top_n=None): # top_n is currently unused, returns all terms
    """Extracts unique alphanumeric key terms from text, excluding stopwords if possible."""
    if not text or not text.strip(): return set()

    key_terms = set()
    try:
        # Use NLTK if fully available (library + stopwords data)
        if NLTK_AVAILABLE and english_stopwords:
            tokens = word_tokenize(text.lower())
            # Filter for alphanumeric words AND exclude stopwords
            key_terms = set(word for word in tokens if word.isalnum() and word not in english_stopwords)
        else: # Fallback if NLTK or its data is missing
            # Basic split and filter alphanumeric
            tokens = text.lower().split()
            # Define a minimal stopword list if NLTK failed, otherwise use the loaded list (even if empty)
            basic_stopwords = {"the", "a", "an", "is", "are", "and", "or", "to", "in", "it", "of", "for", "on", "with", "this", "that", "be", "as", "at"}
            stopwords_to_use = english_stopwords if english_stopwords else basic_stopwords
            key_terms = set(word for word in tokens if word.isalnum() and word not in stopwords_to_use)

        return key_terms

    except Exception as e:
        print(f"Key term extraction error: {e}. Using very basic fallback (alphanum only).")
        # Extremely basic fallback: just split and keep alphanumeric tokens
        try:
            return set(word for word in text.lower().split() if word.isalnum())
        except Exception as final_e:
            print(f"Final fallback failed for key terms: {final_e}")
            return set()


def detect_list_items(text):
    """Detects lines starting with common list markers (number., *, -, (a))."""
    if not text: return []
    # Pattern: Start of line (^), optional whitespace (\s*),
    #          then (one or more digits + dot OR * OR - OR (letter/digit)),
    #          followed by mandatory whitespace (\s+),
    #          capture the rest of the line (.*)
    pattern = re.compile(r"^\s*(?:(?:\d+\.)|(?:\*)|(?:\-)|(?:\([a-zA-Z0-9]+\)))\s+(.*)", re.MULTILINE)
    # Find all matches and strip leading/trailing whitespace from the captured group
    return [item.strip() for item in pattern.findall(text)]


def extract_imperatives(spacy_doc):
    """Extracts likely imperative verbs (base form) from a spaCy Doc object."""
    imperatives = []
    # Ensure spaCy ran successfully and produced a Doc object
    if not spacy_doc or not SPACY_AVAILABLE:
        return imperatives

    for sentence in spacy_doc.sents:
        # Check common imperative patterns:
        # 1. Sentence starts with a base form verb (VB tag)
        if len(sentence) > 0 and sentence[0].pos_ == "VERB" and sentence[0].tag_ == "VB":
            # Basic check to exclude simple questions like "Do this?"
            is_question = any(tok.lemma_ == "?" for tok in sentence)
            subj = [tok for tok in sentence if tok.dep_ == "nsubj"] # Check for explicit subject
            if not is_question and not subj: # Add if not question and no explicit subject
                 imperatives.append(sentence[0].lemma_.lower())

        # 2. Sentence starts with optional Interjection/Particle/Punct, then base verb
        elif len(sentence) > 1 and sentence[0].pos_ in ["INTJ", "PART", "PUNCT"] and \
             sentence[1].pos_ == "VERB" and sentence[1].tag_ == "VB":
             is_question = any(tok.lemma_ == "?" for tok in sentence)
             subj = [tok for tok in sentence if tok.dep_ == "nsubj"]
             if not is_question and not subj:
                 imperatives.append(sentence[1].lemma_.lower())

        # Add more sophisticated rules if needed (e.g., based on dependency parse root)

    # Return unique imperative verbs found, sorted alphabetically
    return sorted(list(set(imperatives)))


def extract_entities(spacy_doc, entity_labels={"PERSON", "ORG", "PRODUCT", "GPE", "LOC", "DATE", "TIME", "MONEY", "QUANTITY", "NORP", "FAC", "EVENT", "LAW", "WORK_OF_ART", "LANGUAGE"}):
    """Extracts named entities from a spaCy Doc, counts them, and sorts by frequency."""
    entities_found = []
    # Ensure spaCy ran successfully
    if not spacy_doc or not SPACY_AVAILABLE:
        return entities_found

    # Use a dictionary to count occurrences of unique (text, label) pairs
    entity_counts = {}
    for ent in spacy_doc.ents:
        # Check if the entity label is in the set we care about
        if ent.label_ in entity_labels:
            # Normalize text slightly (strip whitespace) before counting
            entity_text = ent.text.strip()
            if entity_text: # Ignore empty strings that might rarely occur
                 key = (entity_text, ent.label_)
                 entity_counts[key] = entity_counts.get(key, 0) + 1

    # Convert the counts dictionary into a list of dictionaries for the final result
    entities_found = [
        {"text": text, "label": label, "count": count}
        for (text, label), count in entity_counts.items()
    ]

    # Sort the list: primarily by count (descending), secondarily by text (ascending)
    entities_found.sort(key=lambda x: (-x["count"], x["text"]))

    return entities_found


def compare_parsed_sops(parsed1, parsed2, status_callback=None):
    """Compares two parsed SOPs (OrderedDicts) section by section."""
    results = {
        'section_comparison': OrderedDict(), # Similarity scores per section
        'key_terms1': set(),             # Overall key terms doc 1
        'key_terms2': set(),             # Overall key terms doc 2
        'key_term_jaccard': None,        # Jaccard index for overall key terms
        'matched_sections': 0,           # Count of sections present in both docs
        'unmatched_sections1': [],       # List of section keys only in doc 1
        'unmatched_sections2': [],       # List of section keys only in doc 2
        'average_st_cosine': None,       # Avg ST cosine over matched sections
        'average_bertscore_f1': None,    # Avg BERTScore F1 over matched sections
        'st_model_used': 'N/A',          # Which ST model was used ('Default', 'Fine-Tuned', 'Unavailable')
        'structure_analysis': OrderedDict() # Structure details per section
    }

    st_scores_matched = [] # Collect scores only for matched sections for averaging
    bert_f1_scores_matched = []

    # Determine which ST model will be used
    st_model_status = "N/A"
    if st_finetuned_model_loaded and st_finetuned_model: st_model_status = "Fine-Tuned"
    elif st_model_loaded and st_model: st_model_status = "Default"
    elif st_model_loading or st_finetuned_model_loading: st_model_status = "Loading..."
    else: st_model_status = "Unavailable"
    results['st_model_used'] = st_model_status

    # Helper for status updates within this function
    def _update_status(msg):
        if status_callback:
            # Ensure the update is scheduled on the main GUI thread if called from worker
            # (Assuming status_callback is tied to the GUI)
            # If compare_parsed_sops runs entirely in worker, callback needs window ref + root.after
             status_callback(f"Status: {msg}") # Simplification for now

    _update_status("Initializing fine-grained comparison...")

    # Get all unique section keys from both documents
    all_section_keys = sorted(list(set(parsed1.keys()) | set(parsed2.keys())))
    total_sections = len(all_section_keys)
    processed_count = 0

    # --- Iterate Through Each Section Key ---
    for key in all_section_keys:
        processed_count += 1
        section_name_display = key.replace('_',' ').title()
        _update_status(f"Processing section {processed_count}/{total_sections} ('{section_name_display}')...")

        text1 = parsed1.get(key) # Content from doc 1, or None if key not present
        text2 = parsed2.get(key) # Content from doc 2, or None

        # Initialize results containers for this section
        section_result = {'st_cosine': None, 'bertscore_f1': None, 'status': 'Unknown'}
        structure_result = {
            'list_items1': [], 'list_items2': [], 'list_count_diff': None,
            'imperatives1': [], 'imperatives2': [], 'imperatives_jaccard': None,
            'entities1': [], 'entities2': [], 'entities_jaccard': None
        }

        # --- Case 1: Section Exists in Both Documents ---
        if text1 is not None and text2 is not None:
            results['matched_sections'] += 1
            section_result['status'] = 'Matched & Compared'
            sim_errors = [] # Track errors for this section's similarity calcs

            # Calculate Text Similarities
            try:
                if st_model_status not in ["N/A", "Unavailable", "Loading..."]:
                    try:
                        use_ft = (st_model_status == "Fine-Tuned")
                        emb1 = get_st_embedding(text1, use_fine_tuned_if_available=use_ft)
                        emb2 = get_st_embedding(text2, use_fine_tuned_if_available=use_ft)
                        section_result['st_cosine'] = cosine_similarity(emb1, emb2)
                        if section_result['st_cosine'] is not None:
                            st_scores_matched.append(section_result['st_cosine']) # Add to list for averaging
                    except Exception as e_st: sim_errors.append(f"ST Cosine Error: {e_st}")

                if BERTSCORE_AVAILABLE:
                    try:
                        p, r, f1 = calculate_bertscore(text1, text2)
                        # section_result['bertscore_p'] = p # Optionally store P and R
                        # section_result['bertscore_r'] = r
                        section_result['bertscore_f1'] = f1
                        if section_result['bertscore_f1'] is not None:
                            bert_f1_scores_matched.append(section_result['bertscore_f1']) # Add for averaging
                    except Exception as e_bs: sim_errors.append(f"BERTScore Error: {e_bs}")
                else:
                     section_result['status'] += " (BERTScore Skipped)"


            except Exception as e_sim: # Catch unexpected errors during similarity block
                sim_errors.append(f"Unexpected Similarity Error: {e_sim}")

            if sim_errors:
                print(f"Errors comparing section '{key}': {'; '.join(sim_errors)}")
                section_result['status'] = 'Comparison Error (Similarity)'


            # Perform Structure Analysis
            try:
                structure_result['list_items1'] = detect_list_items(text1)
                structure_result['list_items2'] = detect_list_items(text2)
                structure_result['list_count_diff'] = abs(len(structure_result['list_items1']) - len(structure_result['list_items2']))

                if SPACY_AVAILABLE and nlp_spacy:
                    doc1, doc2 = None, None
                    spacy_error = False
                    # Process text 1 with spaCy
                    try:
                        if len(text1) <= nlp_spacy.max_length: doc1 = nlp_spacy(text1)
                        else: print(f"Warning: Text 1 in section '{key}' ({len(text1)} chars) exceeds spaCy max length ({nlp_spacy.max_length}), skipping spaCy analysis.")
                    except Exception as e_spacy1: print(f"spaCy processing error (text 1, section '{key}'): {e_spacy1}"); spacy_error=True
                    # Process text 2 with spaCy
                    try:
                        if len(text2) <= nlp_spacy.max_length: doc2 = nlp_spacy(text2)
                        else: print(f"Warning: Text 2 in section '{key}' ({len(text2)} chars) exceeds spaCy max length ({nlp_spacy.max_length}), skipping spaCy analysis.")
                    except Exception as e_spacy2: print(f"spaCy processing error (text 2, section '{key}'): {e_spacy2}"); spacy_error=True

                    if spacy_error: section_result['status'] += " (spaCy Proc. Error)"

                    # Extract features if docs were processed
                    if doc1:
                        structure_result['imperatives1'] = extract_imperatives(doc1)
                        structure_result['entities1'] = extract_entities(doc1)
                    if doc2:
                        structure_result['imperatives2'] = extract_imperatives(doc2)
                        structure_result['entities2'] = extract_entities(doc2)

                    # Calculate Jaccard overlap for imperatives
                    imp_set1 = set(structure_result['imperatives1'])
                    imp_set2 = set(structure_result['imperatives2'])
                    imp_union = imp_set1.union(imp_set2)
                    structure_result['imperatives_jaccard'] = len(imp_set1.intersection(imp_set2)) / len(imp_union) if imp_union else 1.0

                    # Calculate Jaccard overlap for entities (based on unique (text, label) pairs)
                    ent_set1 = set((e['text'], e['label']) for e in structure_result['entities1'])
                    ent_set2 = set((e['text'], e['label']) for e in structure_result['entities2'])
                    ent_union = ent_set1.union(ent_set2)
                    structure_result['entities_jaccard'] = len(ent_set1.intersection(ent_set2)) / len(ent_union) if ent_union else 1.0

                else: # spaCy unavailable
                    if "Matched" in section_result['status']: # Avoid appending if already error status
                        section_result['status'] += " (spaCy Skipped)"

            except Exception as e_struct:
                print(f"Error during structure analysis for matched section '{key}': {e_struct}")
                section_result['status'] = 'Comparison Error (Structure)'

        # --- Case 2: Section Only in Doc 1 ---
        elif text1 is not None:
            section_result['status'] = 'Only in Doc 1'
            results['unmatched_sections1'].append(key)
            # Perform structure analysis only for Doc 1
            try:
                structure_result['list_items1'] = detect_list_items(text1)
                if SPACY_AVAILABLE and nlp_spacy:
                    doc1 = None
                    try:
                        if len(text1) <= nlp_spacy.max_length: doc1 = nlp_spacy(text1)
                        else: print(f"Warning: Text 1 in section '{key}' exceeds spaCy max length, skipping analysis.")
                    except Exception as e_spacy1: print(f"spaCy processing error (text 1, section '{key}'): {e_spacy1}")
                    if doc1:
                        structure_result['imperatives1'] = extract_imperatives(doc1)
                        structure_result['entities1'] = extract_entities(doc1)
            except Exception as e_struct1: print(f"Error structure analysis (Doc 1 only) section '{key}': {e_struct1}")

        # --- Case 3: Section Only in Doc 2 ---
        elif text2 is not None:
            section_result['status'] = 'Only in Doc 2'
            results['unmatched_sections2'].append(key)
            # Perform structure analysis only for Doc 2
            try:
                structure_result['list_items2'] = detect_list_items(text2)
                if SPACY_AVAILABLE and nlp_spacy:
                    doc2 = None
                    try:
                        if len(text2) <= nlp_spacy.max_length: doc2 = nlp_spacy(text2)
                        else: print(f"Warning: Text 2 in section '{key}' exceeds spaCy max length, skipping analysis.")
                    except Exception as e_spacy2: print(f"spaCy processing error (text 2, section '{key}'): {e_spacy2}")
                    if doc2:
                        structure_result['imperatives2'] = extract_imperatives(doc2)
                        structure_result['entities2'] = extract_entities(doc2)
            except Exception as e_struct2: print(f"Error structure analysis (Doc 2 only) section '{key}': {e_struct2}")

        # Store results for this section
        results['section_comparison'][key] = section_result
        results['structure_analysis'][key] = structure_result

    # --- Calculate Overall Averages (using scores from matched sections only) ---
    if st_scores_matched:
        results['average_st_cosine'] = sum(st_scores_matched) / len(st_scores_matched)
    if bert_f1_scores_matched:
        results['average_bertscore_f1'] = sum(bert_f1_scores_matched) / len(bert_f1_scores_matched)

    # --- Overall Key Term Comparison (using full texts) ---
    _update_status("Extracting & comparing overall key terms...")
    try:
        # Reconstruct full texts from parsed sections (might differ slightly from original if parsing was imperfect)
        full_text1 = "\n\n".join(parsed1.values())
        full_text2 = "\n\n".join(parsed2.values())
        results['key_terms1'] = extract_key_terms(full_text1)
        results['key_terms2'] = extract_key_terms(full_text2)

        # Calculate Jaccard for the overall key term sets
        union_terms = results['key_terms1'].union(results['key_terms2'])
        intersection_terms = results['key_terms1'].intersection(results['key_terms2'])
        results['key_term_jaccard'] = len(intersection_terms) / len(union_terms) if union_terms else 1.0
    except Exception as e_kt:
        print(f"Error during overall key term analysis: {e_kt}")
        results['key_term_jaccard'] = None # Indicate failure

    _update_status("Fine-grained comparison complete.")
    return results

