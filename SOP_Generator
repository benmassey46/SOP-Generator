         dummy_text = tk.Text(root) # Create temporary widget to access config
         dummy_text.tag_configure("added", background=added_bg, foreground=added_fg)
         dummy_text.tag_configure("deleted", background=deleted_bg, foreground=deleted_fg)
         # Use actual theme defaults for unchanged text
         dummy_text.tag_configure("unchanged", background=unchanged_bg, foreground=unchanged_fg)
         dummy_text.destroy() # Remove temporary widget
         print(f"Configured diff tags for theme: {theme_mode}")

    except Exception as e_tag:
        print(f"Warning: Could not configure text tags for diff view: {e_tag}")


    # --- Run Application Event Loop ---
    print("\n--- Application Initializing ---")
    try:
        root.mainloop()
    except Exception as e:
        print(f"Error during mainloop: {e}")
        traceback.print_exc()
    finally:
        print("--- Application Closed ---")
