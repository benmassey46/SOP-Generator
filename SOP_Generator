def _generate_plain_text_fg_report(m1_name, m2_name, results_data):
    """Generates a plain text version of the fine-grained report suitable for PDF <pre> tags."""
    report_lines = []
    now = datetime.datetime.now()
    nl = "\n"
    separator_char = "="
    separator_width = 70 # Adjust width as desired
    sub_separator_char = "-"
    sub_separator_width = 60

    # --- Helper to center text within separators ---
    def create_title_header(title_text, char, width):
        line = char * width
        padding = (width - len(title_text) - 2) // 2
        title_line = f"{char}{' ' * padding}{title_text.upper()}{' ' * (width - len(title_text) - 2 - padding)}{char}"
        return [line, title_line, line]

    # --- Report Header ---
    report_lines.append("--- Fine-Grained Comparison Report ---") # Keep simple header
    report_lines.append(f"Date Generated: {now:%Y-%m-%d %H:%M:%S}")
