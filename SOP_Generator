        kt_jac = results_data.get('key_term_jaccard')

        report_lines.append(f"Compared {matched_count + len(unmatched1_keys) + len(unmatched2_keys)} sections: {matched_count} matched, {len(unmatched1_keys)} unique to '{m1_name}', {len(unmatched2_keys)} unique to '{m2_name}'.")

        sim_line = "Avg Semantic Sim (Matched): "
        sim_text = "N/A"
