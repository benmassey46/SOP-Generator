    update_generation_controls_state(generating=True) # Disable buttons etc.
    if status_var:
        try: status_var.set(f"Status: Preparing generation for {len(available_models_to_run)} model(s)...")
        except tk.TclError: pass

    # --- Clear Previous Output Tabs ---
    if output_notebook and output_notebook.winfo_exists():
        try:
            # Remove placeholder first if it exists (more robust check)
            tab_ids = list(output_notebook.tabs()) # Get static list of IDs
            placeholder_index_to_remove = -1
            for i, tab_id in enumerate(tab_ids):
                 try:
                      if output_notebook.tab(tab_id, "text") == "Outputs":
                           placeholder_index_to_remove = i
                           break
                 except tk.TclError: continue # Skip if tab vanished

            if placeholder_index_to_remove != -1:
                # Verify index is still valid before removing
                current_tabs_after_loop = output_notebook.tabs()
                if placeholder_index_to_remove < len(current_tabs_after_loop):
                     output_notebook.forget(placeholder_index_to_remove)
                else:
                     print("Warning: Placeholder index became invalid during tab clearing.")

            # Clear remaining generated output tabs safely
            current_tabs = list(output_notebook.tabs()) # Get fresh list
            for tab_id in current_tabs:
                 try: output_notebook.forget(tab_id)
                 except tk.TclError: pass # Ignore if already gone

        except tk.TclError as e:
            print(f"Error clearing output tabs: {e}")

    # --- Clear Previous Structure Tabs ---
    struct_nb = globals().get('structure_notebook')
    if struct_nb and struct_nb.winfo_exists():
        try:
            tab_ids = list(struct_nb.tabs())
            tabs_to_remove = []
            for i, tab_id in enumerate(tab_ids):
                 # Keep the placeholder, remove others
                 if struct_nb.tab(tab_id, "text") != "Structure":
                      tabs_to_remove.append(tab_id)

            for tab_id in reversed(tabs_to_remove): # Remove in reverse to avoid index issues
                 struct_nb.forget(tab_id)

        except tk.TclError as e:
            print(f"Error clearing structure tabs: {e}")


    # Reset tracking variables for the new generation run
    output_widgets.clear()
    structure_widgets.clear() # Clear structure widget cache
    last_generated_models = []

    # --- Get Inputs (Context and System Message) ---
    additional_context = ""
    # Use globals().get for safer access
    ctx_entry = globals().get('context_entry')
    if ctx_entry and ctx_entry.winfo_exists():
        try: additional_context = ctx_entry.get("1.0", tk.END).strip()
        except tk.TclError: pass

    # Get the final, formatted system message
    final_system_message = get_system_message()
    # print("--- Using Final System Message ---") # Optional Debug
    # print(final_system_message)                # Optional Debug
    # print("-" * 30)                            # Optional Debug

    # --- Start Generation Threads ---
    with generation_thread_lock:
        active_generation_thread_count = len(available_models_to_run)

    if status_var:
        try: status_var.set(f"Status: Generating SOP for '{sop_topic}' using {active_generation_thread_count} model(s)...")
        except tk.TclError: pass

    if output_notebook and output_notebook.winfo_exists() and struct_nb and struct_nb.winfo_exists():
        for model_name in available_models_to_run:
            try:
                # --- Create TEXT output tab structure ---
                tab_frame = ttk.Frame(output_notebook, padding=5)
                tab_frame.rowconfigure(0, weight=1)
                tab_frame.columnconfigure(0, weight=1)
                output_text_widget = scrolledtext.ScrolledText(
                    tab_frame, width=100, height=25, wrap=tk.WORD, relief=tk.SOLID,
                    borderwidth=1, font=("Courier New", 10), state=tk.DISABLED
                )
                output_text_widget.grid(row=0, column=0, sticky="nsew", padx=1, pady=1)
                output_notebook.add(tab_frame, text=model_name)
                output_widgets[model_name] = output_text_widget

                # --- Create STRUCTURE tab structure ---
                struct_tab_frame = ttk.Frame(struct_nb, padding=5) # Add to structure_notebook
                struct_tab_frame.rowconfigure(0, weight=1)
                struct_tab_frame.columnconfigure(0, weight=1)
                # Create Treeview with scrollbars
                tree_scroll_y = ttk.Scrollbar(struct_tab_frame, orient="vertical")
                tree_scroll_x = ttk.Scrollbar(struct_tab_frame, orient="horizontal")
                structure_tree = ttk.Treeview(
                    struct_tab_frame,
                    columns=("details",), # Optional second column
                    yscrollcommand=tree_scroll_y.set,
                    xscrollcommand=tree_scroll_x.set,
                    selectmode="browse" # Allow selecting one item
                )
                tree_scroll_y.config(command=structure_tree.yview)
                tree_scroll_x.config(command=structure_tree.xview)

                structure_tree.heading("#0", text="SOP Structure", anchor='w')
                structure_tree.heading("details", text="Info", anchor='w')
                structure_tree.column("#0", stretch=tk.YES, minwidth=200, width=300)
                structure_tree.column("details", stretch=tk.NO, minwidth=100, width=150, anchor='w')

                # Grid layout for Treeview and scrollbars
                structure_tree.grid(row=0, column=0, sticky='nsew')
                tree_scroll_y.grid(row=0, column=1, sticky='ns')
                tree_scroll_x.grid(row=1, column=0, columnspan=2, sticky='ew') # Span across

                # Add structure frame to notebook, store tree widget
                struct_nb.add(struct_tab_frame, text=model_name, state='hidden') # Start hidden
                structure_widgets[model_name] = structure_tree


                # --- Start Generation Thread ---
                # Pass the final_system_message
                thread = threading.Thread(
                    target=stream_sop_thread,
                    args=(model_name, sop_topic, additional_context, final_system_message, output_text_widget),
                    daemon=True # Allows app to exit even if threads are hanging
                )
                thread.start()
            except tk.TclError as e:
                 print(f"Error creating tab/widget for model {model_name}: {e}")
                 # If tab creation failed, decrement the counter
                 with generation_thread_lock:
                     active_generation_thread_count -= 1
            except Exception as e_thread:
                print(f"Error starting thread for model {model_name}: {e_thread}")
                with generation_thread_lock:
                    active_generation_thread_count -= 1

        # Select the first tab if any were successfully added
        if output_notebook.tabs() and len(output_notebook.tabs()) > (1 if output_notebook.tab(0, "text") == "Outputs" else 0) : # Check if more than just placeholder
            try:
                first_real_tab_index = 0
                if output_notebook.tab(0, "text") == "Outputs":
                    first_real_tab_index = 1
                output_notebook.select(first_real_tab_index)
                 # Also select corresponding structure tab if available
                if struct_nb and len(struct_nb.tabs()) > 1: # Check if struct tabs were added
                     struct_nb.select(1) # Select the first *real* structure tab
            except tk.TclError: pass

        # Check if all threads failed to start
        if active_generation_thread_count == 0 and available_models_to_run:
             messagebox.showerror("Generation Error", "Failed to start generation threads for all selected models.", parent=parent_window)
             update_ui_after_all_generations_done() # Update UI to reflect failure

    else:
         # Handle critical UI error if notebook doesn't exist
         messagebox.showerror("UI Error", "Output display area (Notebook) not found. Cannot show results.", parent=parent_window)
         if status_var:
            try: status_var.set("Status: Error - Output area missing.")
            except tk.TclError: pass
         update_generation_controls_state(generating=False) # Re-enable controls


def stream_sop_thread(ai_model, sop_topic, additional_context, final_system_message, target_widget): # Renamed system_message arg
    """Streams SOP generation from an AI model to a target ScrolledText widget."""
    global active_generation_thread_count, last_generated_models
    generation_successful = False
    start_time = time.time()
    error_message_to_show = None

    # --- Prepare Widget ---
    def setup_widget():
        if target_widget and target_widget.winfo_exists():
            try:
                target_widget.config(state=tk.NORMAL)
                target_widget.delete("1.0", tk.END)
            except tk.TclError: pass
    if root and root.winfo_exists():
        root.after(0, setup_widget)
    else:
        print(f"Error [{ai_model}]: Root window invalid at thread start. Aborting.")
        with generation_thread_lock:
            active_generation_thread_count -= 1
            if active_generation_thread_count == 0 and root and root.winfo_exists():
                root.after(0, update_ui_after_all_generations_done)
        return

    # --- Generation Logic ---
    try:
        user_message = engineer_user_prompt(sop_topic, additional_context)
        text_buffer = ""
        buffer_update_threshold = 50

        # --- API Call Logic ---
        if ai_model.startswith("gemini-"):
            # --- Google Gemini ---
            if not google_api_configured: raise ValueError("Google Gemini API not configured (or config test failed).")
            model = genai.GenerativeModel(ai_model, system_instruction=final_system_message)
            safety_settings = {
                 genai.types.HarmCategory.HARM_CATEGORY_HATE_SPEECH: genai.types.HarmBlockThreshold.BLOCK_ONLY_HIGH,
                 genai.types.HarmCategory.HARM_CATEGORY_DANGEROUS_CONTENT: genai.types.HarmBlockThreshold.BLOCK_ONLY_HIGH,
                 genai.types.HarmCategory.HARM_CATEGORY_HARASSMENT: genai.types.HarmBlockThreshold.BLOCK_ONLY_HIGH,
                 genai.types.HarmCategory.HARM_CATEGORY_SEXUALLY_EXPLICIT: genai.types.HarmBlockThreshold.BLOCK_ONLY_HIGH,
            }
            prompt_content = [user_message]
            response_stream = model.generate_content(
                prompt_content, stream=True,
                generation_config=genai.types.GenerationConfig(temperature=0.6),
                safety_settings=safety_settings
            )
            stop_reason_suffix = ""
            processed_text = ""
            final_finish_reason = None
            for chunk in response_stream:
                chunk_text, current_chunk_finish_reason, block_reason, safety_ratings = "", None, None, None
                try: # Extract text
                    if hasattr(chunk, 'parts') and chunk.parts:
                        for part in chunk.parts:
                            if hasattr(part, 'text'): chunk_text += part.text
                    elif hasattr(chunk, 'text'): chunk_text += chunk.text
                except Exception as e_text: print(f"[{ai_model}] Error extracting text from chunk: {e_text}")
                try: # Extract reasons/safety
                    if hasattr(chunk, 'candidates') and chunk.candidates:
                        candidate = chunk.candidates[0]
                        if hasattr(candidate, 'finish_reason'):
                            current_chunk_finish_reason = candidate.finish_reason
                            final_finish_reason = current_chunk_finish_reason
                        if hasattr(candidate, 'safety_ratings'): safety_ratings = candidate.safety_ratings
                except Exception as e_cand: print(f"[{ai_model}] Error accessing candidate info: {e_cand}")
                try: # Extract block reason
                    if hasattr(chunk, 'prompt_feedback') and hasattr(chunk.prompt_feedback, 'block_reason'):
                        block_reason = chunk.prompt_feedback.block_reason
                except Exception as e_prompt: print(f"[{ai_model}] Error accessing prompt feedback: {e_prompt}")

                if chunk_text: # Update buffer/GUI
                    processed_text += chunk_text
                    text_buffer += chunk_text
                    if len(text_buffer) >= buffer_update_threshold:
                        if root and root.winfo_exists():
                            root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
                        text_buffer = ""
                if block_reason: # Check Block Reason
                    stop_reason_suffix = f"\n\n--- BLOCKED (Reason: {block_reason}) ---"
                    if safety_ratings: stop_reason_suffix += f"\nSafety Ratings: {safety_ratings}"
                    break
                is_problematic_finish = False # Check Current Chunk Finish Reason
                if current_chunk_finish_reason is not None:
                    reason_str = str(current_chunk_finish_reason).upper()
                    problem_reasons = {"SAFETY", "RECITATION", "OTHER"}
                    if reason_str in problem_reasons: is_problematic_finish = True
                if is_problematic_finish:
                    stop_reason_suffix = f"\n\n--- GENERATION ENDED ABNORMALLY ({current_chunk_finish_reason}) ---"
                    if safety_ratings: stop_reason_suffix += f"\nSafety Ratings: {safety_ratings}"
                    break
            # After Loop
            if text_buffer:
                if root and root.winfo_exists(): root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
            if stop_reason_suffix:
                 if root and root.winfo_exists(): root.after(0, lambda msg=stop_reason_suffix, widget=target_widget: insert_text_safely(widget, msg))
            # Determine Success
            if not block_reason:
                final_reason_str = str(final_finish_reason).upper() if final_finish_reason is not None else ""
                successful_reasons = {"STOP", "MAX_TOKENS"}
                if processed_text or (final_reason_str in successful_reasons): generation_successful = True
                else:
                     generation_successful = False
                     if not stop_reason_suffix: error_message_to_show = f"--- Ended ({final_finish_reason}) with no text output ---"
                     else: error_message_to_show = stop_reason_suffix.strip()
            else:
                generation_successful = False
                error_message_to_show = stop_reason_suffix.strip()


        elif ai_model.startswith("claude-"):
            # --- Anthropic Claude ---
            if not anthropic_client: raise ValueError("Anthropic client not initialized.")
            stop_reason_suffix = ""
            with anthropic_client.messages.stream(
                model=ai_model, max_tokens=4096, system=final_system_message,
                messages=[{"role": "user", "content": user_message}],
                temperature=0.6
            ) as stream:
                for text_chunk in stream.text_stream: # <<< This line caused the error in the user's traceback
                    text_buffer += text_chunk
                    if len(text_buffer) >= buffer_update_threshold:
                        root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
                        text_buffer = ""
                if text_buffer: root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
                final_message = stream.get_final_message()
                if final_message.stop_reason not in ['end_turn', 'stop_sequence']:
                    stop_reason_suffix = f"\n\n--- GENERATION ENDED ({final_message.stop_reason}) ---"
                    if stop_reason_suffix: root.after(0, lambda msg=stop_reason_suffix, widget=target_widget: insert_text_safely(widget, msg))
                    generation_successful = False
                    error_message_to_show = stop_reason_suffix.strip()
                else:
                    generation_successful = True


        elif ai_model.startswith("gpt-"):
            # --- OpenAI GPT ---
            if not openai_client: raise ValueError("OpenAI client not initialized.")
            stream_response = openai_client.chat.completions.create(
                model=ai_model,
                messages=[{"role": "system", "content": final_system_message}, {"role": "user", "content": user_message}],
                stream=True, max_tokens=4096, temperature=0.6, n=1
            )
            stop_reason_suffix = ""
            finish_reason = None
            for chunk in stream_response:
                content = chunk.choices[0].delta.content
                if chunk.choices[0].finish_reason: finish_reason = chunk.choices[0].finish_reason
                if content:
                    text_buffer += content
                    if len(text_buffer) >= buffer_update_threshold:
                        root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
                        text_buffer = ""
                if finish_reason: break
            if text_buffer: root.after(0, lambda txt=text_buffer, widget=target_widget: insert_text_safely(widget, txt, replace=False))
            if finish_reason and finish_reason != 'stop':
                stop_reason_suffix = f"\n\n--- GENERATION STOPPED ({finish_reason}) ---"
                root.after(0, lambda msg=stop_reason_suffix, widget=target_widget: insert_text_safely(widget, msg))
                generation_successful = False
                error_message_to_show = stop_reason_suffix.strip()
            elif finish_reason == 'stop':
                 generation_successful = True

        else:
             unknown_msg = f"\n--- ERROR: Unknown or unsupported model type '{ai_model}' ---"
             root.after(0, lambda msg=unknown_msg, widget=target_widget: insert_text_safely(widget, msg))
             generation_successful = False
             error_message_to_show = f"Unknown model type '{ai_model}'"

        # Add completion marker if successful
        if generation_successful:
             end_time = time.time()
             duration = end_time - start_time
             completion_msg = f"\n\n[End Generation - {ai_model} ({duration:.2f}s)]"
             root.after(0, lambda msg=completion_msg, widget=target_widget: insert_text_safely(widget, msg))

    except anthropic.APIStatusError as e: # Catch specific Anthropic API status errors
        print(f"--- Anthropic API Status Error ({ai_model}) ---")
        traceback.print_exc()
        # Check if it's an overload error or other specific type
        error_type = "Unknown"
        error_msg = str(e)
        status_code = getattr(e, 'status_code', 'N/A')
        try:
            if hasattr(e, 'body') and e.body and isinstance(e.body, dict):
                error_info = e.body.get('error', {})
                error_type = error_info.get('type', error_type)
                error_msg = error_info.get('message', error_msg)
        except Exception as parse_err:
            print(f"Could not parse Anthropic error body: {parse_err}")
        if error_type == 'overloaded_error' or status_code == 529:
             error_message_to_show = f"--- ERROR ({ai_model}) ---\nAnthropic API Overloaded (Status {status_code}).\nPlease try again later.\nDetails: {error_msg}"
        else:
             error_message_to_show = f"--- ERROR ({ai_model}) ---\nAnthropic API Error (Type: {error_type}, Status: {status_code}): {error_msg}\n(Check console for details)"
        generation_successful = False
    except openai.APIStatusError as e: # Catch OpenAI specific status errors
        print(f"--- OpenAI API Status Error ({ai_model}) ---")
        traceback.print_exc()
        error_message_to_show = f"--- ERROR ({ai_model}) ---\nOpenAI API Error (Status: {e.status_code}): {e.message}\n(Check console for details)"
        generation_successful = False
    except openai.APIError as e: # Catch other OpenAI API errors
        print(f"--- OpenAI API Error ({ai_model}) ---")
        traceback.print_exc()
        error_message_to_show = f"--- ERROR ({ai_model}) ---\nOpenAI API Error: {e}\n(Check console for details)"
        generation_successful = False
    # Example for Google Gemini (needs specific exception type from google.generativeai if available)
    # except genai.APIError as e: # Replace with actual exception if it exists
    #     print(f"--- Google Gemini API Error ({ai_model}) ---")
    #     traceback.print_exc()
    #     error_message_to_show = f"--- ERROR ({ai_model}) ---\nGoogle Gemini API Error: {e}\n(Check console for details)"
    #     generation_successful = False
    except Exception as e: # General fallback
        print(f"--- Error generating SOP for {ai_model} ---")
        traceback.print_exc()
        error_message_to_show = f"--- ERROR ({ai_model}) ---\n{type(e).__name__}: {e}\n(Check console for details)"
        generation_successful = False

    finally:
        # --- Finalize Widget State ---
        if error_message_to_show:
            final_error_display = f"\n\n{error_message_to_show}\n--------------------\n"
            root.after(0, lambda em=final_error_display, widget=target_widget: insert_text_safely(widget, em, replace=False))
        def finalize_widget_state():
            if target_widget and target_widget.winfo_exists():
                try: target_widget.config(state=tk.DISABLED)
                except tk.TclError: pass
        if root and root.winfo_exists():
            root.after(0, finalize_widget_state)

        # --- Update Global State ---
        with generation_thread_lock:
            active_generation_thread_count -= 1
            if generation_successful:
                 if isinstance(last_generated_models, list):
                     last_generated_models.append(ai_model)
            if active_generation_thread_count == 0:
                 if root and root.winfo_exists():
                     root.after(100, update_ui_after_all_generations_done)

